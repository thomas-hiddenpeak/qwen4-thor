#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> kernels[4]{};
int stage = 0, norm_count = 0;
const uint16_t* norm_out[3]{};
const uint16_t *gate_out = nullptr, *gated_out = nullptr;
constexpr size_t full = 4096 * 10240 * 2;
template <class T>
T Resolve(const char* n) {
  auto p = reinterpret_cast<T>(dlsym(RTLD_NEXT, n));
  if (!p) std::_Exit(127);
  return p;
}
template <class T>
T* Ptr(void** a, int i) {
  return *static_cast<T**>(a[i]);
}
bool Save(const std::string& p, const void* d, size_t n) {
  FILE* f = std::fopen(p.c_str(), "wb");
  if (!f) return false;
  bool ok = std::fwrite(d, 1, n, f) == n;
  return std::fclose(f) == 0 && ok;
}
bool Read(void* h, const void* d, size_t n, cudaStream_t s) {
  static auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static auto sync =
      Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");
  return copy(h, d, n, cudaMemcpyDeviceToHost, s) == cudaSuccess &&
         sync(s) == cudaSuccess;
}
bool Capture(const std::string& p, const void* d, size_t n, cudaStream_t s) {
  std::vector<unsigned char> v(n);
  return Read(v.data(), d, n, s) && Save(p, v.data(), n);
}
bool Compare(const std::string& p, const void* d, size_t n, cudaStream_t s) {
  std::vector<unsigned char> v(n), expected(n);
  FILE* f = std::fopen(p.c_str(), "rb");
  if (!f) return false;
  bool ok = std::fread(expected.data(), 1, n, f) == n && std::fgetc(f) == EOF;
  std::fclose(f);
  return ok && Read(v.data(), d, n, s) && v == expected;
}
}  // namespace
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* k, const void* fn) {
  static auto real =
      Resolve<cudaError_t (*)(cudaKernel_t*, const void*)>("__cudaGetKernel");
  auto status = real(k, fn);
  if (status == cudaSuccess) {
    const char* n = nullptr;
    static auto name = Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");
    if (name(&n, fn) == cudaSuccess && n && std::strstr(n, "ple_layer_cu")) {
      const char* names[] = {"GroupedRmsNormKernel", "PleGateKernel",
                             "GatedValueKernel", "DepthwiseConvAddKernel"};
      for (int i = 0; i < 4; ++i)
        if (std::strstr(n, names[i])) kernels[i] = *k;
    }
  }
  return status;
}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t k, dim3 grid, dim3 block,
                                          void** a, size_t smem,
                                          cudaStream_t stream) {
  static auto real =
      Resolve<cudaError_t (*)(cudaKernel_t, dim3, dim3, void**, size_t,
                              cudaStream_t)>("__cudaLaunchKernel");
  int kind = -1;
  for (int i = 0; i < 4; ++i)
    if (k == kernels[i]) kind = i;
  const char *dir = std::getenv("Q4T_PLE_CAPTURE_DIR"),
             *prior = std::getenv("Q4T_PLE_PRIOR");
  bool take = dir && prior && kind >= 0 &&
              *static_cast<int*>(a[kind == 3 ? 6 : 3]) == 4096;
  bool ok = true;
  std::string base, prev;
  int index = -1;
  if (take) {
    base = std::string(dir) + "/prefill";
    prev = std::string(prior) + "/prefill";
    ok =
        grid.y == 1 && grid.z == 1 && block.y == 1 && block.z == 1 && smem == 0;
    if (kind < 3)
      ok = ok && *static_cast<int*>(a[4]) == 4 &&
           *static_cast<int*>(a[5]) == 2560;
    if (kind == 0) {
      index = norm_count++;
      ok = ok && index < 3 && stage == (index < 2 ? index : 4) &&
           grid.x == 4096 && block.x == 128;
      if (index < 3) {
        base += ".norm-" + std::to_string(index);
        norm_out[index] = Ptr<uint16_t>(a, 2);
        float eps = *static_cast<float*>(a[6]);
        ok = ok &&
             Capture(base + ".weights.bf16", Ptr<uint16_t>(a, 1), 20480,
                     stream) &&
             Save(base + ".eps.f32", &eps, 4);
        if (index == 0)
          ok = ok &&
               Capture(base + ".input.bf16", Ptr<uint16_t>(a, 0), full, stream);
        else if (index == 1)
          ok = ok &&
               Compare(prev + ".trunk.bf16", Ptr<uint16_t>(a, 0), full, stream);
        else
          ok = ok && Ptr<uint16_t>(a, 0) == gated_out &&
               Compare(prev + ".gated.bf16", Ptr<uint16_t>(a, 0), full, stream);
      }
    } else if (kind == 1) {
      base += ".gate";
      ok = ok && stage == 2 && block.x == 256 && grid.x == 64 &&
           Ptr<uint16_t>(a, 0) == norm_out[0] &&
           Ptr<uint16_t>(a, 1) == norm_out[1] &&
           Compare(std::string(dir) + "/prefill.norm-0.output.bf16",
                   Ptr<uint16_t>(a, 0), full, stream) &&
           Compare(std::string(dir) + "/prefill.norm-1.output.bf16",
                   Ptr<uint16_t>(a, 1), full, stream);
      gate_out = Ptr<uint16_t>(a, 2);
      float scale = *static_cast<float*>(a[6]);
      ok = ok && Save(base + ".scale.f32", &scale, 4);
    } else if (kind == 2) {
      base += ".gated";
      ok = ok && stage == 3 && block.x == 256 && grid.x == 163840 &&
           Ptr<uint16_t>(a, 0) == gate_out &&
           Compare(std::string(dir) + "/prefill.gate.output.bf16",
                   Ptr<uint16_t>(a, 0), 4096 * 4 * 2, stream) &&
           Capture(base + ".value.bf16", Ptr<uint16_t>(a, 1), 4096 * 2560 * 2,
                   stream);
      gated_out = Ptr<uint16_t>(a, 2);
    } else {
      base += ".conv";
      ok = ok && stage == 5 && block.x == 256 && grid.x == 163840 &&
           *static_cast<int*>(a[7]) == 10240 && *static_cast<int*>(a[8]) == 4 &&
           *static_cast<int*>(a[9]) == 3 && *static_cast<int*>(a[10]) == 9 &&
           Ptr<uint16_t>(a, 0) == norm_out[2] &&
           Ptr<uint16_t>(a, 3) == gated_out &&
           Compare(prev + ".x.bf16", Ptr<uint16_t>(a, 0), full, stream) &&
           Compare(prev + ".gated.bf16", Ptr<uint16_t>(a, 3), full, stream) &&
           Compare(prev + ".trunk.bf16", Ptr<uint16_t>(a, 4), full, stream);
    }
  }
  auto status = real(k, grid, block, a, smem, stream);
  if (take && status == cudaSuccess) {
    if (kind == 0) {
      if (index < 2)
        ok = ok &&
             Capture(base + ".output.bf16", Ptr<uint16_t>(a, 2), full, stream);
      else
        ok = ok && Compare(prev + ".x.bf16", Ptr<uint16_t>(a, 2), full, stream);
      stage = index < 2 ? index + 1 : 5;
    } else if (kind == 1) {
      ok = ok && Capture(base + ".output.bf16", Ptr<uint16_t>(a, 2),
                         4096 * 4 * 2, stream);
      stage = 3;
    } else if (kind == 2) {
      ok = ok &&
           Compare(prev + ".gated.bf16", Ptr<uint16_t>(a, 2), full, stream);
      stage = 4;
    } else {
      ok = ok &&
           Compare(prev + ".output.bf16", Ptr<uint16_t>(a, 5), full, stream);
      stage = 6;
    }
    char meta[200];
    int n = std::snprintf(meta, sizeof(meta),
                          "{\"kind\":%d,\"norm_index\":%d,\"tokens\":4096,"
                          "\"block\":%u,\"grid\":%u,\"ok\":%s}\n",
                          kind, index, block.x, grid.x, ok ? "true" : "false");
    if (n > 0 && size_t(n) < sizeof(meta)) Save(base + ".json", meta, n);
    std::fprintf(stderr, "[ple-full-gate-norm] stage=%d ok=%d\n", stage, ok);
  }
  return status;
}
