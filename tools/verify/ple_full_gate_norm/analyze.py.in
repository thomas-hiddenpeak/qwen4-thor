from pathlib import Path
import hashlib,json,struct,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/ple-full-gate-norm-20260924';c=o/'observed-captures';prior=root/'.q4t-work/e2e/ple-full-conv-20260924';pc=prior/'observed-captures';old=root/'.q4t-work/e2e/ple-gate-norm-20260923';model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream')
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
def bf(f,n):
 a=np.fromfile(f,dtype='<u2');assert len(a)==n;assert np.isfinite((a.astype('<u4')<<16).view('<f4')).all();return a
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'];assert sha(root/'build/q4t')==json.loads((o/'plan.json').read_text())['binary_sha256']
binding=json.loads((o/'prior-binding.json').read_text());assert sha(prior/'artifact-binding.json')==binding['manifest_sha256']
for r in binding['records']:assert sha(prior/r['file'])==r['sha256']
metas=[json.loads(f.read_text()) for f in c.glob('*.json')];assert len(metas)==6 and all(m['ok'] for m in metas)
index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];weights=[];oldbinding=[];om=json.loads((old/'artifact-binding.json').read_text())
for i,kind in enumerate(['key','query','conv']):
 key=f'model.language_model.layers.1.ple.norm_{kind}.weight';f=model/index[key]
 with f.open('rb') as stream:
  size=struct.unpack('<Q',stream.read(8))[0];info=json.loads(stream.read(size))[key];assert info['dtype']=='BF16' and int(np.prod(info['shape']))==10240;a,b=info['data_offsets'];offset=8+size+a;stream.seek(offset);raw=stream.read(b-a)
 assert len(raw)==20480 and raw==(c/f'prefill.norm-{i}.weights.bf16').read_bytes();st=f.stat();weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(raw),'shape':info['shape'],'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns})
 eps=np.fromfile(c/f'prefill.norm-{i}.eps.f32',dtype='<f4');assert len(eps)==1 and eps[0]==np.float32(1e-6)
for f in c.iterdir():
 if f.suffix not in ['.bf16','.f32']:continue
 prev=old/'observed-captures'/f.name;rel=str(prev.relative_to(old));assert sha(prev)==om[rel];raw=f.read_bytes();tail=prev.read_bytes();assert raw[-len(tail):]==tail;oldbinding.append({'file':rel,'sha256':om[rel],'relation':'full small tensor or full10 tail'})
for name in ['prefill.norm-0.input.bf16','prefill.norm-0.output.bf16','prefill.norm-1.output.bf16']:bf(c/name,4096*10240)
scale=np.fromfile(c/'prefill.gate.scale.f32',dtype='<f4');assert len(scale)==1 and scale[0]==np.float32(1)/np.sqrt(np.float32(2560))
gate=bf(c/'prefill.gate.output.bf16',4096*4);value=bf(c/'prefill.gated.value.bf16',4096*2560);actual=bf(pc/'prefill.gated.bf16',4096*10240)
# CPU FP32 products, then independent round-to-nearest-even BF16.
g=(gate.astype('<u4')<<16).view('<f4').reshape(4096,4,1);v=(value.astype('<u4')<<16).view('<f4').reshape(4096,1,2560);product=np.multiply(g,v,dtype=np.float32);assert np.isfinite(product).all();bits=product.view('<u4');ref=((bits+0x7fff+((bits>>16)&1))>>16).astype('<u2').reshape(-1)
assert shutil.disk_usage(o).free>20*1024**3+100000000
f=o/'gated-reference.bf16';ref.tofile(f);idx=np.flatnonzero(ref!=actual).astype('<i4');delta=o/'gated-reference.delta.npz';np.savez_compressed(delta,indices=idx,values=ref[idx]);z=np.load(delta);rebuilt=actual.copy();rebuilt[z['indices']]=z['values'];assert np.array_equal(rebuilt,ref);h=sha(f);assert hashlib.sha256(rebuilt.tobytes()).hexdigest()==h;f.unlink()
save('broadcast-reference.json',{'elements':len(ref),'mismatches':len(idx),'actual_base':str((pc/'prefill.gated.bf16').relative_to(root)),'actual_sha256':sha(pc/'prefill.gated.bf16'),'reference_sha256':h,'delta_sha256':sha(delta),'complete_reference_reconstructed':True,'uses_actual_gate_and_value':True})
save('checkpoint-binding.json',weights);save('old-binding.json',{'manifest_sha256':sha(old/'artifact-binding.json'),'records':oldbinding})
summary={'tokens':4096,'norm_output_elements':4096*10240*3,'gate_elements':4096*4,'broadcast_elements':len(ref),'broadcast_mismatches':len(idx),'checkpoint_tensors':3,'checkpoint_bytes':sum(w['bytes'] for w in weights),'old_files_equal':len(oldbinding),'full_conv_consumers_equal':True,'norm_arithmetic_verified':False,'gate_arithmetic_verified':False,'runtime_changed':False,'whole_model_correctness_proven':False,'free_after':shutil.disk_usage(o).free};save('summary.json',summary);shutil.copy2(p/'analyze.py',o/'analyze.py');save('artifact-binding.json',{str(f.relative_to(o)):sha(f) for f in sorted(o.rglob('*')) if f.is_file() and f.name!='artifact-binding.json'});print(summary,flush=True)
