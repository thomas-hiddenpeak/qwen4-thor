from pathlib import Path
import json,hashlib,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/moe-full-gather-20260924';c=o/'observed-captures'
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
assert sha(root/'build/q4t')=='2392f6b1fb33f28744d0e63812e47be98b4c6f224e22f087bd627d050f8bbe9e'
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'];report=json.loads((o/'mapping-reference.json').read_text());assert report['complete'] and len(report['records'])==48
for name,prefix in [('prior-binding.json','hc-full-boundaries-20260923'),('router-prior-binding.json','moe-full-router-20260924')]:
 prior=root/'.q4t-work/e2e'/prefix;b=json.loads((o/name).read_text());assert sha(prior/'artifact-binding.json')==b['manifest_sha256']
 for x in b['records']:assert sha(prior/x['file'])==x['sha256']
scales=json.loads((o/'checkpoint-binding.json').read_text());assert len(scales)==49152
for x in scales:
 f=Path(x['file']);s=f.stat();assert s.st_size==x['size'] and s.st_mtime_ns==x['mtime_ns']
 with f.open('rb') as stream:stream.seek(x['offset']);data=stream.read(x['bytes']);assert len(data)==4 and hashlib.sha256(data).hexdigest()==x['sha256']
for r in report['records']:
 l=r['layer'];base=f'layer-{l}';counts=np.fromfile(c/(base+'.counts.i32'),dtype='<i4');active=np.flatnonzero(counts);metas=list(c.glob(base+'.expert-*.gather.json'));assert len(metas)==len(active)==r['active_experts'];assert counts.sum()==r['rows']==40960 and int(counts.max())==r['max_expert_rows']
 for suffix in ['lists-source.json','mapping.json','consumer.json']:assert json.loads((c/(base+'.'+suffix)).read_text())['ok']
 for e in active:
  stem=base+f'.expert-{e}';m=json.loads((c/(stem+'.gather.json')).read_text());me=int(counts[e]);assert m['ok'] and m['expert']==e and m['rows']==me
  assert (c/(stem+'.packed.bin')).stat().st_size==me*1280 and (c/(stem+'.sf-logical.bin')).stat().st_size==me*160 and (c/(stem+'.sf-physical.bin')).stat().st_size==((me+127)//128)*40*512
summary=json.loads((o/'summary.json').read_text());assert summary['flat_assignments']==1966080 and summary['sf_layout_elements']==314572800 and summary['fp4_payload_elements_captured']==5033164800;assert not summary['quantization_arithmetic_verified']
for f in p.iterdir():
 if f.is_file():shutil.copy2(f,o/f.name)
save('artifact-binding.json',{str(f.relative_to(o)):sha(f) for f in sorted(o.rglob('*')) if f.is_file() and f.name!='artifact-binding.json'});print(summary,flush=True)
