"""Carry four own GDN Y/Z branches through NormGate and output projection."""
from pathlib import Path
import hashlib,json,subprocess,shutil,os
import numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];e=root/'.q4t-work/e2e';o=e/p.name
s=e/'linear-full-output-v2-20260923';u=e/'moe-scale-linear-input-l1-20260924';v=e/'moe-scale-gdn-l1-20260924'
branches=['baseline','input_fixed','inter_fixed','both_fixed']
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as z:
  for b in iter(lambda:z.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(n,x):(o/n).write_text(json.dumps(x,indent=2)+'\n')
def decode(f):return (np.fromfile(f,dtype='<u2').astype('<u4')<<16).view('<f4')
def rounded(x):
 b=x.view('<u4');return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype('<u2')
assert not any((o/'reference').iterdir());assert (p/'build.log').stat().st_size==0
assert sha(root/'build/q4t')=='2392f6b1fb33f28744d0e63812e47be98b4c6f224e22f087bd627d050f8bbe9e'
budget=4000000000;reserve=20*1024**3;assert shutil.disk_usage(o).free>reserve+budget
man={x.name:json.loads((x/'artifact-binding.json').read_text()) for x in [s,u,v]};bindings=[]
def bind(x,n):
 f=x/n;h=sha(f);assert h==man[x.name][n],f;bindings.append({'file':str(f.relative_to(root)),'sha256':h});return f
assert json.loads(bind(s,'exit.json').read_text())['observer_preserved_tested_output']
for x in [u,v]:assert json.loads(bind(x,'reference.json').read_text())['complete']
names=['norm.input.bf16','norm.z.bf16','norm.weights.bf16','norm.output.bf16','norm.norm.json','out.input.bf16','out.output.bf16','out.weights.bf16','out.algo.bin','out.out.json','out.consumer.bf16']
actual={n:bind(s,'observed-captures/layer-1.prefill.'+n) for n in names}
assert np.float32(json.loads(actual['norm.norm.json'].read_text())['eps'])==np.float32(1e-6)
assert sha(actual['norm.output.bf16'])==sha(actual['out.input.bf16'])
assert sha(actual['out.output.bf16'])==sha(actual['out.consumer.bf16'])
weights=[w for w in json.loads(bind(s,'checkpoint-binding.json').read_text()) if '.layers.1.' in w['tensor']];assert len(weights)==2
for w in weights:
 f=Path(w['path']);st=f.stat();assert st.st_size==w['size'] and st.st_mtime_ns==w['mtime_ns']
 with f.open('rb') as z:z.seek(w['offset']);assert hashlib.sha256(z.read(w['bytes'])).hexdigest()==w['sha256']
 tag='norm' if w['tensor'].endswith('.norm.weight') else 'out';assert sha(actual[tag+'.weights.bf16'])==w['sha256']
paths={}
for b in branches:
 paths[b]={'norm.input.bf16':bind(v,'reference/'+b+'/layer-1.v1.y.bf16'),'norm.z.bf16':bind(u,'reference/'+b+'/layer-1.prefill.z.replay.bf16')}
for n,f in paths['baseline'].items():assert sha(f)==sha(actual[n])
save('input-binding.json',bindings);save('checkpoint-binding.json',weights);save('source-manifests.json',{x.name:sha(x/'artifact-binding.json') for x in [s,u,v]})
save('plan.json',{'budget_bytes':budget,'reserve_bytes':reserve,'scope':'Four own Y/Z branches through NormGate (CPU tree-square reduction, device rsqrt/sigmoid, CPU sequential3 multiplications/BF16), then recorded out projection [4096,6144]x[6144,2560]. Baseline restores full NormGate/out and captured HC consumer. No HC residual yet.','retention':'Full NormGate CPU/device/FP64 variants, mean/Z/rsqrt/sigmoid/rawFP32; full output projection BF16, all difference indices and token counts. No GEMM accumulators.','dependencies':'Device elementary functions and recorded cuBLAS algorithm; no high precision composed model proof.'})
records=[]
for b in branches:
 c=o/'inputs'/b;c.mkdir(parents=True);d=o/'reference'/b;d.mkdir()
 for n in names:
  if n=='out.input.bf16':continue
  os.link(paths[b].get(n,actual[n]),c/('layer-1.prefill.'+n))
 for tool,args in [('norm',[c,d,1]),('nonlinear',[d])]:
  with (o/(b+'.'+tool+'.stdout')).open('w') as out,(o/(b+'.'+tool+'.stderr')).open('w') as err:
   proc=subprocess.run([str(p/tool)]+list(map(str,args)),stdout=out,stderr=err,env={**os.environ,'OMP_NUM_THREADS':'8'})
  assert proc.returncode==0
 prefix='layer-1.prefill.norm';y=decode(paths[b]['norm.input.bf16']).reshape(-1,128);w=decode(actual['norm.weights.bf16']);inv=np.fromfile(d/(prefix+'.cuda-inv.f32'),dtype='<f4');sig=np.fromfile(d/(prefix+'.cuda-sig.f32'),dtype='<f4').reshape(-1,128)
 raw=((y*inv[:,None])*w)*sig;assert raw.dtype==np.float32 and np.isfinite(raw).all();raw.tofile(d/(prefix+'.device.f32'));value=rounded(raw).reshape(-1);value.tofile(d/(prefix+'.device.bf16'));os.link(d/(prefix+'.device.bf16'),c/'layer-1.prefill.out.input.bf16')
 normdiff={}
 expected=np.fromfile(actual['norm.output.bf16'],dtype='<u2')
 for kind in ['cpu','device','fp64']:
  val=np.fromfile(d/(prefix+'.'+kind+'.bf16'),dtype='<u2');assert len(val)==25165824
  idx=np.flatnonzero(val!=expected).astype('<i4');idx.tofile(d/(prefix+'.'+kind+'.differences.i32'));normdiff[kind]=len(idx)
 counts=np.bincount(np.flatnonzero(value!=expected)//6144,minlength=4096).astype('<i4');counts.tofile(d/'norm.token-differences.i32')
 changed=np.zeros(4096,dtype=bool)
 for n in ['norm.input.bf16','norm.z.bf16']:
  changed|=np.any(np.fromfile(paths[b][n],dtype='<u2').reshape(4096,-1)!=np.fromfile(actual[n],dtype='<u2').reshape(4096,-1),axis=1)
 assert not np.any((counts>0)&~changed)
 if b=='baseline':assert normdiff['device']==0
 with (o/(b+'.replay.stdout')).open('w') as out,(o/(b+'.replay.stderr')).open('w') as err:
  proc=subprocess.run([str(p/'replay'),str(c),str(d)],stdout=out,stderr=err)
 assert proc.returncode==0
 r=json.loads((o/(b+'.replay.stdout')).read_text())['records'][0]
 val=np.fromfile(d/'layer-1.prefill.out.replay.bf16',dtype='<u2');expected=np.fromfile(actual['out.output.bf16'],dtype='<u2');assert len(val)==10485760
 assert np.isfinite((val.astype('<u4')<<16).view('<f4')).all()
 idx=np.flatnonzero(val!=expected).astype('<i4');assert len(idx)==r['mismatches'];idx.tofile(d/'out.differences.i32');oc=np.bincount(idx//2560,minlength=4096).astype('<i4');oc.tofile(d/'out.token-differences.i32')
 assert not np.any((oc>0)&(counts==0))
 if b=='baseline':assert len(idx)==0
 r.update(branch=b,norm_differences=normdiff,norm_changed_tokens=int(np.count_nonzero(counts)),out_changed_tokens=int(np.count_nonzero(oc)))
 records.append(r);save('reference.json',{'records':records,'complete':len(records)==4});print(r,flush=True)
for n in ['norm.cpp','nonlinear.cu','replay.cpp','norm','nonlinear','replay','build.log','run.py']:shutil.copy2(p/n,o/n)
save('summary.json',{'records':records,'runtime_changed':False,'whole_model_correctness_proven':False,'task_causality_established':False,'endpoint':'Layer1 attention output, before HC residual'})
assert sum(f.stat().st_size for f in o.rglob('*') if f.is_file())<budget
