#include <cuda_runtime_api.h>
#include <cublasLt.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
template<class T>T Resolve(const char*n){auto f=reinterpret_cast<T>(dlsym(RTLD_NEXT,n));if(!f)std::_Exit(127);return f;}
template<class T>T* Ptr(void**a,int i){return *static_cast<T**>(a[i]);}
bool Save(const std::string&n,const void*p,size_t bytes){FILE*f=std::fopen(n.c_str(),"wb");if(!f)return false;bool ok=std::fwrite(p,1,bytes,f)==bytes;return std::fclose(f)==0&&ok;}
bool Read(void*p,const void*x,size_t bytes,cudaStream_t s){static auto copy=Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");static auto sync=Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");return copy(p,x,bytes,cudaMemcpyDeviceToHost,s)==cudaSuccess&&sync(s)==cudaSuccess;}
bool Capture(const std::string&n,const void*x,size_t bytes,cudaStream_t s){std::vector<unsigned char>b(bytes);return Read(b.data(),x,bytes,s)&&Save(n,b.data(),bytes);}
bool Compare(const std::string&n,const void*x,size_t bytes,cudaStream_t s){std::vector<unsigned char>b(bytes),chunk(1048576);if(!Read(b.data(),x,bytes,s))return false;FILE*f=std::fopen(n.c_str(),"rb");if(!f)return false;bool ok=true;size_t pos=0;while(pos<bytes){size_t amount=bytes-pos;if(amount>chunk.size())amount=chunk.size();if(std::fread(chunk.data(),1,amount,f)!=amount||std::memcmp(chunk.data(),b.data()+pos,amount)){ok=false;break;}pos+=amount;}ok=ok&&std::fgetc(f)==EOF;return std::fclose(f)==0&&ok;}
std::atomic<cudaKernel_t> read_kernel{},fused_kernel{},gate_kernel{};
int count=0,stage=3;std::string stem,base,source;const void *norm=nullptr,*down=nullptr,*gate=nullptr;bool context_ok=false;
void Meta(const std::string&f,bool ok,const char*extra=""){std::string s=std::string("{\"ok\":")+(ok?"true":"false")+extra+"}\n";Save(f,s.data(),s.size());}
template <typename T>
bool Layout(cublasLtMatrixLayout_t layout, cublasLtMatrixLayoutAttribute_t key,
            T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatrixLayoutGetAttribute)>(
      "cublasLtMatrixLayoutGetAttribute");
  size_t size = 0;
  return get(layout, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
template <typename T>
bool Attribute(cublasLtMatmulDesc_t desc, cublasLtMatmulDescAttributes_t key,
               T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatmulDescGetAttribute)>(
      "cublasLtMatmulDescGetAttribute");
  size_t size = 0;
  return get(desc, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
bool Shape(cublasLtMatrixLayout_t desc, uint64_t rows, uint64_t cols,
           cudaDataType_t type) {
  uint64_t r = 0, c = 0;
  int64_t ld = 0;
  cudaDataType_t t{};
  cublasLtOrder_t order{};
  return Layout(desc, CUBLASLT_MATRIX_LAYOUT_ROWS, &r) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_COLS, &c) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_LD, &ld) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_TYPE, &t) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_ORDER, &order) &&
         r == rows && c == cols && ld == static_cast<int64_t>(rows) &&
         t == type && order == CUBLASLT_ORDER_COL;
}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t*k,const void*fn){static auto real=Resolve<cudaError_t(*)(cudaKernel_t*,const void*)>("__cudaGetKernel");auto r=real(k,fn);if(r==cudaSuccess){const char*n=nullptr;static auto name=Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");if(name(&n,fn)==cudaSuccess&&n&&std::strstr(n,"hyperconnection_cu")){if(std::strstr(n,"GroupedRmsNormKernel"))read_kernel=*k;if(std::strstr(n,"CombineAndGroupedNormKernel"))fused_kernel=*k;if(std::strstr(n,"ApplyInjectGateKernel"))gate_kernel=*k;}}return r;}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t k,dim3 grid,dim3 block,void**a,size_t smem,cudaStream_t stream){static auto real=Resolve<cudaError_t(*)(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t)>("__cudaLaunchKernel");auto r=real(k,grid,block,a,smem,stream);const char*dir=std::getenv("Q4T_GDN_CAPTURE_DIR");const char*prior=std::getenv("Q4T_HC_PRIOR");if(!dir||!prior||r!=cudaSuccess)return r;
 bool rd=k==read_kernel,fu=k==fused_kernel;
 if((rd||fu)&&*static_cast<int*>(a[rd?3:6])==4096){int ix=count++;stem="hc-"+std::to_string(ix/2)+".prefill."+(ix%2?"mlp":"attn");base=std::string(dir)+"/"+stem;source=std::string(prior)+"/hc-"+std::to_string(ix/2)+".prefill.mix."+(ix%2?"mlp":"attn");norm=Ptr<uint16_t>(a,rd?2:5);context_ok=ix<96&&stage==3&&gate==nullptr&&rd==(ix%2==0)&&*static_cast<int*>(a[rd?4:7])==4&&*static_cast<int*>(a[rd?5:8])==2560&&Compare(source+".normed.bf16",norm,size_t(4096)*10240*2,stream);stage=0;Meta(base+".source.json",context_ok);}
 if(k==gate_kernel&&*static_cast<int*>(a[1])==4096*4){bool ok=context_ok&&stage==3&&Ptr<uint16_t>(a,0)==gate&&*static_cast<float*>(a[2])==0.25f;ok=ok&&Capture(base+".inject.gate.bf16",gate,4096*4*2,stream);std::string prior_gate=std::string(prior)+"/hc-"+std::to_string((count-1)/2)+".prefill."+((count-1)%2?"write":"fused")+".gate.bf16";ok=ok&&Compare(prior_gate,gate,4096*4*2,stream);Meta(base+".gate.json",ok);gate=nullptr;}
 return r;}
extern "C" cublasStatus_t CUBLASWINAPI cublasLtMatmul(cublasLtHandle_t handle,cublasLtMatmulDesc_t desc,const void* alpha,const void*a,cublasLtMatrixLayout_t ad,const void*b,cublasLtMatrixLayout_t bd,const void*beta,const void*c,cublasLtMatrixLayout_t cd,void*d,cublasLtMatrixLayout_t dd,const cublasLtMatmulAlgo_t*algo,void*workspace,size_t workspace_bytes,cudaStream_t stream){
 static auto real=Resolve<decltype(&cublasLtMatmul)>("cublasLtMatmul");auto result=real(handle,desc,alpha,a,ad,b,bd,beta,c,cd,d,dd,algo,workspace,workspace_bytes,stream);if(!std::getenv("Q4T_GDN_CAPTURE_DIR")||stage>=3||result!=CUBLAS_STATUS_SUCCESS)return result;
 const int ns[3]={320,10240,4},ks[3]={10240,320,10240};int n=ns[stage],k=ks[stage];if(!Shape(ad,k,n,CUDA_R_16BF)||!Shape(bd,k,4096,CUDA_R_16BF)||!Shape(dd,n,4096,CUDA_R_16BF))return result;
 cublasComputeType_t compute{};cudaDataType_t scale{};cublasLtEpilogue_t epilogue{};cublasLtPointerMode_t mode{};cublasOperation_t ta{},tb{};
 bool ok=context_ok&&b==(stage==1?down:norm)&&Attribute(desc,CUBLASLT_MATMUL_DESC_COMPUTE_TYPE,&compute)&&compute==CUBLAS_COMPUTE_32F&&Attribute(desc,CUBLASLT_MATMUL_DESC_SCALE_TYPE,&scale)&&scale==CUDA_R_32F&&Attribute(desc,CUBLASLT_MATMUL_DESC_EPILOGUE,&epilogue)&&epilogue==CUBLASLT_EPILOGUE_DEFAULT&&Attribute(desc,CUBLASLT_MATMUL_DESC_POINTER_MODE,&mode)&&mode==CUBLASLT_POINTER_MODE_HOST&&Attribute(desc,CUBLASLT_MATMUL_DESC_TRANSA,&ta)&&ta==CUBLAS_OP_T&&Attribute(desc,CUBLASLT_MATMUL_DESC_TRANSB,&tb)&&tb==CUBLAS_OP_N&&*static_cast<const float*>(alpha)==1.f&&*static_cast<const float*>(beta)==0.f&&workspace_bytes==33554432&&algo;
 const char*names[3]={"down","up","inject"};std::string out=base+"."+names[stage];ok=ok&&Capture(out+".weights.bf16",a,size_t(n)*k*2,stream)&&Save(out+".algo.bin",algo,sizeof(*algo));
 if(stage==1)ok=ok&&Capture(out+".input.bf16",b,size_t(4096)*k*2,stream)&&Compare(source+".up.bf16",d,size_t(4096)*n*2,stream);
 else ok=ok&&Compare(source+".normed.bf16",b,size_t(4096)*k*2,stream)&&Capture(out+".output.bf16",d,size_t(4096)*n*2,stream);
 char extra[200];std::snprintf(extra,sizeof(extra),",\"m\":4096,\"n\":%d,\"k\":%d,\"workspace_bytes\":%zu",n,k,workspace_bytes);Meta(out+".hp.json",ok,extra);std::fprintf(stderr,"[hc-projection-full] %s ok=%d\n",stem.c_str(),ok);if(stage==0)down=d;if(stage==2)gate=d;context_ok=ok;++stage;return result;
}
