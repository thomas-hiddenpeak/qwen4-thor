   assert hashlib.sha256(data).hexdigest()==sha(actual);weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(data),'sha256':sha(actual),'size':f.stat().st_size,'mtime_ns':f.stat().st_mtime_ns})
   meta=json.loads((c/(name+'.hp.json')).read_text());assert meta['ok'] and (meta['m'],meta['n'],meta['k'],meta['workspace_bytes'])==(4096,n,k,33554432)
