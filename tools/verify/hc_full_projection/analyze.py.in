  for item in r['records']:
   name=stem+'.'+item['stage'];f=d/(name+'.replay.bf16');base=pc/f'hc-{l}.prefill.mix.{side}.up.bf16' if item['stage']=='up' else c/(name+'.output.bf16');ref=np.fromfile(f,dtype='<u2');actual=np.fromfile(base,dtype='<u2');assert len(ref)==len(actual)==item['elements'];idx=np.flatnonzero(ref!=actual).astype('<i4');assert len(idx)==item['mismatches'];delta=d/(name+'.replay.delta.npz');np.savez_compressed(delta,indices=idx,values=ref[idx]);z=np.load(delta);rebuilt=actual.copy();rebuilt[z['indices']]=z['values'];assert np.array_equal(rebuilt,ref);digest=sha(f);assert hashlib.sha256(rebuilt.tobytes()).hexdigest()==digest;records.append(dict(item,name=name,base=str(base.relative_to(root)),base_sha256=sha(base),reference_sha256=digest,delta_sha256=sha(delta)));f.unlink()
  save('replay-reference.json',{'records':records,'complete':len(records)==288,'mismatches':sum(x['mismatches'] for x in records)});print({'group':stem,'mismatches':r['total_mismatches']},flush=True)
