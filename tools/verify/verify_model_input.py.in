from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/model-input-reference-20260923';c=o/'observed-captures';old=root/'.q4t-work/e2e/ple-lookup-reference-20260923/observed-captures';hc=root/'.q4t-work/e2e/hc-projection-reference-20260923';data=o/'reference'
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
def read(f,dt='<u2'):return np.fromfile(f,dtype=dt)
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'] and (p/'build.log').stat().st_size==0
assert json.loads((o/'capture-steps.json').read_text())['steps']==7
data.mkdir(exist_ok=False);bindings={}
for f in old.iterdir():assert f.read_bytes()==(c/f.name).read_bytes(),f.name;bindings[f.name]=sha(f)
save(o/'previous-binding.json',bindings)
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];name='model.language_model.embed_tokens.weight';weightfile=model/index[name];st=weightfile.stat()
hm=json.loads((hc/'artifact-binding.json').read_text());assert sha(hc/'previous-binding.json')==hm['previous-binding.json'];hh={x['file']:x['sha256'] for x in json.loads((hc/'previous-binding.json').read_text())['records']};hc_bind={};records=[];selected={}
with weightfile.open('rb') as f:
 size=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(size))[name];assert info['dtype']=='BF16' and info['shape']==[248320,2560];start,end=info['data_offsets'];assert end-start==248320*2560*2;origin=8+size+start
 for step in range(7):
  b=str(c/f'step-{step}');tokens=read(b+'.tokens.i32','<i4');ids=read(b+'.weight-ids.i32','<i4');rows=read(b+'.weight-rows.bf16').reshape(len(ids),2560);embedding=read(b+'.embedding.bf16').reshape(len(tokens),2560);expanded=read(b+'.expanded.bf16').reshape(len(tokens),4,2560);entry=read(b+'.entry-last.bf16').reshape(4,2560);assert np.array_equal(ids,np.unique(tokens)) and np.all((ids>=0)&(ids<248320))
  for i,token in enumerate(ids):
   f.seek(origin+int(token)*5120);raw=f.read(5120);assert len(raw)==5120 and raw==rows[i].tobytes();h=hashlib.sha256(raw).hexdigest();assert int(token) not in selected or selected[int(token)]==h;selected[int(token)]=h
  expected=rows[np.searchsorted(ids,tokens)];assert np.array_equal(embedding,expected);expected.tofile(data/f'step-{step}.expected-embedding.bf16')
  mismatch=[int(np.count_nonzero(expanded[:,branch,:]!=embedding)) for branch in range(4)];assert mismatch==[0,0,0,0] and np.array_equal(entry,expanded[-1])
  if step<2:
   phase='prefill' if step==0 else 'decode';h=hc/'observed-captures'/f'hc-0.{phase}.read.trunk.bf16';assert sha(h)==hh[h.name] and h.read_bytes()==entry.tobytes();hc_bind[str(h.relative_to(root))]=sha(h)
  records.append({'step':step,'tokens':len(tokens),'distinct_token_rows':len(ids),'embedding_elements':len(tokens)*2560,'expanded_elements':len(tokens)*10240,'embedding_mismatches':0,'branch_mismatches':mismatch,'entry_last_mismatches':0,'input_ids_sha256':sha(Path(b+'.tokens.i32')),'actual_weight_rows_sha256':sha(Path(b+'.weight-rows.bf16')),'embedding_sha256':sha(Path(b+'.embedding.bf16')),'expanded_sha256':sha(Path(b+'.expanded.bf16'))})
endstat=weightfile.stat();assert (st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns)==(endstat.st_dev,endstat.st_ino,endstat.st_size,endstat.st_mtime_ns)
save(o/'checkpoint-row-binding.json',{'path':str(weightfile),'tensor':name,'shape':info['shape'],'dtype':info['dtype'],'offset':origin,'size':st.st_size,'mtime_ns':st.st_mtime_ns,'device':st.st_dev,'inode':st.st_ino,'row_hashes':{str(k):v for k,v in sorted(selected.items())}});save(o/'hc-binding.json',hc_bind)
r={'records':records,'tokens':sum(x['tokens'] for x in records),'distinct_tokens':len(selected),'embedding_elements':sum(x['embedding_elements'] for x in records),'expanded_elements':sum(x['expanded_elements'] for x in records),'limitation':'One original4K text request,one sequence,MTP off. First HC input pointer and last row checked per invocation; full expanded output checked. Does not verify final output head or full prefill GDN arithmetic.'};save(o/'input-reference.json',r);print({k:v for k,v in r.items() if k not in ['records','limitation']},'previous_files',len(bindings))
