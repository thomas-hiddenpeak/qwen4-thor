#include <cuda_runtime_api.h>
#include <cublas_v2.h>
#include <cublasLt.h>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>
template <class T>
std::vector<T> Read(const std::string& p, size_t n) {
  std::ifstream f(p, std::ios::binary | std::ios::ate);
  if (!f || size_t(f.tellg()) != n * sizeof(T)) throw std::runtime_error(p);
  std::vector<T> v(n);
  f.seekg(0);
  if (!f.read(reinterpret_cast<char*>(v.data()), n * sizeof(T)))
    throw std::runtime_error(p);
  return v;
}
uint32_t Bits(float x) {
  uint32_t b;
  std::memcpy(&b, &x, 4);
  return b;
}
float B(uint16_t x) {
  uint32_t b = uint32_t(x) << 16;
  float f;
  std::memcpy(&f, &b, 4);
  return f;
}
uint16_t Round(float x) {
  uint32_t b = Bits(x);
  return uint16_t((b + 0x7fff + ((b >> 16) & 1)) >> 16);
}
template <class T>
void Save(const std::string& p, const std::vector<T>& v) {
  std::ofstream f(p, std::ios::binary);
  if (!f.write(reinterpret_cast<const char*>(v.data()), v.size() * sizeof(T)))
    throw std::runtime_error(p);
}

#define CU(x)                                             \
  do {                                                    \
    if ((x) != cudaSuccess) throw std::runtime_error(#x); \
  } while (0)
#define BL(x)                                                       \
  do {                                                              \
    if ((x) != CUBLAS_STATUS_SUCCESS) throw std::runtime_error(#x); \
  } while (0)
int main(int argc, char** argv) {
  try {
    if (argc != 8)
      throw std::runtime_error(
          "weights input actual output_prefix n k algorithm");
    int n = std::stoi(argv[5]), m = 4096, k = std::stoi(argv[6]);
    if (!((n == 1280 && k == 2560) || (n == 2560 && k == 640)))
      throw std::runtime_error("shape");
    std::string name = std::string(argv[4]), o = name;
    auto wb = Read<uint16_t>(argv[1], size_t(n) * k),
         xb = Read<uint16_t>(argv[2], size_t(m) * k),
         actual = Read<uint16_t>(argv[3], size_t(m) * n);

    cublasLtHandle_t lt;
    BL(cublasLtCreate(&lt));
    void *wa, *xa, *ya, *workspace;
    size_t ws = 33554432;
    CU(cudaMalloc(&wa, wb.size() * 2));
    CU(cudaMalloc(&xa, xb.size() * 2));
    CU(cudaMalloc(&ya, actual.size() * 2));
    CU(cudaMalloc(&workspace, ws));
    CU(cudaMemcpy(wa, wb.data(), wb.size() * 2, cudaMemcpyHostToDevice));
    CU(cudaMemcpy(xa, xb.data(), xb.size() * 2, cudaMemcpyHostToDevice));
    CU(cudaMemset(ya, 0, actual.size() * 2));
    cublasLtMatmulDesc_t desc;
    BL(cublasLtMatmulDescCreate(&desc, CUBLAS_COMPUTE_32F, CUDA_R_32F));
    cublasOperation_t ta = CUBLAS_OP_T, tb = CUBLAS_OP_N;
    BL(cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &ta,
                                      sizeof(ta)));
    BL(cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &tb,
                                      sizeof(tb)));
    cublasLtMatrixLayout_t ad, bd, dd;
    BL(cublasLtMatrixLayoutCreate(&ad, CUDA_R_16BF, k, n, k));
    BL(cublasLtMatrixLayoutCreate(&bd, CUDA_R_16BF, k, m, k));
    BL(cublasLtMatrixLayoutCreate(&dd, CUDA_R_16BF, n, m, n));
    auto ab = Read<unsigned char>(argv[7], sizeof(cublasLtMatmulAlgo_t));
    cublasLtMatmulAlgo_t algo;
    std::memcpy(&algo, ab.data(), sizeof(algo));
    cublasLtMatmulHeuristicResult_t checked{};
    BL(cublasLtMatmulAlgoCheck(lt, desc, ad, bd, dd, dd, &algo, &checked));
    if (checked.state != CUBLAS_STATUS_SUCCESS || checked.workspaceSize > ws)
      throw std::runtime_error("algorithm incompatible");
    float af = 1, bf = 0;
    BL(cublasLtMatmul(lt, desc, &af, wa, ad, xa, bd, &bf, ya, dd, ya, dd, &algo,
                      workspace, ws, nullptr));
    std::vector<uint16_t> replay(actual.size());
    CU(cudaMemcpy(replay.data(), ya, replay.size() * 2,
                  cudaMemcpyDeviceToHost));
    Save(o + ".replay.bf16", replay);
    size_t replay_diff = 0;
    for (size_t i = 0; i < actual.size(); ++i)
      replay_diff += actual[i] != replay[i];
    BL(cublasLtMatrixLayoutDestroy(ad));
    BL(cublasLtMatrixLayoutDestroy(bd));
    BL(cublasLtMatrixLayoutDestroy(dd));
    BL(cublasLtMatmulDescDestroy(desc));
    BL(cublasLtDestroy(lt));
    CU(cudaFree(wa));
    CU(cudaFree(xa));
    CU(cudaFree(ya));
    CU(cudaFree(workspace));
    std::printf("{\"elements\":%zu,\"mismatches\":%zu}\n", replay.size(),
                replay_diff);
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
