from pathlib import Path
import json,hashlib,struct,shutil
p=Path(__file__).resolve().parent;root=p.parents[2];source=root/'.q4t-work/e2e/moe-first-decode-reference-20260923';o=root/'.q4t-work/e2e/moe-decode-gemv-order-20260923';o.mkdir(exist_ok=False);c=source/'observed-captures';inputs=o/'inputs';inputs.mkdir()
