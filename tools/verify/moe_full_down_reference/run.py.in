from pathlib import Path
import json,hashlib,shutil,subprocess,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];source=root/'.q4t-work/e2e/moe-full-down-20260924';prior=root/'.q4t-work/e2e/moe-full-gu-20260924';plans=root/'.q4t-work/prepared/moe-full-down-20260924/parameters';o=root/'.q4t-work/e2e/moe-full-down-reference-20260924'
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as s:
  for b in iter(lambda:s.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
assert not o.exists();assert all(not (p/f'{tool}-build.log').read_text().strip() for tool in ['replay','fp64']);assert shutil.disk_usage(p).free>20*1024**3+600_000_000
assert json.loads((source/'exit.json').read_text())['observer_preserved_tested_output'];assert sha(root/'build/q4t')=='2392f6b1fb33f28744d0e63812e47be98b4c6f224e22f087bd627d050f8bbe9e'
for proc in Path('/proc').iterdir():
 if not proc.name.isdigit():continue
 try:a=(proc/'cmdline').read_bytes().split(b'\0');exe=(proc/'exe').resolve(strict=True)
 except OSError:continue
 assert not(exe.name.startswith('q4t') and b'serve' in a)
o.mkdir();d=o/'reference';d.mkdir();bindings=[]
plan={'source_manifest_sha256':sha(source/'artifact-binding.json'),'prior_manifest_sha256':sha(prior/'artifact-binding.json'),'reference_and_temporary_budget_bytes':600_000_000,'reserve_bytes':20*1024**3,'scope':'Full down recorded FP4 algorithm replay and independent dequantization/FP64 GEMM, via FP32/BF16 rounding; actual SF/FP32 alpha; CPU sequential FP64 all outputs at token4095. No runtime/observer edit, reuse frozen HTTP.','storage':'Per-layer temporary complete BF16 references converted to lossless base+delta after full byte/hash reconstruction. Persist all mismatch FP64 and complete tail FP64; matching non-tail unrounded FP64 not retained.'};save('plan.json',plan)
for src,suffixes in [(source,('.counts.i32','.flats.i32','.reorder.i32','.down-output.bf16','.algo.bin')),(prior,('.inter-packed.bin','.inter-sf-logical.bin'))]:
 m=json.loads((src/'artifact-binding.json').read_text())
 for name,digest in m.items():
  if name.startswith('observed-captures/') and name.endswith(suffixes):assert sha(src/name)==digest;bindings.append({'file':str((src/name).relative_to(root)),'sha256':digest})
sm=json.loads((source/'artifact-binding.json').read_text());assert sha(source/'checkpoint-plan.json')==sm['checkpoint-plan.json'];cp=json.loads((source/'checkpoint-plan.json').read_text())
for name,digest in cp['plan_hashes'].items():assert sha(plans/name)==digest
for i,r in enumerate(cp['records']):
 for t in r['tensors']:
  f=Path(t['file']);st=f.stat();assert st.st_size==t['size'] and st.st_mtime_ns==t['mtime_ns']
  with f.open('rb') as s:s.seek(t['offset']);raw=s.read(t['bytes'])
  assert len(raw)==t['bytes'] and hashlib.sha256(raw).hexdigest()==t['sha256']
 if (i+1)%2000==0:print({'checkpoint_records_bound':i+1},flush=True)
save('input-binding.json',bindings);shutil.copy2(source/'checkpoint-plan.json',o/'checkpoint-plan.json');records=[];encodings=[]
for l in range(48):
 layer={'layer':l}
 for tool in ['replay','fp64']:
  cmd=[str(p/tool),str(source/'observed-captures'),str(prior/'observed-captures'),str(plans),str(d),str(l)]
  with (o/f'{tool}-layer-{l}.json').open('w') as out,(o/f'{tool}-layer-{l}.stderr').open('w') as err:result=subprocess.run(cmd,stdout=out,stderr=err)
  assert result.returncode==0,{'layer':l,'tool':tool,'exit':result.returncode};r=json.loads((o/f'{tool}-layer-{l}.json').read_text());assert r['layer']==l and r['elements']==40960*2560;layer[tool]={k:v for k,v in r.items() if k!='records'}
  for item in r['records']:
   name=f"layer-{l}.expert-{item['expert']}";base=source/'observed-captures'/(name+'.down-output.bf16');temp=d/(name+'.'+tool+'.bf16');actual=np.fromfile(base,dtype='<u2');bits=np.fromfile(temp,dtype='<u2');assert len(bits)==len(actual)==item['elements']==item['rows']*2560;idx=np.flatnonzero(bits!=actual).astype('<i4');assert len(idx)==item['mismatches'];index_file=d/(name+('.replay-differences.i32' if tool=='replay' else '.differences.i32'));assert np.array_equal(idx,np.fromfile(index_file,dtype='<i4'));digest=sha(temp);delta=d/(name+'.'+tool+'-delta.npz');np.savez_compressed(delta,indices=idx,bits=bits[idx])
   with np.load(delta) as v:
    rebuilt=actual.copy();rebuilt[v['indices']]=v['bits'];assert np.array_equal(rebuilt,bits) and hashlib.sha256(rebuilt.tobytes()).hexdigest()==digest
   encodings.append({'layer':l,'expert':item['expert'],'tool':tool,'elements':len(bits),'mismatches':len(idx),'base_file':str(base.relative_to(root)),'base_sha256':sha(base),'reference_sha256':digest,'delta':str(delta.relative_to(o))});temp.unlink()
  assert shutil.disk_usage(o).free>plan['reserve_bytes']
 records.append(layer);save('reference.json',{'records':records,'complete':len(records)==48});save('reference-encodings.json',encodings);print(layer,flush=True)
for name in ['replay.cpp','fp64.cpp','replay','fp64','replay-build.log','fp64-build.log','run.py']:shutil.copy2(p/name,o/name)
save('exit.json',{'reference_exit':0,'runtime_changed':False,'whole_model_correctness_proven':False})
