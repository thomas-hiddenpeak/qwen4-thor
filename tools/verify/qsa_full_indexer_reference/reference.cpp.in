#include <cuda_runtime_api.h>
#include <cublas_v2.h>
#include <cublasLt.h>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>
template <class T>
std::vector<T> Read(const std::string& p, size_t n) {
  std::ifstream f(p, std::ios::binary | std::ios::ate);
  if (!f || size_t(f.tellg()) != n * sizeof(T)) throw std::runtime_error(p);
  std::vector<T> v(n);
  f.seekg(0);
  if (!f.read(reinterpret_cast<char*>(v.data()), n * sizeof(T)))
    throw std::runtime_error(p);
  return v;
}
uint32_t Bits(float x) {
  uint32_t b;
  std::memcpy(&b, &x, 4);
  return b;
}
float B(uint16_t x) {
  uint32_t b = uint32_t(x) << 16;
  float f;
  std::memcpy(&f, &b, 4);
  return f;
}
uint16_t Round(float x) {
  uint32_t b = Bits(x);
  return uint16_t((b + 0x7fff + ((b >> 16) & 1)) >> 16);
}
template <class T>
void Save(const std::string& p, const std::vector<T>& v) {
  std::ofstream f(p, std::ios::binary);
  if (!f.write(reinterpret_cast<const char*>(v.data()), v.size() * sizeof(T)))
    throw std::runtime_error(p);
}

#define CU(x)                                             \
  do {                                                    \
    if ((x) != cudaSuccess) throw std::runtime_error(#x); \
  } while (0)
#define BL(x)                                                       \
  do {                                                              \
    if ((x) != CUBLAS_STATUS_SUCCESS) throw std::runtime_error(#x); \
  } while (0)
int main(int argc, char** argv) {
  try {
    if (argc != 9)
      throw std::runtime_error(
          "weights input actual output_prefix n k algorithm m");
    int n = std::stoi(argv[5]), m = std::stoi(argv[8]), k = std::stoi(argv[6]);
    if (!((m == 4096 && k == 2560 && (n == 512 || n == 128)) ||
          (m == 16384 && k == 128 && n == 2048)))
      throw std::runtime_error("shape");
    std::string name = std::string(argv[4]), o = name;
    auto wb = Read<uint16_t>(argv[1], size_t(n) * k),
         xb = Read<uint16_t>(argv[2], size_t(m) * k),
         actual = Read<uint16_t>(argv[3], size_t(m) * n);

    cublasLtHandle_t lt;
    BL(cublasLtCreate(&lt));
    void *wa, *xa, *ya, *workspace;
    size_t ws = 33554432;
    CU(cudaMalloc(&wa, wb.size() * 2));
    CU(cudaMalloc(&xa, xb.size() * 2));
    CU(cudaMalloc(&ya, actual.size() * 2));
    CU(cudaMalloc(&workspace, ws));
    CU(cudaMemcpy(wa, wb.data(), wb.size() * 2, cudaMemcpyHostToDevice));
    CU(cudaMemcpy(xa, xb.data(), xb.size() * 2, cudaMemcpyHostToDevice));
    CU(cudaMemset(ya, 0, actual.size() * 2));
    cublasLtMatmulDesc_t desc;
    BL(cublasLtMatmulDescCreate(&desc, CUBLAS_COMPUTE_32F, CUDA_R_32F));
    cublasOperation_t ta = CUBLAS_OP_T, tb = CUBLAS_OP_N;
    BL(cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &ta,
                                      sizeof(ta)));
    BL(cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &tb,
                                      sizeof(tb)));
    cublasLtMatrixLayout_t ad, bd, dd;
    BL(cublasLtMatrixLayoutCreate(&ad, CUDA_R_16BF, k, n, k));
    BL(cublasLtMatrixLayoutCreate(&bd, CUDA_R_16BF, k, m, k));
    BL(cublasLtMatrixLayoutCreate(&dd, CUDA_R_16BF, n, m, n));
    auto ab = Read<unsigned char>(argv[7], sizeof(cublasLtMatmulAlgo_t));
    cublasLtMatmulAlgo_t algo;
    std::memcpy(&algo, ab.data(), sizeof(algo));
    cublasLtMatmulHeuristicResult_t checked{};
    BL(cublasLtMatmulAlgoCheck(lt, desc, ad, bd, dd, dd, &algo, &checked));
    if (checked.state != CUBLAS_STATUS_SUCCESS || checked.workspaceSize > ws)
      throw std::runtime_error("algorithm incompatible");
    float af = 1, bf = 0;
    BL(cublasLtMatmul(lt, desc, &af, wa, ad, xa, bd, &bf, ya, dd, ya, dd, &algo,
                      workspace, ws, nullptr));
    std::vector<uint16_t> replay(actual.size());
    CU(cudaMemcpy(replay.data(), ya, replay.size() * 2,
                  cudaMemcpyDeviceToHost));
    Save(o + ".replay.bf16", replay);
    size_t replay_diff = 0;
    for (size_t i = 0; i < actual.size(); ++i)
      replay_diff += actual[i] != replay[i];
    BL(cublasLtMatrixLayoutDestroy(ad));
    BL(cublasLtMatrixLayoutDestroy(bd));
    BL(cublasLtMatrixLayoutDestroy(dd));
    BL(cublasLtMatmulDescDestroy(desc));
    BL(cublasLtDestroy(lt));
    CU(cudaFree(wa));
    CU(cudaFree(xa));
    CU(cudaFree(ya));
    CU(cudaFree(workspace));
    std::vector<double> w(wb.size()), x(xb.size()), y(actual.size());
    for (size_t i = 0; i < w.size(); ++i) w[i] = B(wb[i]);
    for (size_t i = 0; i < x.size(); ++i) x[i] = B(xb[i]);
    cublasHandle_t handle;
    BL(cublasCreate(&handle));
    int version;
    BL(cublasGetVersion(handle, &version));
    double *dw, *dx, *dy;
    CU(cudaMalloc(reinterpret_cast<void**>(&dw), w.size() * 8));
    CU(cudaMalloc(reinterpret_cast<void**>(&dx), x.size() * 8));
    CU(cudaMalloc(reinterpret_cast<void**>(&dy), y.size() * 8));
    CU(cudaMemcpy(dw, w.data(), w.size() * 8, cudaMemcpyHostToDevice));
    CU(cudaMemcpy(dx, x.data(), x.size() * 8, cudaMemcpyHostToDevice));
    double alpha = 1, beta = 0;
    BL(cublasDgemm(handle, CUBLAS_OP_T, CUBLAS_OP_N, n, m, k, &alpha, dw, k, dx,
                   k, &beta, dy, n));
    CU(cudaMemcpy(y.data(), dy, y.size() * 8, cudaMemcpyDeviceToHost));
    CU(cudaFree(dw));
    CU(cudaFree(dx));
    CU(cudaFree(dy));
    BL(cublasDestroy(handle));
    std::vector<uint16_t> rounded(y.size());
    std::vector<int32_t> diff;
    std::vector<double> diff_values;
    double max_abs = 0;
    size_t max_index = 0;
    for (size_t i = 0; i < y.size(); ++i) {
      if (!std::isfinite(y[i])) throw std::runtime_error("nonfinite reference");
      rounded[i] = Round(float(y[i]));
      if (rounded[i] != actual[i]) {
        diff.push_back(int32_t(i));
        diff_values.push_back(y[i]);
      }
      double error = std::abs(y[i] - double(B(actual[i])));
      if (error > max_abs) {
        max_abs = error;
        max_index = i;
      }
    }
    Save(o + ".fp64.bf16", rounded);
    Save(o + ".differences.i32", diff);
    Save(o + ".differences.f64", diff_values);
    std::vector<double> last(y.end() - n, y.end());
    Save(o + ".last.f64", last);

    std::vector<double> cpu(n);
    size_t cpu_diff = 0, cpu_rounded_diff = 0;
    for (int j = 0; j < n; ++j) {
      double acc = 0;
      for (int z = 0; z < k; ++z)
        acc = std::fma(w[size_t(j) * k + z], x[size_t(m - 1) * k + z], acc);
      cpu[j] = acc;
      cpu_diff += std::memcmp(&acc, &last[j], 8) != 0;
      cpu_rounded_diff += Round(float(acc)) != rounded[size_t(m - 1) * n + j];
    }
    Save(o + ".cpu-last.f64", cpu);
    std::printf(
        "{\"elements\":%zu,\"mismatches\":%zu,\"replay_mismatches\":%zu,\"cpu_"
        "last_elements\":%d,\"cpu_last_raw_mismatches\":%zu,\"cpu_last_rounded_"
        "mismatches\":%zu,\"max_abs_vs_fp64\":%.17g,\"max_abs_index\":%zu,"
        "\"cublas_version\":%d}\n",
        y.size(), diff.size(), replay_diff, n, cpu_diff, cpu_rounded_diff,
        max_abs, max_index, version);
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
