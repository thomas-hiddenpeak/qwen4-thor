#include <algorithm>
#include "common.h"
uint8_t Nearest(float v, const std::vector<float>& values) {
  auto it = std::lower_bound(values.begin(), values.end(), v);
  int hi = int(it - values.begin());
  if (hi == 0) return 0;
  if (hi == int(values.size())) return uint8_t(hi - 1);
  double dl = double(v) - values[hi - 1], dh = double(values[hi]) - v;
  if (dl < dh) return uint8_t(hi - 1);
  if (dh < dl) return uint8_t(hi);
  return uint8_t((hi & 1) ? hi - 1 : hi);
}
int main(int argc, char** argv) {
  try {
    if (argc != 6)
      throw std::runtime_error("captures prior outputs layer frozen_reference");
    int l = std::stoi(argv[4]);
    std::string b = std::string(argv[1]) + "/layer-" + std::to_string(l),
                o = std::string(argv[3]) + "/layer-" + std::to_string(l);
    auto x = Read<uint16_t>(std::string(argv[2]) + "/hc-" + std::to_string(l) +
                                ".prefill.mix.mlp.output.bf16",
                            4096 * 2560);
    auto flat = Read<int32_t>(b + ".lists.i32", kRows),
         offset = Read<int32_t>(b + ".offsets.i32", 513);
    auto scales = Read<float>(b + ".input-scales.f32", 512);
    std::string frozen = std::string(argv[5]) + "/layer-" + std::to_string(l);
    auto device_ratio = Read<float>(frozen + ".device-ratios.f32", kGroups);
    auto legacy = Read<uint8_t>(frozen + ".legacy.sf", kGroups),
         native = Read<uint8_t>(frozen + ".native.sf", kGroups);
    std::vector<uint8_t> actual_sf(kGroups), actual_packed(kRows * 1280);
    std::vector<int32_t> experts(kRows);
    for (int e = 0; e < 512; ++e) {
      int rows = offset[e + 1] - offset[e];
      if (!rows) continue;
      std::string name = b + ".expert-" + std::to_string(e);
      auto sf = Read<uint8_t>(name + ".sf-logical.bin", size_t(rows) * 160),
           packed = Read<uint8_t>(name + ".packed.bin", size_t(rows) * 1280);
      std::copy(sf.begin(), sf.end(),
                actual_sf.begin() + size_t(offset[e]) * 160);
      std::copy(packed.begin(), packed.end(),
                actual_packed.begin() + size_t(offset[e]) * 1280);
      for (int r = offset[e]; r < offset[e + 1]; ++r) experts[r] = e;
    }
    std::vector<float> fp8(127), fp4{0, .5, 1, 1.5, 2, 3, 4, 6};
    for (int c = 0; c < 127; ++c)
      fp8[c] = c < 8 ? std::ldexp(float(c), -9)
                     : std::ldexp(1.f + float(c % 8) / 8, c / 8 - 7);
    std::vector<float> ratios(kGroups);
    std::vector<uint8_t> cpu_sf(kGroups), device_rne(kGroups),
        packed(kRows * 1280);
    size_t bad_fp4 = 0, bad_sf = 0, bad_native = 0, bad_legacy = 0,
           bad_ratio = 0, cpu_device_sf = 0, high_errors = 0, other_errors = 0;
#pragma omp parallel for reduction(+ : bad_fp4, bad_sf, bad_native,          \
                                       bad_legacy, bad_ratio, cpu_device_sf, \
                                       high_errors, other_errors)
    for (size_t i = 0; i < kGroups; ++i) {
      size_t row = i / 160, g = i % 160;
      int t = flat[row] / 10, e = experts[row];
      float maximum = 0;
      for (int j = 0; j < 16; ++j)
        maximum = std::fmax(
            maximum, std::fabs(Decode(x[size_t(t) * 2560 + g * 16 + j])));
      float block = maximum > 0 ? maximum / 6.f : 1.f;
      ratios[i] = block / scales[e];
      cpu_sf[i] = Nearest(ratios[i], fp8);
      device_rne[i] = Nearest(device_ratio[i], fp8);
      bad_native += device_rne[i] != native[i];
      bad_legacy += legacy[i] != actual_sf[i];
      bad_ratio += Bits(ratios[i]) != Bits(device_ratio[i]);
      cpu_device_sf += cpu_sf[i] != device_rne[i];
      bool wrong = device_rne[i] != actual_sf[i];
      bad_sf += wrong;
      if (wrong) {
        if (device_ratio[i] >= 248 && device_ratio[i] < 432)
          ++high_errors;
        else
          ++other_errors;
      }
      float eff = fp8.at(device_rne[i]) * scales[e],
            inv = eff > 0 ? 1.f / eff : 0;
      for (int j = 0; j < 8; ++j) {
        uint8_t codes[2];
        for (int q = 0; q < 2; ++q) {
          float v = Decode(x[size_t(t) * 2560 + g * 16 + j * 2 + q]) * inv;
          codes[q] = Nearest(std::fabs(v), fp4) | (v < 0 ? 8 : 0);
          uint8_t actual = (actual_packed[i * 8 + j] >> (q * 4)) & 15;
          bad_fp4 += codes[q] != actual;
        }
        packed[i * 8 + j] = uint8_t(codes[0] | (codes[1] << 4));
      }
    }
    Save(o + ".cpu-ratios.f32", ratios);
    Save(o + ".cpu-rne.sf", cpu_sf);
    Save(o + ".device-rne.sf", device_rne);
    Save(o + ".cpu.packed.bin", packed);
    std::vector<int32_t> sf_diff, packed_diff, ratio_diff;
    for (size_t i = 0; i < kGroups; ++i) {
      if (device_rne[i] != actual_sf[i]) sf_diff.push_back(int32_t(i));
      if (Bits(ratios[i]) != Bits(device_ratio[i]))
        ratio_diff.push_back(int32_t(i));
    }
    for (size_t i = 0; i < packed.size(); ++i)
      if (packed[i] != actual_packed[i]) packed_diff.push_back(int32_t(i));
    Save(o + ".sf-differences.i32", sf_diff);
    Save(o + ".packed-differences.i32", packed_diff);
    Save(o + ".ratio-differences.i32", ratio_diff);
    std::printf(
        "{\"layer\":%d,\"groups\":%zu,\"fp4_elements\":%zu,\"fp4_changes_with_"
        "corrected_sf\":%zu,\"sf_mismatches_vs_device_ratio_rne\":%zu,\"native_"
        "vs_independent_rne_mismatches\":%zu,\"legacy_vs_actual_mismatches\":%"
        "zu,\"cpu_device_ratio_bit_mismatches\":%zu,\"cpu_device_rne_"
        "mismatches\":%zu,\"high_range_sf_errors\":%zu,\"other_sf_errors\":%zu}"
        "\n",
        l, kGroups, kGroups * 16, bad_fp4, bad_sf, bad_native, bad_legacy,
        bad_ratio, cpu_device_sf, high_errors, other_errors);
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
