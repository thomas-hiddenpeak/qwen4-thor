// Appended to the exact old kernels and candidate public implementation.
void Check(cudaError_t error) {
  if (error != cudaSuccess) {
    std::fprintf(stderr, "%s\n", cudaGetErrorString(error));
    std::exit(1);
  }
}
template <class T>
struct Buffer {
  T* data;
  size_t count;
  explicit Buffer(size_t n) : count(n) {
    Check(cudaMalloc(&data, n * sizeof(T)));
  }
  ~Buffer() { cudaFree(data); }
  void Upload(const std::vector<T>& v) {
    Check(cudaMemcpy(data, v.data(), v.size() * sizeof(T),
                     cudaMemcpyHostToDevice));
  }
};
size_t checked = 0;
template <class T>
void Equal(const T* a, const T* b, size_t n, const char* stage) {
  std::vector<T> x(n), y(n);
  Check(cudaMemcpy(x.data(), a, n * sizeof(T), cudaMemcpyDeviceToHost));
  Check(cudaMemcpy(y.data(), b, n * sizeof(T), cudaMemcpyDeviceToHost));
  if (std::memcmp(x.data(), y.data(), n * sizeof(T))) {
    std::fprintf(stderr, "bit mismatch: %s\n", stage);
    std::exit(1);
  }
  checked += n;
}
struct Scratch {
  Buffer<float> v0, v1;
  Buffer<int> i0, i1, topk, length;
  explicit Scratch(int tokens)
      : v0(tokens * 16384),
        v1(tokens * 16384),
        i0(tokens * 16384),
        i1(tokens * 16384),
        topk(tokens * 2052),
        length(tokens) {}
};
void Original(const float* logits, int groups, int tokens, const int* positions,
              Scratch& s) {
  const int slices = (groups + 2047) / 2048;
  int current = slices * 512;
  baseline::SliceLocalTopkKernel<<<dim3(slices, tokens), 256>>>(
      logits, groups, 2048, 512, tokens, s.v0.data, s.i0.data, current);
  float* iv = s.v0.data;
  int* ii = s.i0.data;
  float* ov = s.v1.data;
  int* oi = s.i1.data;
  int stride = current;
  while (current > 2048) {
    const int windows = (current + 2047) / 2048;
    const int next = windows * 512;
    baseline::WindowMergeTopkKernel<<<dim3(windows, tokens), 256>>>(
        iv, ii, current, stride, 2048, 512, tokens, ov, oi, next);
    std::swap(iv, ov);
    std::swap(ii, oi);
    stride = next;
    current = next;
  }
  baseline::FinalTopkExpandKernel<<<tokens, 256>>>(
      iv, ii, current, stride, positions, tokens, 4, 512, s.topk.data,
      s.length.data, 2052);
  Check(cudaGetLastError());
}
int main() {
  int cases = 0;
  uint32_t rng = 20260921;
  for (int groups : {2049, 4095, 4096, 8193, 16384, 32769, 51264, 65536}) {
    for (int tokens : {1, 4}) {
      Buffer<float> logits(static_cast<size_t>(tokens) * groups);
      Buffer<int> positions(tokens);
      Scratch old(tokens), now(tokens);
      for (int family = 0; family < 4; ++family) {
        std::vector<float> scores(logits.count);
        std::vector<int> pos(tokens);
        for (int t = 0; t < tokens; ++t) {
          const int visible = groups - 7 * t;
          pos[t] = visible * 4 - 1 + (t + family) % 4;
          for (int g = 0; g < groups; ++g) {
            rng = rng * 1664525u + 1013904223u;
            float v = (rng >> 8) / 16777216.0f;
            if (family == 1)
              v = g % 4 ? float(g % 4) : ((g & 4) ? -0.0f : 0.0f);
            if (family == 2 || g >= visible) v = -1e30f;
            if (family == 3 && g < visible && g >= visible - 16) v += 10.0f;
            scores[static_cast<size_t>(t) * groups + g] = v;
          }
        }
        logits.Upload(scores);
        positions.Upload(pos);
        Original(logits.data, groups, tokens, positions.data, old);
        auto status = q4t::model::SelectDecodeTopk(
            logits.data, groups, tokens, positions.data, 4, 2052, now.v0.data,
            now.i0.data, now.v1.data, now.i1.data, now.topk.data,
            now.length.data, nullptr);
        if (!status) {
          std::fprintf(stderr, "%s\n", status.message().c_str());
          return 1;
        }
        const int first = ((groups + 2047) / 2048) * 512;
        Equal(old.v0.data, now.v0.data, tokens * first, "scores0");
        Equal(old.i0.data, now.i0.data, tokens * first, "IDs0");
        if (first > 2048) {
          const int second = ((first + 2047) / 2048) * 512;
          Equal(old.v1.data, now.v1.data, tokens * second, "scores1");
          Equal(old.i1.data, now.i1.data, tokens * second, "IDs1");
        }
        Equal(old.topk.data, now.topk.data, tokens * 2052,
              "expanded positions");
        Equal(old.length.data, now.length.data, tokens, "topk lengths");
        ++cases;
      }
    }
  }
  std::printf("PASS: %d cases, %zu values/IDs/positions bit-exact\n", cases,
              checked);
  return 0;
}
