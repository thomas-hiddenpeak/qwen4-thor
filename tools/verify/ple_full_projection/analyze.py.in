from pathlib import Path
import json,hashlib,struct,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/ple-full-projection-v2-20260924';c=o/'observed-captures';prior=root/'.q4t-work/e2e/ple-full-gate-norm-20260924';lookup=root/'.q4t-work/e2e/ple-lookup-reference-20260923';model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream')
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'];assert sha(root/'build/q4t')==json.loads((o/'plan.json').read_text())['binary_sha256']
for label,source in [('prior',prior),('lookup',lookup)]:
 binding=json.loads((o/(label+'-binding.json')).read_text());assert sha(source/'artifact-binding.json')==binding['manifest_sha256']
 for r in binding['records']:assert sha(source/r['file'])==r['sha256']
for kind in ['conversion','scale','key','value','key-consumer','value-consumer']:assert json.loads((c/(kind+'.json')).read_text())['ok']
index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];weights=[]
def tensor(key,shape):
 f=model/index[key]
 with f.open('rb') as stream:
  size=struct.unpack('<Q',stream.read(8))[0];info=json.loads(stream.read(size))[key];assert info['dtype']=='BF16' and info['shape']==shape;a,b=info['data_offsets'];offset=8+size+a;stream.seek(offset);raw=stream.read(b-a)
 assert len(raw)==int(np.prod(shape))*2;st=f.stat();weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns});return raw
for kind,n in [('key',10240),('value',2560)]:
 raw=tensor(f'model.language_model.layers.1.ple.{kind}_proj.weight',[n,2560]);assert raw==(c/(kind+'.weights.bf16')).read_bytes();assert (c/(kind+'.algo.bin')).stat().st_size==64
raw=tensor('model.language_model.layers.1.ple.ple_embedding.ngram_embedding.weight_scale',[1]);bits=np.frombuffer(raw,dtype='<u2').astype('<u4')<<16;scale=bits.view('<f4');assert scale.tobytes()==(c/'scale.f32').read_bytes()==(lookup/'observed-captures/step-0.scale.f32').read_bytes()
save('checkpoint-binding.json',weights);summary={'tokens':4096,'embedding_elements':4096*2560,'key_elements':4096*10240,'value_elements':4096*2560,'checkpoint_bytes':sum(w['bytes'] for w in weights),'actual_scale':float(scale[0]),'full_fp8_conversion_scale_sources_equal':True,'full_projection_inputs_equal_scaled_lookup':True,'full_projection_outputs_equal_consumers':True,'recorded_algorithms':2,'projection_arithmetic_verified':False,'runtime_changed':False,'whole_model_correctness_proven':False,'free_after':shutil.disk_usage(o).free};save('summary.json',summary);shutil.copy2(p/'analyze.py',o/'analyze.py');save('artifact-binding.json',{str(f.relative_to(o)):sha(f) for f in sorted(o.rglob('*')) if f.is_file() and f.name!='artifact-binding.json'});print(summary,flush=True)
