from pathlib import Path
import hashlib,json,subprocess,shutil,os,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];e=root/'.q4t-work/e2e';o=e/p.name;d=o/'reference';s=e/'linear-prefill-conv-20260923';c=s/'observed-captures';u=e/'moe-scale-linear-input-l2-20260924'
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as z:
  for b in iter(lambda:z.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(n,x):(o/n).write_text(json.dumps(x,indent=2)+'\n')
assert not any(d.iterdir());assert (p/'build.log').stat().st_size==0;assert sha(root/'build/q4t')=='2392f6b1fb33f28744d0e63812e47be98b4c6f224e22f087bd627d050f8bbe9e';budget=3000000000;reserve=20*1024**3;assert shutil.disk_usage(o).free>reserve+budget
man={x.name:json.loads((x/'artifact-binding.json').read_text()) for x in [s,u]};bindings=[]
def bind(x,n):
 f=x/n;v=sha(f);assert v==man[x.name][n];bindings.append({'file':str(f.relative_to(root)),'sha256':v});return f
assert json.loads(bind(s,'exit.json').read_text())['observer_preserved_tested_output'];assert json.loads(bind(u,'reference.json').read_text())['complete'];branches=['baseline','input_fixed','inter_fixed','both_fixed'];paths={b:bind(u,'reference/'+b+'/layer-2.prefill.qkv.replay.bf16') for b in branches}
for suffix in ['input.bf16','weights.bf16','history-before.bf16','history-updated.bf16','output.bf16','gdn-input.bf16']:bind(s,'observed-captures/layer-2.'+suffix)
assert sha(paths['baseline'])==sha(c/'layer-2.input.bf16');assert sha(c/'layer-2.output.bf16')==sha(c/'layer-2.gdn-input.bf16');assert not np.fromfile(c/'layer-2.history-before.bf16',dtype='<u2').any()
weights=[w for w in json.loads(bind(s,'checkpoint-binding.json').read_text()) if w['layer']==2];assert len(weights)==1
for w in weights:
 f=Path(w['path']);st=f.stat();assert st.st_size==w['size'] and st.st_mtime_ns==w['mtime_ns']
 with f.open('rb') as z:z.seek(w['offset']);assert hashlib.sha256(z.read(w['bytes'])).hexdigest()==w['sha256']
save('input-binding.json',bindings);save('checkpoint-binding.json',weights);save('source-manifests.json',{x.name:sha(x/'artifact-binding.json') for x in [s,u]});save('plan.json',{'budget_bytes':budget,'reserve_bytes':reserve,'scope':'Four own layer2 QKV projections -> K4 dilation1 causal short convolution with zero initial history -> device SiLU -> BF16; CPU sequential4 FMA. Full4096x10240 output and updated last3 raw QKV history. Baseline restores actual GDN input and updated history. GDN normalization/recurrence not run.','retention':'Complete convolution FP32 accumulator/device SiLU/BF16 for all branches, all output differences/token counts, complete updated BF16 history and differences.'})
oldinput=np.fromfile(c/'layer-2.input.bf16',dtype='<u2').reshape(4096,10240);actual=np.fromfile(c/'layer-2.output.bf16',dtype='<u2');records=[]
for branch in branches:
 prefix=d/branch;proc=subprocess.run([str(p/'conv'),str(c),str(paths[branch]),str(prefix),'2'],capture_output=True,text=True,env={**os.environ,'OMP_NUM_THREADS':'8'});(o/(branch+'.stdout')).write_text(proc.stdout);(o/(branch+'.stderr')).write_text(proc.stderr);assert proc.returncode==0,proc.stderr;r=json.loads(proc.stdout);new=np.fromfile(str(prefix)+'.bf16',dtype='<u2');assert len(new)==r['elements']==41943040;idx=np.flatnonzero(new!=actual).astype('<i4');assert len(idx)==r['mismatches'] and np.array_equal(idx,np.fromfile(str(prefix)+'.differences.i32',dtype='<i4'));counts=np.bincount(idx//10240,minlength=4096).astype('<i4');counts.tofile(str(prefix)+'.token-differences.i32');x=np.fromfile(paths[branch],dtype='<u2').reshape(4096,10240);changed=np.any(x!=oldinput,axis=1);allowed=changed.copy()
 for shift in [1,2,3]:allowed[shift:]|=changed[:-shift]
 assert not np.any((counts>0)&~allowed)
 for suffix in ['acc.f32','silu.f32']:
  f=np.fromfile(str(prefix)+'.'+suffix,dtype='<f4');assert len(f)==41943040 and np.isfinite(f).all()
 bits=f.view('<u4');assert np.array_equal(((bits+np.uint32(0x7fff)+((bits>>16)&1))>>16).astype('<u2'),new);assert np.isfinite((new.astype('<u4')<<16).view('<f4')).all()
 state=x[-3:].T.copy();state.tofile(str(prefix)+'.history.bf16');oldstate=np.fromfile(c/'layer-2.history-updated.bf16',dtype='<u2');sd=np.flatnonzero(state.reshape(-1)!=oldstate).astype('<i4');sd.tofile(str(prefix)+'.history-differences.i32')
 if branch=='baseline':assert len(idx)==len(sd)==0
 r.update(branch=branch,changed_tokens=int(np.count_nonzero(counts)),newly_affected_tokens=int(np.count_nonzero((counts>0)&~changed)),allowed_by_causal_support=int(allowed.sum()),history_elements=state.size,history_mismatches=len(sd),output_sha256=sha(Path(str(prefix)+'.bf16')));records.append(r);print(r,flush=True)
save('reference.json',{'records':records,'complete':len(records)==4});summary={'records':records,'runtime_changed':False,'whole_model_correctness_proven':False,'task_causality_established':False,'propagation_endpoint':'layer2 GDN raw QKV input and short-conv updated history; q/k normalization/recurrence pending'}
for n in ['run.py','conv.cu','common.h','conv','build.log']:shutil.copy2(p/n,o/n)
summary['artifact_bytes_before_sealing']=sum(f.stat().st_size for f in o.rglob('*') if f.is_file());assert summary['artifact_bytes_before_sealing']<budget;save('summary.json',summary);print(summary,flush=True)
