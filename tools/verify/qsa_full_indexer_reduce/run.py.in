 base=q/f'observed-captures/layer-{l}.prefill.scores.f32';assert sha(base)==qm[str(base.relative_to(q))]
 for v in variants:
  rows=[r for r in records if r['layer']==l and r['variant']==v];assert [r['first'] for r in rows]==list(range(0,4096,256));rebuilt=np.fromfile(base,dtype='<u4').reshape(4096,2048)
  for r in rows:
   f=o/r['delta'];assert sha(f)==r['delta_sha256'];z=np.load(f);chunk=rebuilt[r['first']:r['first']+256].reshape(-1);chunk[z['indices']]=z['values'];assert hashlib.sha256(chunk.tobytes()).hexdigest()==r['reference_sha256']
  full.append({'layer':l,'variant':v,'reference_sha256':hashlib.sha256(rebuilt.tobytes()).hexdigest()})
save('full-reconstruction.json',full);summary={v:{key:sum(r[key] for r in records if r['variant']==v) for key in ['elements','visible_scores','mismatches','masked_mismatches','zero_sign_only']} for v in variants};summary.update(all_references_reconstructed=True,runtime_changed=False,whole_model_correctness_proven=False,free_after=shutil.disk_usage(o).free);shutil.copy2(p/'run.py',o/'run.py');summary['artifact_bytes_before_sealing']=sum(f.stat().st_size for f in o.rglob('*') if f.is_file());assert summary['artifact_bytes_before_sealing']<budget;save('summary.json',summary);print(summary,flush=True)
