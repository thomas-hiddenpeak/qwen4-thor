p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-full-indexer-reduce-v2-20260924';d=o/'reference';s=root/'.q4t-work/e2e/qsa-full-indexer-20260924';q=root/'.q4t-work/e2e/qsa-full-selection-20260924';old=root/'.q4t-work/e2e/qsa-indexer-reference-20260923'
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):h.update(b)
 return h.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
