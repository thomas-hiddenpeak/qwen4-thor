// Read-only last-prefill-token boundaries. CUDA13.3/model-shape diagnostic.
#include <cuda_runtime_api.h>
#include <cublasLt.h>
#include <dlfcn.h>
#include <algorithm>
#include <array>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> router{nullptr}, mapping{nullptr}, grouped{nullptr},
    combined{nullptr}, shared_swiglu{nullptr}, gather{nullptr}, inter_quant{nullptr};
struct PendingGu { const void* packed = nullptr; int expert = -1; int row = -1; int rows = 0; float scale = 0; };
thread_local PendingGu gu_pending, inter_pending;
thread_local const void* inter_input = nullptr;
thread_local bool pending_down = false;
std::atomic<int> next_layer{0};
thread_local int layer = -1;
thread_local std::array<int32_t, 10> ids{};
thread_local bool router_ok = false, mapping_ok = false, grouped_ok = false;
thread_local bool shared_ok = false;
constexpr int kT = 4096, kToken = 4095, kHs = 2560, kE = 512, kSlots = 10;
template <typename T> T Resolve(const char* name) {
  auto fn = reinterpret_cast<T>(dlsym(RTLD_NEXT, name));
  if (!fn) std::_Exit(127);
  return fn;
}
std::string Base() {
  const char* dir = std::getenv("Q4T_TOKEN_CAPTURE_DIR");
  return std::string(dir ? dir : "") + "/layer-" + std::to_string(layer);
}
bool Save(const std::string& path, const void* data, size_t bytes) {
  FILE* f = std::fopen(path.c_str(), "wb");
  if (!f) return false;
  const bool ok = std::fwrite(data, 1, bytes, f) == bytes;
  return std::fclose(f) == 0 && ok;
}
bool Read(void* dst, const void* src, size_t bytes, cudaStream_t stream) {
  static const auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static const auto sync = Resolve<decltype(&cudaStreamSynchronize)>(
      "cudaStreamSynchronize");
  return copy(dst, src, bytes, cudaMemcpyDeviceToHost, stream) == cudaSuccess &&
         sync(stream) == cudaSuccess;
}
bool Capture(const char* suffix, const void* src, size_t bytes,
             cudaStream_t stream) {
  std::vector<unsigned char> data(bytes);
  return Read(data.data(), src, bytes, stream) &&
         Save(Base() + suffix, data.data(), bytes);
}
template <typename T> T* Pointer(void** args, int index) {
  return *static_cast<T**>(args[index]);
}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* kernel, const void* fn) {
  using Get = cudaError_t (*)(cudaKernel_t*, const void*);
  static const auto real = Resolve<Get>("__cudaGetKernel");
  const auto status = real(kernel, fn);
  if (status == cudaSuccess) {
    const char* name = nullptr;
    static const auto get_name = Resolve<decltype(&cudaFuncGetName)>(
        "cudaFuncGetName");
    if (get_name(&name, fn) == cudaSuccess && name) {
      if (std::strstr(name, "RouterTopkKernel") &&
          std::strstr(name, "5model")) router = *kernel;
      if (std::strstr(name, "SwiGLUQuantKernel")) inter_quant = *kernel;
      if (std::strstr(name, "GatherQuantKernel")) gather = *kernel;
      if (std::strstr(name, "BuildRowOfFlatKernel")) mapping = *kernel;
      if (std::strstr(name, "CombineGroupedKernel")) grouped = *kernel;
      if (std::strstr(name, "SwiGLUKernel") &&
          std::strstr(name, "5model")) shared_swiglu = *kernel;
      if (std::strstr(name, "MoECombineKernel") &&
          std::strstr(name, "5model")) combined = *kernel;
    }
  }
  return status;
}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t kernel, dim3 grid,
    dim3 block, void** args, size_t shared, cudaStream_t stream) {
  using Launch = cudaError_t (*)(cudaKernel_t, dim3, dim3, void**, size_t,
                                cudaStream_t);
  static const auto real = Resolve<Launch>("__cudaLaunchKernel");
  const bool enabled = std::getenv("Q4T_TOKEN_CAPTURE_DIR") != nullptr;
  if (enabled && kernel == grouped && layer >= 0 && layer < 48 &&
      *static_cast<int*>(args[5]) == kT &&
      *static_cast<int*>(args[3]) == kSlots &&
      *static_cast<int*>(args[4]) == kHs) {
    std::array<int32_t, kSlots> rows{};
    grouped_ok = Read(rows.data(), Pointer<int32_t>(args, 1) + kToken * kSlots,
                      sizeof(rows), stream) &&
        Save(Base() + ".rows.i32", rows.data(), sizeof(rows)) &&
        Capture(".weights.f32", Pointer<float>(args, 2) + kToken * kSlots,
                kSlots * sizeof(float), stream) &&
        Capture(".before.f32", Pointer<float>(args, 6) + kToken * kHs,
                kHs * sizeof(float), stream);
    std::vector<uint16_t> down(kSlots * kHs);
    for (int slot = 0; slot < kSlots && grouped_ok; ++slot) {
      grouped_ok = rows[slot] >= 0 && rows[slot] < kT * kSlots &&
          Read(down.data() + slot * kHs,
               Pointer<uint16_t>(args, 0) + static_cast<size_t>(rows[slot]) * kHs,
               kHs * sizeof(uint16_t), stream);
    }
    grouped_ok = grouped_ok &&
        Save(Base() + ".experts.bf16", down.data(), down.size() * 2);
  }
  const auto status = real(kernel, grid, block, args, shared, stream);
  if (!enabled || status != cudaSuccess) return status;
  if (kernel == router && *static_cast<int*>(args[3]) == kT &&
      *static_cast<int*>(args[4]) == kE &&
      *static_cast<int*>(args[5]) == kSlots) {
    layer = next_layer.fetch_add(1);
    router_ok = mapping_ok = grouped_ok = shared_ok = false;
    if (layer >= 48) return status;
    router_ok = Read(ids.data(), Pointer<int32_t>(args, 1) + kToken * kSlots,
                     sizeof(ids), stream) &&
        Save(Base() + ".ids.i32", ids.data(), sizeof(ids)) &&
        Capture(".logits.bf16", Pointer<uint16_t>(args, 0) + kToken * kE,
                kE * sizeof(uint16_t), stream) &&
        Capture(".router-weights.f32", Pointer<float>(args, 2) + kToken * kSlots,
                kSlots * sizeof(float), stream);
  }
  if (layer < 0 || layer >= 48) return status;
  if (kernel == gather && *static_cast<int*>(args[5]) == kT &&
      *static_cast<int*>(args[6]) == kHs) {
    gu_pending = {}; inter_pending = {}; inter_input = nullptr; pending_down = false;
    const int e = *static_cast<int*>(args[3]);
    const int rows = *static_cast<int*>(args[2]);
    if (std::find(ids.begin(), ids.end(), e) != ids.end() && rows > 0 && rows <= kT) {
      std::vector<int32_t> list(rows);
      float scale = 0;
      bool ok = Read(list.data(), Pointer<int32_t>(args, 1) + e * kT,
                     rows * sizeof(int32_t), stream) &&
          Read(&scale, Pointer<float>(args, 8) + e, sizeof(scale), stream);
      int row = -1, hits = 0;
      for (int j = 0; j < rows; ++j) if (list[j] / kSlots == kToken) { row = j; ++hits; }
      ok = ok && hits == 1;
      const std::string tag = ".expert-" + std::to_string(e);
      ok = ok && Capture((tag + ".gu-input.bf16").c_str(),
          Pointer<uint16_t>(args, 0) + size_t(kToken) * kHs, kHs * 2, stream);
      if (ok) gu_pending = {Pointer<uint8_t>(args, 9), e, row, rows, scale};
      else std::fprintf(stderr, "[token-gu] gather error layer=%d expert=%d\n", layer, e);
    }
  }
  if (kernel == inter_quant && inter_input &&
      Pointer<uint16_t>(args, 0) == inter_input) {
    const auto snap = inter_pending;
    const std::string tag = ".expert-" + std::to_string(snap.expert);
    const bool ok = *static_cast<int*>(args[3]) == snap.rows &&
        *static_cast<int*>(args[4]) == 640 &&
        Capture((tag + ".inter-input.bf16").c_str(),
            Pointer<uint16_t>(args, 0) + size_t(snap.row) * 1280, 2560, stream);
    if (ok) {
      gu_pending = snap; gu_pending.packed = Pointer<uint8_t>(args, 1);
      gu_pending.scale = *static_cast<float*>(args[6]); pending_down = true;
    }
    inter_input = nullptr;
  }
  if (kernel == mapping && *static_cast<int*>(args[2]) == kT) {
    std::array<int32_t, kE + 1> offsets{};
    mapping_ok = router_ok && Read(offsets.data(), Pointer<int32_t>(args, 1),
                                  sizeof(offsets), stream) &&
        Save(Base() + ".offsets.i32", offsets.data(), sizeof(offsets));
    for (int slot = 0; slot < kSlots && mapping_ok; ++slot) {
      const int e = ids[slot];
      if (e < 0 || e >= kE) { mapping_ok = false; break; }
      const int count = offsets[e + 1] - offsets[e];
      if (count <= 0 || count > kT) { mapping_ok = false; break; }
      std::vector<int32_t> list(count);
      mapping_ok = Read(list.data(), Pointer<int32_t>(args, 0) + e * kT,
                        list.size() * sizeof(int32_t), stream) &&
          Save(Base() + ".list-" + std::to_string(slot) + ".i32",
               list.data(), list.size() * sizeof(int32_t));
    }
  }
  if (kernel == grouped && *static_cast<int*>(args[5]) == kT) {
    grouped_ok = grouped_ok && Capture(".routed.f32",
        Pointer<float>(args, 6) + kToken * kHs, kHs * sizeof(float), stream);
  }
  if (kernel == shared_swiglu && *static_cast<int*>(args[2]) == kT &&
      *static_cast<int*>(args[3]) == 640) {
    shared_ok = Capture(".shared-gu.bf16",
        Pointer<uint16_t>(args, 0) + static_cast<size_t>(kToken) * 1280,
        1280 * sizeof(uint16_t), stream) &&
        Capture(".shared-inter.bf16",
        Pointer<uint16_t>(args, 1) + static_cast<size_t>(kToken) * 640,
        640 * sizeof(uint16_t), stream);
  }
  if (kernel == combined && *static_cast<int*>(args[5]) == kT &&
      *static_cast<int*>(args[6]) == kHs) {
    const bool ok = router_ok && mapping_ok && grouped_ok && shared_ok &&
        Capture(".merge-routed.f32", Pointer<float>(args, 0) + kToken * kHs,
                kHs * sizeof(float), stream) &&
        Capture(".shared.bf16", Pointer<uint16_t>(args, 1) + kToken * kHs,
                kHs * sizeof(uint16_t), stream) &&
        Capture(".x.bf16", Pointer<uint16_t>(args, 2) + kToken * kHs,
                kHs * sizeof(uint16_t), stream) &&
        Capture(".gate.bf16", Pointer<uint16_t>(args, 3),
                kHs * sizeof(uint16_t), stream) &&
        Capture(".output.bf16", Pointer<uint16_t>(args, 4) + kToken * kHs,
                kHs * sizeof(uint16_t), stream);
    char metadata[256];
    const int n = std::snprintf(metadata, sizeof(metadata),
        "{\"layer\":%d,\"tokens\":%d,\"token\":%d,\"hs\":%d,"
        "\"slots\":%d,\"block\":%u,\"ok\":%s}\n",
        layer, kT, kToken, kHs, kSlots, block.x, ok ? "true" : "false");
    const bool saved = n > 0 && static_cast<size_t>(n) < sizeof(metadata) &&
        Save(Base() + ".meta.json", metadata, static_cast<size_t>(n));
    std::fprintf(stderr, "[moe-token-capture] layer=%d ok=%d\n", layer,
                 ok && saved);
  }
  return status;
}

namespace {
template <typename T>
bool Layout(cublasLtMatrixLayout_t layout, cublasLtMatrixLayoutAttribute_t key,
            T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatrixLayoutGetAttribute)>(
      "cublasLtMatrixLayoutGetAttribute");
  size_t size = 0;
  return get(layout, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
template <typename T>
bool Attribute(cublasLtMatmulDesc_t desc, cublasLtMatmulDescAttributes_t key,
               T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatmulDescGetAttribute)>(
      "cublasLtMatmulDescGetAttribute");
  size_t size = 0;
  return get(desc, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
bool Shape(cublasLtMatrixLayout_t desc, uint64_t rows, uint64_t cols,
           cudaDataType_t type) {
  uint64_t r = 0, c = 0;
  int64_t ld = 0;
  cudaDataType_t t{};
  cublasLtOrder_t order{};
  return Layout(desc, CUBLASLT_MATRIX_LAYOUT_ROWS, &r) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_COLS, &c) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_LD, &ld) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_TYPE, &t) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_ORDER, &order) &&
         r == rows && c == cols && ld == static_cast<int64_t>(rows) &&
         t == type && order == CUBLASLT_ORDER_COL;
}
}
extern "C" cublasStatus_t CUBLASWINAPI cublasLtMatmul(
    cublasLtHandle_t handle, cublasLtMatmulDesc_t desc, const void* alpha,
    const void* a, cublasLtMatrixLayout_t ad, const void* b,
    cublasLtMatrixLayout_t bd, const void* beta, const void* c,
    cublasLtMatrixLayout_t cd, void* d, cublasLtMatrixLayout_t dd,
    const cublasLtMatmulAlgo_t* algo, void* workspace, size_t workspace_bytes,
    cudaStream_t stream) {
  static const auto real = Resolve<decltype(&cublasLtMatmul)>("cublasLtMatmul");
  const auto status = real(handle, desc, alpha, a, ad, b, bd, beta, c, cd, d, dd,
                           algo, workspace, workspace_bytes, stream);
  if (!gu_pending.packed || b != gu_pending.packed) return status;
  const auto snap = gu_pending; gu_pending = {};
  const bool down = pending_down; pending_down = false;
  const int width = down ? 640 : 2560, outputs = down ? 2560 : 1280;
  const int sf_stride = down ? 5120 : 20480;
  const std::string kind = down ? ".dn" : ".gu";
  cublasLtPointerMode_t pm{}; cublasOperation_t ta{}, tb{};
  cublasLtMatmulMatrixScale_t sa{}, sb{};
  const void *wsf = nullptr, *asf = nullptr;
  const bool checked = status == CUBLAS_STATUS_SUCCESS &&
      Shape(ad, width, outputs, CUDA_R_4F_E2M1) &&
      Shape(bd, width, snap.rows, CUDA_R_4F_E2M1) &&
      Shape(dd, outputs, snap.rows, CUDA_R_16BF) &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_POINTER_MODE, &pm) &&
      pm == CUBLASLT_POINTER_MODE_HOST &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &ta) && ta == CUBLAS_OP_T &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &tb) && tb == CUBLAS_OP_N &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_A_SCALE_MODE, &sa) &&
      sa == CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3 &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_B_SCALE_MODE, &sb) &&
      sb == CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3 &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER, &wsf) &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER, &asf) &&
      *static_cast<const float*>(beta) == 0;
  const std::string tag = ".expert-" + std::to_string(snap.expert);
  const bool ok = checked &&
      Capture((tag + kind + "-packed.bin").c_str(),
          static_cast<const uint8_t*>(b) + size_t(snap.row) * width / 2, width / 2, stream) &&
      Capture((tag + kind + "-asf.bin").c_str(), asf,
          size_t((snap.rows + 127) / 128) * sf_stride, stream) &&
      Capture((tag + kind + "-weights.bin").c_str(), a, size_t(outputs) * width / 2, stream) &&
      Capture((tag + kind + "-wsf.bin").c_str(), wsf, size_t(outputs / 128) * sf_stride, stream) &&
      Capture((tag + kind + "-output.bf16").c_str(),
          static_cast<const uint16_t*>(d) + size_t(snap.row) * outputs, outputs * 2, stream);
  if (ok && !down) { inter_pending = snap; inter_input = d; }
  char meta[512];
  const int n = std::snprintf(meta, sizeof(meta),
      "{\"layer\":%d,\"expert\":%d,\"row\":%d,\"rows\":%d,"
      "\"scale_hex\":\"%a\",\"alpha_hex\":\"%a\",\"ok\":%s}\n",
      layer, snap.expert, snap.row, snap.rows, double(snap.scale),
      checked ? double(*static_cast<const float*>(alpha)) : 0., ok ? "true" : "false");
  if (n > 0 && size_t(n) < sizeof(meta)) Save(Base() + tag + kind + ".json", meta, n);
  std::fprintf(stderr, "[token-%s] layer=%d expert=%d ok=%d\n", down ? "dn" : "gu", layer, snap.expert, ok);
  return status;
}
