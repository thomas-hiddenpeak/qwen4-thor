from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/ple-lookup-reference-20260923';c=o/'observed-captures';prior=root/'.q4t-work/e2e/ple-projection-reference-v2-20260923';old=prior/'observed-captures';data=o/'reference'
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
def dec(b):return (np.asarray(b,dtype=np.uint16).astype(np.uint32)<<16).view(np.float32).astype(np.float64)
def rnd(v):
 b=np.asarray(v,dtype=np.float32).view(np.uint32);return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype(np.uint16)
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output']
assert (p/'build.log').stat().st_size==0
steps=json.loads((o/'capture-steps.json').read_text())['steps'];assert steps==7
data.mkdir(exist_ok=False)
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');cfg=json.loads((model/'config.json').read_text())['text_config'];assert cfg['ngram_size']==3 and cfg['heads_per_ngram']==8 and cfg['ple_embed_dim']==2560;eos=int(cfg['eos_token_id']);idx=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];parameters={}
for name in ['layer_multipliers','ngram_heads_vocab_sizes','ngram_heads_offsets','ngram_embedding.weight_scale']:
 key='model.language_model.layers.1.ple.ple_embedding.'+name
 with (model/idx[key]).open('rb') as f:
  n=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(n))[key];a,z=info['data_offsets'];f.seek(8+n+a);raw=f.read(z-a)
 dtype='<u2' if name.endswith('weight_scale') else '<i8';assert info['dtype']==('BF16' if name.endswith('weight_scale') else 'I64');values=np.frombuffer(raw,dtype=dtype);parameters[name]={'shape':info['shape'],'dtype':info['dtype'],'raw_sha256':hashlib.sha256(raw).hexdigest(),'values':values.tolist()};(data/(name+'.bin')).write_bytes(raw)
mult=parameters['layer_multipliers']['values'];vocab=parameters['ngram_heads_vocab_sizes']['values'];offset=parameters['ngram_heads_offsets']['values'];scale=float(dec(np.array(parameters['ngram_embedding.weight_scale']['values'],dtype=np.uint16))[0]);assert len(mult)==3 and len(vocab)==len(offset)==16 and all(v>0 for v in vocab) and offset[0]==0 and all(offset[i+1]==offset[i]+vocab[i] for i in range(15))
save(o/'checkpoint-parameters.json',{'eos_token_id':eos,'parameters':parameters,'scale':scale,'config_sha256':sha(model/'config.json')})
sidecar=model/'ple/qwen3.8-flash-next-ple-fp8.bin';st=sidecar.stat();logical_rows=offset[-1]+vocab[-1];alignment=int(cfg['make_ngram_vocab_size_divisible_by']);assert alignment==128;padded_rows=((logical_rows+alignment-1)//alignment)*alignment;assert st.st_size==padded_rows*160
save(o/'sidecar-identity.json',{'path':str(sidecar),'logical_rows':logical_rows,'padded_rows':padded_rows,'alignment_rows':alignment,'size':st.st_size,'device':st.st_dev,'inode':st.st_ino,'mtime_ns':st.st_mtime_ns,'path_evidence':'Accepted src/server/chat_server.cpp constructs model_dir + /ple/qwen3.8-flash-next-ple-fp8.bin; recorded server command supplies model_dir. No live observed-process FD captured.','server_command_sha256':sha(o/'observed/server-command.json')})
all_tokens=[];last_eos=-1;cache={};records=[];max_product=0;row_records=[];contexts=[];eos_count=0;fd=os.open(sidecar,os.O_RDONLY)
try:
 for step in range(steps):
  b=str(c/f'step-{step}');tokens=np.fromfile(b+'.tokens.i32',dtype='<i4');assert len(tokens)==(4096 if step==0 else 1);actual=Path(b+'.fp8').read_bytes();assert len(actual)==len(tokens)*2560;wanted=bytearray();rows=[]
  for token in tokens:
   token=int(token);assert 0<=token<int(cfg['vocab_size']);position=len(all_tokens);all_tokens.append(token);eff=[token]
   for back in [1,2]:
    source=position-back;eff.append(all_tokens[source] if source>=0 and source>last_eos else eos)
   contexts.append([eff[2],eff[1],eff[0]])
   products=[eff[j]*int(mult[j]) for j in range(3)];assert all(0<=x<(1<<63) for x in products);max_product=max(max_product,*products);row=[]
   for order in [2,3]:
    mixed=0
    for product in products[:order]:mixed^=product
    for h in range((order-2)*8,(order-1)*8):
     rid=mixed%vocab[h]+offset[h];assert offset[h]<=rid<offset[h]+vocab[h];row.append(rid)
     if rid not in cache:
      raw=os.pread(fd,160,rid*160);assert len(raw)==160;cache[rid]=raw
     wanted.extend(cache[rid])
   rows.append(row);row_records.append(row)
   if token==eos:last_eos=position;eos_count+=1
  expected=bytes(wanted);(data/f'step-{step}.expected.fp8').write_bytes(expected);ids=np.asarray(rows,dtype='<i8');ids.tofile(data/f'step-{step}.expected-row-ids.i64');bad=[i for i,(a,bv) in enumerate(zip(actual,expected)) if a!=bv];save(data/f'step-{step}.byte-comparison.json',{'bytes':len(actual),'mismatches':len(bad),'indices':bad});assert not bad
  fp8=np.frombuffer(actual,dtype='u1');e=(fp8>>3)&15;m=fp8&7;assert not np.any((e==15)&(m==7));values=np.where(e==0,m.astype(np.float64)/512,np.ldexp(1+m.astype(np.float64)/8,e.astype(np.int32)-7));values=np.where(fp8&128,-values,values);converted=rnd(values);assert converted.tobytes()==Path(b+'.converted.bf16').read_bytes();actual_scale=np.fromfile(b+'.scale.f32',dtype='<f4')[0];assert actual_scale==scale;scaled=rnd(dec(converted)*scale);assert scaled.tobytes()==Path(b+'.scaled.bf16').read_bytes()
  records.append({'step':step,'token_start':len(all_tokens)-len(tokens),'tokens':tokens.tolist() if step else None,'token_count':len(tokens),'rows':len(rows)*16,'bytes':len(actual),'row_content_mismatches':0,'conversion_mismatches':0,'scaled_mismatches':0,'actual_fp8_sha256':hashlib.sha256(actual).hexdigest(),'expected_fp8_sha256':hashlib.sha256(expected).hexdigest(),'exponent15_elements':int(np.count_nonzero(e==15)),'distinct_codes':len(np.unique(fp8))})
finally:os.close(fd)
end=sidecar.stat();assert (end.st_dev,end.st_ino,end.st_size,end.st_mtime_ns)==(st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns)
np.asarray(all_tokens,dtype='<i4').tofile(data/'all-tokens.i32');np.asarray(contexts,dtype='<i8').tofile(data/'effective-contexts.i64');np.asarray(row_records,dtype='<i8').tofile(data/'all-row-ids.i64')
save(o/'selected-row-hashes.json',{str(rid):hashlib.sha256(raw).hexdigest() for rid,raw in sorted(cache.items())})
hashes=json.loads((prior/'artifact-binding.json').read_text());bindings={}
for phase,step,rows in [('prefill',0,10),('decode',1,1)]:
 for before,after,size in [('embedding.fp8','fp8',rows*2560),('embedding.bf16','converted.bf16',rows*2560*2),('scale.after.bf16','scaled.bf16',rows*2560*2)]:
  f=old/f'{phase}.{before}';assert sha(f)==hashes[str(f.relative_to(prior))];assert f.read_bytes()==(c/f'step-{step}.{after}').read_bytes()[-size:];bindings[str(f.relative_to(root))]=sha(f)
save(o/'previous-binding.json',bindings)
r={'records':records,'tokens':len(all_tokens),'rows':len(row_records)*16,'bytes':sum(x['bytes'] for x in records),'distinct_rows':len(cache),'actual_eos_tokens':eos_count,'max_token_multiplier_product':max_product,'signed_overflow_observed':False,'limitation':'CPU internal row IDs not captured. Expected row contents from independent context/hash and checkpoint match actual FP8 bytes; this is behavioral lookup evidence, not internal row-ID uniqueness proof. Scope one4K request,one sequence,MTP off; not chunked prefill/long context/multisequence.'};save(o/'lookup-reference.json',r);print({k:v for k,v in r.items() if k not in ['records','limitation']})
