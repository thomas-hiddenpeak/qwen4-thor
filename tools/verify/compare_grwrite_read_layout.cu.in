#include <algorithm>
#include <array>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include "q4t/model/decoder_layer.h"
#include "q4t/model/decoder_workspace.h"
#include "q4t/model/model_head.h"
namespace baseline {
using namespace q4t::model;
constexpr size_t kGemmWs = 32u * 1024u * 1024u;
size_t AlignUp(size_t x) { return (x + 255u) & ~size_t(255u); }
// HELPER
// OLD_LAYOUT
}  // namespace baseline
void Require(bool ok, const char* what) {
  if (!ok) {
    std::fprintf(stderr, "FAILED: %s\n", what);
    std::exit(1);
  }
}
using Views = std::array<q4t::model::DecoderResourceView, 13>;
bool Valid(const Views& views, size_t capacity) {
  // Independent semantic oracle for the audited runner order, not derived
  // from the descriptor under test. This is a coarse workspace-only contract.
  constexpr const char* names[] = {
      "attention", "moe",       "moe_gemm", "hc_gemm", "ple",
      "mixed",     "block",     "normed",   "down",    "up",
      "combined",  "ple_trunk", "gate"};
  constexpr uint32_t required[] = {4,  32, 32, 18,  1,  54, 108,
                                   26, 18, 18, 120, 15, 126};
  for (size_t i = 0; i < views.size(); ++i) {
    const auto& a = views[i];
    if (std::strcmp(a.name, names[i]) || a.live_phases != required[i] ||
        a.offset % 256 || a.offset > capacity || a.bytes > capacity - a.offset)
      return false;
    for (size_t j = 0; j < i; ++j) {
      const auto& b = views[j];
      if (a.bytes && b.bytes && (a.live_phases & b.live_phases) &&
          a.offset < b.offset + b.bytes && b.offset < a.offset + a.bytes)
        return false;
    }
  }
  return true;
}
int main() {
  using namespace q4t::model;
  int cases = 0, rejected = 0;
  for (int t : {1, 3, 4, 5, 33, 257, 8192}) {
    for (int max_len : {8192, 208896, 262144}) {
      FullAttentionWeights weights;
      weights.max_len = max_len;
      for (bool full : {false, true})
        for (bool ple : {false, true}) {
          for (int lowrank : {160, 320, 640}) {
            const auto old = baseline::MakeDecoderWorkspaceLayout(
                t, full, ple, 4, 2560, 512, 640, 640, 10, &weights, lowrank);
            const auto now = MakeDecoderWorkspaceLayout(
                t, full, ple, 4, 2560, 512, 640, 640, 10, &weights, lowrank);
            // FIELD_COMPARISONS
            Require(now.hidden_bytes == size_t(t) * 2560 * 2 &&
                        now.hyper_bytes == size_t(t) * 2560 * 4 * 2,
                    "shape byte metadata");
            const auto views = DescribeDecoderWorkspace(now);
            Require(Valid(views, now.total_bytes), "resource contract");
            // Match every view to the exact offsets consumed by forward.
            const size_t offsets[] = {
                now.attention, now.moe,   now.moe_gemm, now.hc_gemm,
                now.ple,       now.mixed, now.block,    now.normed,
                now.hc_down,   now.hc_up, now.combined, now.ple_trunk,
                now.gate};
            const size_t sizes[] = {
                now.attention_bytes, now.moe_bytes,   baseline::kGemmWs,
                baseline::kGemmWs,   now.ple_bytes,   now.hidden_bytes,
                now.hidden_bytes,    now.hyper_bytes, now.hc_down_bytes,
                now.hc_up_bytes,     now.hyper_bytes, ple ? now.hyper_bytes : 0,
                now.gate_bytes};
            for (size_t i = 0; i < views.size(); ++i)
              Require(
                  views[i].offset == offsets[i] && views[i].bytes == sizes[i],
                  "view binding to real layout");
            for (bool known_full : {false, true}) {
              const auto* w = known_full ? &weights : nullptr;
              const auto expected = baseline::MakeDecoderWorkspaceLayout(
                  t, full, ple, 4, 2560, 512, 640, 640, 10, w, lowrank);
              Require(expected.total_bytes ==
                          DecoderLayerWorkspaceBytes(t, full, ple, 2560, 512,
                                                     640, 640, 10, w, lowrank),
                      "linked capacity unchanged");
            }
            // Deliberately invalid descriptions must be rejected.
            for (int mutation = 0; mutation < 5; ++mutation) {
              auto bad = views;
              if (mutation == 0)
                bad[12].offset = now.moe;                  // live gate collides
              if (mutation == 1) bad[12].live_phases = 0;  // missing lifetime
              if (mutation == 2) ++bad[12].offset;         // unaligned
              if (mutation == 3)
                bad[5].bytes = now.total_bytes + 1;  // out of bounds
              if (mutation == 4)
                bad[7].live_phases |= 32;  // normed retained into MoE
              Require(!Valid(bad, now.total_bytes),
                      "invalid contract rejected");
              ++rejected;
            }
            std::printf(
                "{\"tokens\":%d,\"max_len\":%d,\"full\":%d,\"ple\":%d,"
                "\"lowrank\":%d,\"capacity\":%zu,\"views\":[",
                t, max_len, full, ple, lowrank, now.total_bytes);
            for (size_t i = 0; i < views.size(); ++i) {
              const auto& v = views[i];
              std::printf(
                  "%s{\"name\":\"%s\",\"offset\":%zu,\"bytes\":%zu,"
                  "\"live_phases\":%u}",
                  i ? "," : "", v.name, v.offset, v.bytes, v.live_phases);
            }
            std::puts("]}");
            ++cases;
          }
        }
    }
  }
  std::printf(
      "PASS: %d layouts, %d linked capacities, %d bad contracts rejected\n",
      cases, cases * 2, rejected);
}
