#include <cuda_bf16.h>
#include <cuda_fp8.h>
#include <cuda_runtime.h>
#include <cstdio>
#include <cstdint>
#include <vector>
#include <string>
#include "q4t/quant/format.h"
#define CU(x) do { if ((x)!=cudaSuccess) return 2; } while(0)
constexpr int kCount = 480 * 40;
struct Result { float ratio; uint8_t legacy, native; float values[16]; };
__global__ void Replay(const uint16_t* x, const float* scales, Result* out) {
  int i=blockIdx.x*blockDim.x+threadIdx.x;
  if(i>=kCount) return;
  float maximum=0;
  const int row=i/40, group=i%40;
  Result result{};
  for(int j=0;j<16;++j) {
    float g=__bfloat162float(*reinterpret_cast<const __nv_bfloat16*>(x+row*1280+group*16+j));
    float u=__bfloat162float(*reinterpret_cast<const __nv_bfloat16*>(x+row*1280+640+group*16+j));
    float sigmoid=1.0f/(1.0f+__expf(-g));
    result.values[j]=g*sigmoid*u;
    maximum=fmaxf(maximum,fabsf(result.values[j]));
  }
  float block=maximum>0?maximum/6.0f:1.0f;
  result.ratio=block/scales[row];
  result.legacy=q4t::quant::FloatToE4m3(result.ratio);
  result.native=__nv_cvt_float_to_fp8(result.ratio,__NV_SATFINITE,__NV_E4M3);
  out[i]=result;
}
bool Read(const std::string& p,void* dst,size_t n) {
 FILE* f=std::fopen(p.c_str(),"rb");if(!f)return false;
 bool ok=std::fread(dst,1,n,f)==n&&std::fgetc(f)==EOF;
 return std::fclose(f)==0&&ok;
}
int main(int argc,char** argv) {
 if(argc!=2)return 2;std::string p=argv[1];
 std::vector<uint16_t>x(480*1280);std::vector<float>s(480);std::vector<uint8_t>a(kCount);std::vector<Result>r(kCount);
 if(!Read(p+"/inter-inputs.bf16",x.data(),x.size()*2)||!Read(p+"/inter-scales.f32",s.data(),s.size()*4)||!Read(p+"/inter-actual.sf",a.data(),a.size()))return 2;
 uint16_t* dx;float* ds;Result* dr;
 CU(cudaMalloc(&dx,x.size()*2));CU(cudaMalloc(&ds,s.size()*4));CU(cudaMalloc(&dr,r.size()*sizeof(Result)));
 CU(cudaMemcpy(dx,x.data(),x.size()*2,cudaMemcpyHostToDevice));CU(cudaMemcpy(ds,s.data(),s.size()*4,cudaMemcpyHostToDevice));
 Replay<<<(kCount+255)/256,256>>>(dx,ds,dr);CU(cudaGetLastError());CU(cudaMemcpy(r.data(),dr,r.size()*sizeof(Result),cudaMemcpyDeviceToHost));
 FILE* values=std::fopen((p+"/inter-values.f32").c_str(),"wb");if(!values)return 2;
 for(const auto& v:r) if(std::fwrite(v.values,sizeof(float),16,values)!=16)return 2;
 if(std::fclose(values)!=0)return 2;
 int bad=0;for(int i=0;i<kCount;++i){bad+=a[i]!=r[i].legacy;std::printf("%d %a %u %u %u\n",i,double(r[i].ratio),a[i],r[i].legacy,r[i].native);}
 CU(cudaFree(dx));CU(cudaFree(ds));CU(cudaFree(dr));return bad?1:0;
}
