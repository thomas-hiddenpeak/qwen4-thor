// Bounded read-only snapshots during real HTTP. Never a timing reference.
#include <cuda_runtime_api.h>
#include <cublasLt.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <mutex>
#include <algorithm>
namespace {
std::atomic<cudaKernel_t> down_kernel{nullptr}, gather_kernel{nullptr};
std::atomic<int> captures{0};
thread_local int expert = -1;
thread_local int layer = -1;
std::mutex layer_mutex;
std::vector<const void*> layer_scales;
std::atomic<int> layer_captures[48]{};
struct Pending { const void* activation = nullptr; int index = 0; int rows = 0; };
thread_local Pending pending;
template <typename T> T Resolve(const char* name) {
  auto fn = reinterpret_cast<T>(dlsym(RTLD_NEXT, name));
  if (!fn) std::_Exit(127);
  return fn;
}
bool Save(const std::string& path, const void* data, size_t size) {
  FILE* f = std::fopen(path.c_str(), "wb");
  if (!f) return false;
  const bool ok = std::fwrite(data, 1, size, f) == size;
  return std::fclose(f) == 0 && ok;
}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* kernel, const void* fn) {
  using Get = cudaError_t (*)(cudaKernel_t*, const void*);
  static const auto real = Resolve<Get>("__cudaGetKernel");
  const auto status = real(kernel, fn);
  if (status == cudaSuccess) {
    const char* name = nullptr;
    static const auto get_name = Resolve<decltype(&cudaFuncGetName)>(
        "cudaFuncGetName");
    if (get_name(&name, fn) == cudaSuccess && name) {
      if (std::strstr(name, "SwiGLUQuantKernel")) down_kernel = *kernel;
      if (std::strstr(name, "GatherQuantKernel")) gather_kernel = *kernel;
    }
  }
  return status;
}
extern "C" cudaError_t __cudaLaunchKernel(
    cudaKernel_t kernel, dim3 grid, dim3 block, void** args,
    size_t shared, cudaStream_t stream) {
  using Launch = cudaError_t (*)(cudaKernel_t, dim3, dim3, void**, size_t,
                                cudaStream_t);
  static const auto real = Resolve<Launch>("__cudaLaunchKernel");
  const char* directory = std::getenv("Q4T_E4M3_CAPTURE_DIR");
  if (directory && kernel == gather_kernel.load()) {
    expert = *static_cast<int*>(args[3]);
    const void* scale_pointer = *static_cast<void**>(args[8]);
    std::lock_guard<std::mutex> lock(layer_mutex);
    auto it = std::find(layer_scales.begin(), layer_scales.end(), scale_pointer);
    if (it == layer_scales.end()) {
      layer = static_cast<int>(layer_scales.size());
      layer_scales.push_back(scale_pointer);
    } else {
      layer = static_cast<int>(it - layer_scales.begin());
    }
  }
  const auto status = real(kernel, grid, block, args, shared, stream);
  if (!directory || kernel != down_kernel.load() ||
      status != cudaSuccess || layer < 0 || layer >= 48) return status;
  if (layer_captures[layer].fetch_add(1) >= 2) return status;
  const int index = captures.fetch_add(1);
  if (index >= 96) return status;
  const int rows = *static_cast<int*>(args[3]);
  const int width = *static_cast<int*>(args[4]);
  const int tiles = *static_cast<int*>(args[5]);
  const float scale = *static_cast<float*>(args[6]);
  if (rows <= 0 || rows > 8192 || width != 640 || tiles != 10 ||
      expert < 0 || expert >= 512) {
    std::fprintf(stderr, "[e4m3-capture] invalid shape/expert\n");
    return status;
  }
  const size_t input_bytes = static_cast<size_t>(rows) * 2 * width * 2;
  const size_t sf_bytes = static_cast<size_t>((rows + 127) / 128) * tiles * 512;
  std::vector<unsigned char> input(input_bytes), sf(sf_bytes);
  static const auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static const auto sync = Resolve<decltype(&cudaStreamSynchronize)>(
      "cudaStreamSynchronize");
  const auto c1 = copy(input.data(), *static_cast<void**>(args[0]), input_bytes,
                       cudaMemcpyDeviceToHost, stream);
  const auto c2 = copy(sf.data(), *static_cast<void**>(args[2]), sf_bytes,
                       cudaMemcpyDeviceToHost, stream);
  const auto done = sync(stream);
  const std::string base = std::string(directory) + "/capture-" +
                           std::to_string(index);
  const bool ok = c1 == cudaSuccess && c2 == cudaSuccess && done == cudaSuccess &&
                 Save(base + ".input.bin", input.data(), input_bytes) &&
                 Save(base + ".sf.bin", sf.data(), sf_bytes);
  char metadata[512];
  const int size = std::snprintf(metadata, sizeof(metadata),
      "{\"index\":%d,\"layer\":%d,\"rows\":%d,\"width\":%d,\"tiles\":%d,"
      "\"expert\":%d,\"input_scale\":%.9g,\"scale_hex\":\"%a\","
      "\"input_bytes\":%zu,\"sf_bytes\":%zu,\"ok\":%s}\n",
      index, layer, rows, width, tiles, expert, static_cast<double>(scale),
      static_cast<double>(scale), input_bytes, sf_bytes, ok ? "true" : "false");
  const bool saved = size > 0 && static_cast<size_t>(size) < sizeof(metadata) &&
                    Save(base + ".json", metadata, static_cast<size_t>(size));
  if (ok && saved) pending = {*static_cast<void**>(args[1]), index, rows};
  std::fprintf(stderr, "[e4m3-capture] index=%d rows=%d expert=%d ok=%d\n",
               index, rows, expert, ok && saved);
  return status;
}
namespace {
template <typename T>
bool Layout(cublasLtMatrixLayout_t layout, cublasLtMatrixLayoutAttribute_t key,
            T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatrixLayoutGetAttribute)>(
      "cublasLtMatrixLayoutGetAttribute");
  size_t size = 0;
  return get(layout, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
template <typename T>
bool Attribute(cublasLtMatmulDesc_t desc, cublasLtMatmulDescAttributes_t key,
               T* value) {
  static const auto get = Resolve<decltype(&cublasLtMatmulDescGetAttribute)>(
      "cublasLtMatmulDescGetAttribute");
  size_t size = 0;
  return get(desc, key, value, sizeof(T), &size) == CUBLAS_STATUS_SUCCESS &&
         size == sizeof(T);
}
bool Shape(cublasLtMatrixLayout_t desc, uint64_t rows, uint64_t cols,
           cudaDataType_t type) {
  uint64_t r = 0, c = 0;
  int64_t ld = 0;
  cudaDataType_t t{};
  cublasLtOrder_t order{};
  return Layout(desc, CUBLASLT_MATRIX_LAYOUT_ROWS, &r) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_COLS, &c) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_LD, &ld) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_TYPE, &t) &&
         Layout(desc, CUBLASLT_MATRIX_LAYOUT_ORDER, &order) &&
         r == rows && c == cols && ld == static_cast<int64_t>(rows) &&
         t == type && order == CUBLASLT_ORDER_COL;
}
}
extern "C" cublasStatus_t CUBLASWINAPI cublasLtMatmul(
    cublasLtHandle_t handle, cublasLtMatmulDesc_t desc, const void* alpha,
    const void* a, cublasLtMatrixLayout_t ad, const void* b,
    cublasLtMatrixLayout_t bd, const void* beta, const void* c,
    cublasLtMatrixLayout_t cd, void* d, cublasLtMatrixLayout_t dd,
    const cublasLtMatmulAlgo_t* algo, void* workspace, size_t workspace_bytes,
    cudaStream_t stream) {
  static const auto real = Resolve<decltype(&cublasLtMatmul)>("cublasLtMatmul");
  const auto status = real(handle, desc, alpha, a, ad, b, bd, beta, c, cd, d, dd,
                           algo, workspace, workspace_bytes, stream);
  if (!pending.activation || b != pending.activation) return status;
  const Pending snapshot = pending;
  pending.activation = nullptr;
  cublasLtPointerMode_t pointer_mode{};
  cublasOperation_t ta{}, tb{};
  cublasLtMatmulMatrixScale_t sa{}, sb{};
  const void *wsf = nullptr, *asf = nullptr;
  const bool shape_ok = status == CUBLAS_STATUS_SUCCESS &&
      Shape(ad, 640, 2560, CUDA_R_4F_E2M1) &&
      Shape(bd, 640, snapshot.rows, CUDA_R_4F_E2M1) &&
      Shape(dd, 2560, snapshot.rows, CUDA_R_16BF) &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_POINTER_MODE, &pointer_mode) &&
      pointer_mode == CUBLASLT_POINTER_MODE_HOST &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &ta) && ta == CUBLAS_OP_T &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &tb) && tb == CUBLAS_OP_N &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_A_SCALE_MODE, &sa) &&
      sa == CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3 &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_B_SCALE_MODE, &sb) &&
      sb == CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3 &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER, &wsf) &&
      Attribute(desc, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER, &asf) &&
      *static_cast<const float*>(beta) == 0.0f;
  if (!shape_ok) {
    std::fprintf(stderr, "[e4m3-down] invalid descriptor\n");
    return status;
  }
  const char* directory = std::getenv("Q4T_E4M3_CAPTURE_DIR");
  if (!directory) return status;
  const std::string base = std::string(directory) + "/capture-" +
                           std::to_string(snapshot.index);
  static const auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static const auto sync = Resolve<decltype(&cudaStreamSynchronize)>(
      "cudaStreamSynchronize");
  auto capture = [&](const char* suffix, const void* source, size_t bytes) {
    std::vector<unsigned char> data(bytes);
    return copy(data.data(), source, bytes, cudaMemcpyDeviceToHost, stream) ==
               cudaSuccess && sync(stream) == cudaSuccess &&
           Save(base + suffix, data.data(), bytes);
  };
  const bool ok = capture(".packed.bin", b, snapshot.rows * size_t{320}) &&
      capture(".weights.bin", a, 2560 * size_t{320}) &&
      capture(".weights-sf.bin", wsf, 20 * size_t{5120}) &&
      capture(".gemm-sf.bin", asf, ((snapshot.rows + 127) / 128) * size_t{5120}) &&
      capture(".down.bin", d, snapshot.rows * size_t{2560} * 2);
  char metadata[256];
  const int size = std::snprintf(metadata, sizeof(metadata),
      "{\"index\":%d,\"rows\":%d,\"alpha_hex\":\"%a\","
      "\"beta\":0,\"descriptor_checked\":true,\"ok\":%s}\n",
      snapshot.index, snapshot.rows,
      static_cast<double>(*static_cast<const float*>(alpha)),
      ok ? "true" : "false");
  const bool saved = size > 0 && static_cast<size_t>(size) < sizeof(metadata) &&
                    Save(base + ".down.json", metadata, static_cast<size_t>(size));
  std::fprintf(stderr, "[e4m3-down] index=%d ok=%d\n", snapshot.index,
               ok && saved);
  return status;
}
