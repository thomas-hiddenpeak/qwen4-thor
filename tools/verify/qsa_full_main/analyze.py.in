from pathlib import Path
import json,hashlib,struct,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-full-main-20260924';c=o/'observed-captures';q=root/'.q4t-work/e2e/qsa-full-selection-20260924';h=root/'.q4t-work/e2e/hc-full-boundaries-20260923';old=root/'.q4t-work/e2e/qsa-main-projections-20260923';model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream')
def sha(f):
 x=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):x.update(b)
 return x.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'];assert sha(root/'build/q4t')==json.loads((o/'plan.json').read_text())['binary_sha256']
for label,source in [('hc',h),('qsa',q)]:
 binding=json.loads((o/(label+'-binding.json')).read_text());assert sha(source/'artifact-binding.json')==binding['manifest_sha256']
 for r in binding['records']:assert sha(source/r['file'])==r['sha256']
metas=[json.loads(f.read_text()) for f in c.glob('*.json')];assert len(metas)==120 and all(m['ok'] for m in metas)
index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];config=json.loads((model/'config.json').read_text())['text_config'];om=json.loads((old/'artifact-binding.json').read_text());weights=[];previous=[];maps=[]
def tensor(key,shape):
 f=model/index[key]
 with f.open('rb') as stream:
  size=struct.unpack('<Q',stream.read(8))[0];info=json.loads(stream.read(size))[key];assert info['dtype']=='BF16' and info['shape']==shape;a,b=info['data_offsets'];offset=8+size+a;stream.seek(offset);raw=stream.read(b-a)
 assert len(raw)==int(np.prod(shape))*2;st=f.stat();weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns});return raw
def compare_old(layer,suffix,raw,relation):
 f=old/'observed-captures'/f'layer-{layer}.prefill.{suffix}';name=str(f.relative_to(old));assert sha(f)==om[name];assert raw==f.read_bytes(),name;previous.append({'file':name,'sha256':om[name],'relation':relation})
for l in range(3,48,4):
 b=f'layer-{l}.prefill';qb=q/'observed-captures';hb=h/'observed-captures'
 for stage,n,k,key in [('qg',12288,2560,'q_proj'),('k',512,2560,'k_proj'),('v',512,2560,'v_proj'),('out',2560,6144,'o_proj')]:
  weight=c/(b+'.main-'+stage+'.weights.bf16');raw=tensor(f'model.language_model.layers.{l}.self_attn.{key}.weight',[n,k]);assert raw==weight.read_bytes();compare_old(l,'main-'+stage+'.weights.bf16',raw,'full weight')
  output=c/(b+'.main-'+stage+'.output.bf16') if stage in ['qg','k'] else qb/(b+'.write-v.bf16') if stage=='v' else hb/f'hc-{l}.prefill.fused.block.bf16';inp=qb/(b+'.attention-output.bf16') if stage=='out' else hb/f'hc-{l}.prefill.mix.attn.output.bf16';assert output.stat().st_size==4096*n*2 and inp.stat().st_size==4096*k*2
  compare_old(l,'main-'+stage+'.output.bf16',output.read_bytes()[-n*2:],'last row');compare_old(l,'main-'+stage+'.input.bf16',inp.read_bytes()[-k*2:],'last row')
  algo=c/(b+'.main-'+stage+'.algo.bin');assert algo.stat().st_size==64
  maps.append({'layer':l,'stage':stage,'m':4096,'n':n,'k':k,'weight':str(weight.relative_to(root)),'weight_sha256':sha(weight),'input':str(inp.relative_to(root)),'input_sha256':sha(inp),'output':str(output.relative_to(root)),'output_sha256':sha(output),'algorithm':str(algo.relative_to(root)),'algorithm_sha256':sha(algo),'workspace_bytes':33554432,'alpha':1.0,'beta':0.0})
 qg=np.fromfile(c/(b+'.main-qg.output.bf16'),dtype='<u2').reshape(4096,24,2,256);gate=np.fromfile(qb/(b+'.gate.bf16'),dtype='<u2').reshape(4096,24,256);assert np.array_equal(qg[:,:,1,:],gate)
 eps=(c/(b+'.epsilon.f32')).read_bytes();assert eps==np.float32(config['rms_norm_eps']).tobytes();compare_old(l,'transform-norm.epsilon.f32',eps,'scalar')
 for side,heads in [('q',24),('k',2)]:
  weight=c/(b+f'.{side}-norm.weights.bf16');raw=tensor(f'model.language_model.layers.{l}.self_attn.{side}_norm.weight',[256]);assert raw==weight.read_bytes();compare_old(l,f'transform-norm.{side}-weight.bf16',raw,'full weight')
  norm=np.fromfile(c/(b+f'.{side}-norm.output.bf16'),dtype='<u2').reshape(4096,heads,256);rope=np.fromfile(qb/(b+('.q.bf16' if side=='q' else '.write-k.bf16')),dtype='<u2').reshape(4096,heads,256)
  assert np.all((norm&0x7f80)!=0x7f80) and np.array_equal(norm[:,:,64:],rope[:,:,64:]);compare_old(l,f'transform-norm.{side}.bf16',norm[-1].tobytes(),'last row');compare_old(l,f'transform-{side}rope.after.bf16',rope[-1].tobytes(),'last row')
  rb=c/(b+f'.rope-{side}');theta=Path(str(rb)+'.theta.f32').read_bytes();assert theta==np.float32(config['rope_parameters']['rope_theta']).tobytes();compare_old(l,f'transform-{side}rope.theta.f32',theta,'scalar')
  pos=np.fromfile(str(rb)+'.positions.i32',dtype='<i4');ids=np.fromfile(str(rb)+'.seqids.i32',dtype='<i4');assert np.array_equal(pos,np.arange(4096)) and ids.size==4096 and np.all(ids==0);last=[int(pos[-1])]
  for row in range(3):
   rp=np.fromfile(str(rb)+f'.rope-row-{row}.i32',dtype='<i4');assert np.array_equal(rp,pos);last.append(int(rp[-1]))
  compare_old(l,f'transform-{side}rope.positions.i32',np.array(last,dtype='<i4').tobytes(),'last position')
 print({'layer':l,'projection_boundaries':4,'gate_copy_equal':True,'rope_unchanged_suffix_equal':True},flush=True)
save('checkpoint-binding.json',{'config_sha256':sha(model/'config.json'),'index_sha256':sha(model/'model.safetensors.index.json'),'weights':weights});save('old-binding.json',{'manifest_sha256':sha(old/'artifact-binding.json'),'records':previous});save('projection-map.json',maps)
summary={'layers':12,'tokens':4096,'metadata_records':120,'source_files_bound':96,'projection_calls':48,'projection_output_elements':12*4096*15872,'qk_norm_elements':12*4096*26*256,'gate_copy_elements':12*4096*6144,'rope_unchanged_suffix_elements':12*4096*26*192,'checkpoint_tensors':len(weights),'checkpoint_bytes':sum(w['bytes'] for w in weights),'old_files_equal':len(previous),'full_source_consumer_bindings_passed':True,'projection_norm_rope_arithmetic_verified':False,'runtime_changed':False,'whole_model_correctness_proven':False,'capture_bytes':sum(f.stat().st_size for f in c.iterdir()),'free_after':shutil.disk_usage(o).free};assert summary['capture_bytes']<3400000000
save('summary.json',summary);shutil.copy2(p/'analyze.py',o/'analyze.py');shutil.copy2(p/'run.log',o/'capture-driver.log');print(summary,flush=True)
