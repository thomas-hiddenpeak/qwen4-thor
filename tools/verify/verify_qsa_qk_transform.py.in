from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,shutil,subprocess,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-qk-transform-20260923';c=o/'observed-captures';old=root/'.q4t-work/e2e/qsa-projection-reference-20260923/observed-captures';data=o/'data'
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
def read(f,dt='<u2'):return np.fromfile(f,dtype=dt)
def dec(v):return (np.asarray(v,dtype=np.uint16).astype(np.uint32)<<16).view(np.float32)
def rnd(v):
 b=np.asarray(v,dtype=np.float32).view(np.uint32);return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype(np.uint16)
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output']
assert all((p/f).stat().st_size==0 for f in ['build.log','cpu-build.log','nonlinear-build.log'])
data.mkdir(exist_ok=False);bind={}
for f in old.iterdir():
 if f.suffix not in ['.bf16','.i32','.f32','.json','.bin']:continue
 assert f.read_bytes()==(c/f.name).read_bytes(),f.name;bind[f.name]=sha(f)
save(o/'previous-binding.json',{'files':len(bind),'hashes':bind,'all_equal':True})
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');idx=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];records=[]
for l in range(3,48,4):
 for phase in ['prefill','decode']:
  base=str(c/f'layer-{l}.{phase}');normbase=base+'.transform-norm';qg=read(normbase+'.qg.bf16').reshape(24,2,256)
  assert qg[:,1,:].tobytes()==Path(normbase+'.gate.bf16').read_bytes()==Path(base+'.gate.bf16').read_bytes()
  eps=read(normbase+'.epsilon.f32','<f4')[0];assert eps==np.float32(1e-6)
  for side,heads in [('q',24),('k',2)]:
   b=str(data/f'layer-{l}.{phase}.{side}');rb=base+f'.transform-{side}rope';weight=read(normbase+f'.{side}-weight.bf16');x=dec(qg[:,0,:] if side=='q' else read(normbase+'.k-before.bf16').reshape(2,256));norm=read(normbase+f'.{side}.bf16').reshape(heads,256);rot=read(rb+'.after.bf16').reshape(heads,256)
   assert norm.tobytes()==Path(rb+'.before.bf16').read_bytes()
   if side=='q':assert rot.tobytes()==Path(base+'.q.bf16').read_bytes()
   else:assert rot.tobytes()==Path(base+'.write-k.bf16').read_bytes()[-1024:]
   name=f'model.language_model.layers.{l}.self_attn.{side}_norm.weight'
   with (model/idx[name]).open('rb') as f:
    size=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(size))[name];assert info['dtype']=='BF16' and info['shape']==[256];a,z=info['data_offsets'];f.seek(8+size+a);assert f.read(z-a)==weight.tobytes()
   theta=read(rb+'.theta.f32','<f4')[0];positions=read(rb+'.positions.i32','<i4');assert theta==1e7 and positions[0]==(4095 if phase=='prefill' else 4096)
   for row in range(3):assert positions[row+1]==read(base+f'.rope-{row}.i32','<i4')[positions[0]]
   values=(x*x).reshape(heads,8,32)
   for off in [16,8,4,2,1]:values=values+values[:,:,np.arange(32)^off]
   sums=np.zeros(heads,dtype=np.float32)
   for w in range(8):sums+=values[:,w,0]
   variance=sums/np.float32(256)+eps;x.tofile(b+'.input.f32');variance.tofile(b+'.variance.f32');np.asarray([theta,eps],dtype='<f4').tofile(b+'.params.f32');np.broadcast_to(positions[1:][(np.arange(64)%32)%3],(heads,64)).astype('<i4').tofile(b+'.positions.i32');weight.tofile(b+'.weight.bf16');norm.tofile(b+'.norm.bf16');rot.tofile(b+'.rope.bf16')
   xd=x.astype(np.float64);nd=xd/np.sqrt(np.mean(xd*xd,axis=1,keepdims=True)+float(eps))*(1+dec(weight).astype(np.float64));normbits=rnd(nd);normbad=np.flatnonzero(normbits.ravel()!=norm.ravel());n=dec(norm).astype(np.float64);rd=n.copy();ang=positions[1:][np.arange(32)%3]*float(theta)**(-2*np.arange(32)/64);co=np.cos(ang);si=np.sin(ang);rd[:,:32]=n[:,:32]*co-n[:,32:64]*si;rd[:,32:64]=n[:,:32]*si+n[:,32:64]*co;rotbits=rnd(rd);rotbad=np.flatnonzero(rotbits.ravel()!=rot.ravel());np.savez(b+'.fp64.npz',norm=nd,norm_bits=normbits,rope=rd,rope_bits=rotbits)
   records.append({'layer':l,'phase':phase,'side':side,'elements':heads*256,'norm_fp64_mismatches':len(normbad),'norm_indices':normbad.tolist(),'rope_fp64_mismatches':len(rotbad),'rope_indices':rotbad.tolist(),'norm_weight_sha256':hashlib.sha256(weight.tobytes()).hexdigest()})
save(o/'fp64-reference.json',records)
save(o/'declared-variants.json',{'0':'Norm with CPU rsqrt','1':'Norm with device rsqrt','2':'Rope CPU math:first product fused','3':'Rope CPU math:second product fused','4':'Rope device math:first product fused','5':'Rope device math:second product fused','6':'Rope CPU math:current*cos fused','7':'Rope device math:current*cos fused','scope':'Rope reference uses actual normalized input; norm independently reconstructed. Compiler contraction must be checked from SASS.'})
exits={}
for name in ['nonlinear','cpu']:
 with (o/(name+'.stdout')).open('w') as out,(o/(name+'.stderr')).open('w') as err:exits[name]=subprocess.run([str(p/name),str(data)],stdout=out,stderr=err).returncode
 save(o/'reference-exit.json',exits);assert exits[name]==0
r=json.loads((o/'cpu.stdout').read_text());assert len(r['records'])==384
for x in r['records']:
 b=str(data/f"layer-{x['layer']}.{x['phase']}.{x['side']}");bits=read(b+f".variant-{x['variant']}.bf16");expected=read(b+('.norm.bf16' if x['variant']<2 else '.rope.bf16'));bad=np.flatnonzero(bits!=expected);assert len(bad)==x['mismatches'];x['indices']=bad.tolist()
save(o/'transform-reference.json',r);print('old_files',len(bind),'norm_fp64',sum(x['norm_fp64_mismatches'] for x in records),'rope_fp64',sum(x['rope_fp64_mismatches'] for x in records),'variants',r['totals'])
