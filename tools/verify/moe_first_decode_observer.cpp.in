// Read-only first decode-step MoE snapshots after a 4096-token prefill.
#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <array>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> router{nullptr}, prep_gu{nullptr}, prep_dn{nullptr},
    combine{nullptr}, shared_swiglu{nullptr}, merge{nullptr};
std::atomic<int> prefill_layers{0}, decode_layers{0};
thread_local int layer=-1;
thread_local std::array<int32_t,10> ids{};
struct alignas(16) DeviceBatch {
 const void* weights[12]; const void* activations[12]; void* outputs[12];
 const void* weight_scales[12]; const void* activation_scales[12];
 const float* alpha_ptrs[12]; const float* beta_ptrs[12];
 float alpha[12]; float beta[12]; int dim_k[12]; int dim_n[12]; int dim_one[12];
};
struct StageWeights { const uint8_t* packed; const uint8_t* scales;
 const float* global_scale; const float* input_scale;
 size_t packed_stride; size_t scale_stride; };
template <typename T> T Resolve(const char* name) {
  auto fn = reinterpret_cast<T>(dlsym(RTLD_NEXT, name));
  if (!fn) std::_Exit(127);
  return fn;
}
std::string Base() {
  const char* dir = std::getenv("Q4T_TOKEN_CAPTURE_DIR");
  return std::string(dir ? dir : "") + "/layer-" + std::to_string(layer);
}
bool Save(const std::string& path, const void* data, size_t bytes) {
  FILE* f = std::fopen(path.c_str(), "wb");
  if (!f) return false;
  const bool ok = std::fwrite(data, 1, bytes, f) == bytes;
  return std::fclose(f) == 0 && ok;
}
bool Read(void* dst, const void* src, size_t bytes, cudaStream_t stream) {
  static const auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static const auto sync = Resolve<decltype(&cudaStreamSynchronize)>(
      "cudaStreamSynchronize");
  return copy(dst, src, bytes, cudaMemcpyDeviceToHost, stream) == cudaSuccess &&
         sync(stream) == cudaSuccess;
}
bool Capture(const char* suffix, const void* src, size_t bytes,
             cudaStream_t stream) {
  std::vector<unsigned char> data(bytes);
  return Read(data.data(), src, bytes, stream) &&
         Save(Base() + suffix, data.data(), bytes);
}
template <typename T> T* Pointer(void** args, int index) {
  return *static_cast<T**>(args[index]);
}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* kernel,const void* fn) {
 using Get=cudaError_t(*)(cudaKernel_t*,const void*);
 static const auto real=Resolve<Get>("__cudaGetKernel");auto result=real(kernel,fn);
 if(result==cudaSuccess){const char* name=nullptr;
  static const auto names=Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");
  if(names(&name,fn)==cudaSuccess&&name){
   if(std::strstr(name,"RouterTopkKernel")&&std::strstr(name,"5model"))router=*kernel;
   if(std::strstr(name,"PrepareMoEDecodeKernelILb0"))prep_gu=*kernel;
   if(std::strstr(name,"PrepareMoEDecodeKernelILb1"))prep_dn=*kernel;
   if(std::strstr(name,"CombineMoEDecodeKernel"))combine=*kernel;
   if(std::strstr(name,"SwiGLUKernel")&&std::strstr(name,"5model"))shared_swiglu=*kernel;
   if(std::strstr(name,"MoECombineKernel")&&std::strstr(name,"5model"))merge=*kernel;
  }
 }return result;
}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t kernel,dim3 grid,
 dim3 block,void** args,size_t shared,cudaStream_t stream) {
 using Launch=cudaError_t(*)(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t);
 static const auto real=Resolve<Launch>("__cudaLaunchKernel");
 bool enabled=std::getenv("Q4T_TOKEN_CAPTURE_DIR")!=nullptr;
 if(enabled&&layer>=0&&layer<48&&kernel==combine){
  bool ok=Capture(".experts.bf16",Pointer<uint16_t>(args,0),10*2560*2,stream)&&
      Capture(".weights.f32",Pointer<float>(args,1),40,stream)&&
      Capture(".before.f32",Pointer<float>(args,2),2560*4,stream);
  for(int slot=0;slot<10&&ok;++slot){
   std::string tag=".expert-"+std::to_string(ids[slot]);
   ok=Capture((tag+".dn-output.bf16").c_str(),Pointer<uint16_t>(args,0)+slot*2560,5120,stream);
  }
  std::fprintf(stderr,"[decode-down-output] layer=%d ok=%d\n",layer,ok);
 }
 auto result=real(kernel,grid,block,args,shared,stream);
 if(!enabled||result!=cudaSuccess)return result;
 if(kernel==router){
  const int t=*static_cast<int*>(args[3]);
  if(t==4096){++prefill_layers;layer=-1;}
  if(t==1&&prefill_layers==48){
   layer=decode_layers.fetch_add(1);
   if(layer<48){
    bool ok=Read(ids.data(),Pointer<int32_t>(args,1),40,stream)&&
     Save(Base()+".ids.i32",ids.data(),40)&&
     Capture(".logits.bf16",Pointer<uint16_t>(args,0),1024,stream)&&
     Capture(".router-weights.f32",Pointer<float>(args,2),40,stream);
    std::fprintf(stderr,"[decode-router] layer=%d ok=%d\n",layer,ok);
   }
  }
 }
 if(layer<0||layer>=48)return result;
 if(kernel==prep_gu||kernel==prep_dn){
  bool down=kernel==prep_dn;DeviceBatch batch{};
  auto stage=*static_cast<StageWeights*>(args[2]);
  bool ok=Read(&batch,Pointer<DeviceBatch>(args,3),sizeof(batch),stream);
  int k=down?640:2560,n=down?2560:1280;
  for(int slot=0;slot<10&&ok;++slot){
   int e=ids[slot];float scale=0;
   ok=e>=0&&e<512&&batch.dim_k[slot]==k&&batch.dim_n[slot]==n&&batch.dim_one[slot]==1&&batch.beta[slot]==0&&
    batch.weights[slot]==stage.packed+e*stage.packed_stride&&batch.weight_scales[slot]==stage.scales+e*stage.scale_stride&&
    Read(&scale,stage.input_scale+e,4,stream);
   std::string tag=".expert-"+std::to_string(e),kind=down?".dn":".gu";
   ok=ok&&Capture((tag+kind+"-packed.bin").c_str(),batch.activations[slot],k/2,stream)&&
    Capture((tag+kind+"-asf.bin").c_str(),batch.activation_scales[slot],down?5120:20480,stream)&&
    Capture((tag+kind+"-weights.bin").c_str(),batch.weights[slot],size_t(n)*k/2,stream)&&
    Capture((tag+kind+"-wsf.bin").c_str(),batch.weight_scales[slot],size_t(n/128)*(down?5120:20480),stream);
   if(down){
    ok=ok&&Capture((tag+".gu-output.bf16").c_str(),Pointer<uint16_t>(args,0)+slot*1280,2560,stream)&&
     Capture((tag+".inter-input.bf16").c_str(),Pointer<uint16_t>(args,0)+slot*1280,2560,stream);
   }else ok=ok&&Capture((tag+".gu-input.bf16").c_str(),Pointer<uint16_t>(args,0),5120,stream);
   char meta[512];int len=std::snprintf(meta,sizeof(meta),
    "{\"layer\":%d,\"expert\":%d,\"row\":0,\"rows\":1,\"slot\":%d,\"scale_hex\":\"%a\",\"alpha_hex\":\"%a\",\"ok\":%s}\n",
    layer,e,slot,double(scale),double(batch.alpha[slot]),ok?"true":"false");
   if(len>0&&size_t(len)<sizeof(meta))Save(Base()+tag+kind+".json",meta,len);
  }
  std::fprintf(stderr,"[decode-prepare] layer=%d down=%d ok=%d\n",layer,down,ok);
 }
 if(kernel==combine)Capture(".routed.f32",Pointer<float>(args,2),2560*4,stream);
 if(kernel==shared_swiglu&&*static_cast<int*>(args[2])==1){
  Capture(".shared-gu.bf16",Pointer<uint16_t>(args,0),2560,stream);
  Capture(".shared-inter.bf16",Pointer<uint16_t>(args,1),1280,stream);
 }
 if(kernel==merge&&*static_cast<int*>(args[5])==1){
  bool ok=Capture(".merge-routed.f32",Pointer<float>(args,0),10240,stream)&&
   Capture(".shared.bf16",Pointer<uint16_t>(args,1),5120,stream)&&
   Capture(".x.bf16",Pointer<uint16_t>(args,2),5120,stream)&&
   Capture(".gate.bf16",Pointer<uint16_t>(args,3),5120,stream)&&
   Capture(".output.bf16",Pointer<uint16_t>(args,4),5120,stream);
  char meta[256];int n=std::snprintf(meta,sizeof(meta),"{\"layer\":%d,\"tokens\":1,\"token\":0,\"hs\":2560,\"slots\":10,\"block\":%u,\"ok\":%s}\n",layer,block.x,ok?"true":"false");
  if(n>0&&size_t(n)<sizeof(meta))Save(Base()+".meta.json",meta,n);
  std::fprintf(stderr,"[decode-merge] layer=%d ok=%d\n",layer,ok);
 }
 return result;
}
