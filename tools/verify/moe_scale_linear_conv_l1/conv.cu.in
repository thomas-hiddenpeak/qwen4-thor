#include <cuda_runtime.h>
#include "common.h"
#define CU(x)                                             \
  do {                                                    \
    if ((x) != cudaSuccess) throw std::runtime_error(#x); \
  } while (0)
__global__ void Silu(const float* x, float* y, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) y[i] = x[i] / (1.f + __expf(-x[i]));
}
int main(int argc, char** argv) {
  try {
    if (argc != 4) throw std::runtime_error("captures input output_prefix");
    std::string b = std::string(argv[1]) + "/layer-1", o = argv[3];
    constexpr int C = 10240;
    constexpr size_t n = size_t(4096) * C;
    auto x = Read<uint16_t>(argv[2], n),
         w = Read<uint16_t>(b + ".weights.bf16", C * 4),
         h = Read<uint16_t>(b + ".history-before.bf16", C * 3),
         a = Read<uint16_t>(b + ".output.bf16", n);
    std::vector<float> acc(n), si(n);
    std::vector<uint16_t> out(n);
#pragma omp parallel for
    for (size_t i = 0; i < n; ++i) {
      int t = i / C, c = i % C;
      float sum = 0;
      for (int k = 0; k < 4; ++k) {
        int src = t - 3 + k;
        float v = B(src < 0 ? h[c * 3 + src + 3] : x[size_t(src) * C + c]);
        sum = std::fma(v, B(w[c * 4 + k]), sum);
      }
      acc[i] = sum;
    }
    float *dx, *dy;
    CU(cudaMalloc(&dx, n * 4));
    CU(cudaMalloc(&dy, n * 4));
    CU(cudaMemcpy(dx, acc.data(), n * 4, cudaMemcpyHostToDevice));
    Silu<<<(n + 255) / 256, 256>>>(dx, dy, int(n));
    CU(cudaGetLastError());
    CU(cudaMemcpy(si.data(), dy, n * 4, cudaMemcpyDeviceToHost));
    CU(cudaFree(dx));
    CU(cudaFree(dy));
    std::vector<int32_t> idx;
    for (size_t i = 0; i < n; ++i) {
      if (!std::isfinite(acc[i]) || !std::isfinite(si[i]))
        throw std::runtime_error("nonfinite");
      out[i] = Round(si[i]);
      if (out[i] != a[i]) idx.push_back(int32_t(i));
    }
    Save(o + ".acc.f32", acc);
    Save(o + ".silu.f32", si);
    Save(o + ".bf16", out);
    Save(o + ".differences.i32", idx);
    std::printf("{\"elements\":%zu,\"mismatches\":%zu}\n", n, idx.size());
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
