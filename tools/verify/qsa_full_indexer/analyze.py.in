from pathlib import Path
import json,hashlib,struct,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-full-indexer-20260924';c=o/'observed-captures';old=root/'.q4t-work/e2e/qsa-main-projections-20260923';q=root/'.q4t-work/e2e/qsa-full-selection-20260924';h=root/'.q4t-work/e2e/hc-full-boundaries-20260923';model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream')
def sha(f):
 x=hashlib.sha256()
 with f.open('rb') as stream:
  for b in iter(lambda:stream.read(4*1024*1024),b''):x.update(b)
 return x.hexdigest()
def save(name,v):(o/name).write_text(json.dumps(v,indent=2)+'\n')
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output'];assert sha(root/'build/q4t')==json.loads((o/'plan.json').read_text())['binary_sha256']
for label,source in [('hc',h),('qsa',q),('index',old)]:
 binding=json.loads((o/(label+'-binding.json')).read_text());assert sha(source/'artifact-binding.json')==binding['manifest_sha256']
 for r in binding['records']:assert sha(source/r['file'])==r['sha256']
metas=[json.loads(f.read_text()) for f in c.glob('*.json')];assert len(metas)==108 and all(m['ok'] for m in metas)
index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];config=json.loads((model/'config.json').read_text())['text_config'];om=json.loads((old/'artifact-binding.json').read_text());weights=[];previous=[];records=[];maps=[]
def tensor(key,shape):
 f=model/index[key]
 with f.open('rb') as stream:
  size=struct.unpack('<Q',stream.read(8))[0];info=json.loads(stream.read(size))[key];assert info['dtype']=='BF16' and info['shape']==shape;a,b=info['data_offsets'];offset=8+size+a;stream.seek(offset);raw=stream.read(b-a)
 assert len(raw)==int(np.prod(shape))*2;st=f.stat();weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns});return raw
def old_bytes(l,suffix):
 f=old/'observed-captures'/f'layer-{l}.prefill.{suffix}';name=str(f.relative_to(old));assert sha(f)==om[name];previous.append({'file':name,'sha256':om[name]});return f.read_bytes()
def finite(a):return np.all((a&0x7f80)!=0x7f80)
for l in range(3,48,4):
 b=f'layer-{l}.prefill';raw=tensor(f'model.language_model.layers.{l}.self_attn.indexer.index_qk_proj.weight',[640,2560]);offset=0
 for kind,n in [('iq',512),('ik',128)]:
  f=c/(b+f'.{kind}.weights.bf16');piece=raw[offset:offset+n*2560*2];offset+=len(piece);assert piece==f.read_bytes()==old_bytes(l,f'projection-{kind}.weights.bf16');assert (c/(b+f'.{kind}.algo.bin')).stat().st_size==64
  output=c/(b+'.iq.raw.bf16') if kind=='iq' else old/'observed-captures'/(b+'.ik-input.bf16');assert output.stat().st_size==4096*n*2;assert output.read_bytes()[-n*2:]==old_bytes(l,f'projection-{kind}.output.bf16')
  inp=h/'observed-captures'/f'hc-{l}.prefill.mix.attn.output.bf16';maps.append({'layer':l,'kind':kind,'m':4096,'n':n,'k':2560,'input':str(inp.relative_to(root)),'weight':str(f.relative_to(root)),'output':str(output.relative_to(root)),'algorithm':str((c/(b+f'.{kind}.algo.bin')).relative_to(root))})
 for side in ['q','k']:
