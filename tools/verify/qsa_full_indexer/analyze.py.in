summary={'layers':12,'tokens':4096,'metadata_records':108,'source_files_bound':96,'projection_calls':24,'projection_output_elements':12*4096*640,'score_gemm_calls':12,'score_matrix_elements':sum(r['total_dot_elements'] for r in records),'visible_dot_elements':sum(r['visible_dot_elements'] for r in records),'masked_dot_nonfinite':sum(r['masked_dot_nonfinite'] for r in records),'padded_key_nonfinite':sum(r['padded_key_nonfinite'] for r in records),'old_masked_last_differences':sum(r['old_masked_last_differences'] for r in records),'checkpoint_tensors':len(weights),'checkpoint_bytes':sum(w['bytes'] for w in weights),'old_bindings':len(previous),'full_source_consumer_bindings_passed':True,'indexer_arithmetic_verified':False,'runtime_changed':False,'whole_model_correctness_proven':False,'capture_bytes':sum(f.stat().st_size for f in c.iterdir()),'free_after':shutil.disk_usage(o).free};assert summary['capture_bytes']<1100000000
