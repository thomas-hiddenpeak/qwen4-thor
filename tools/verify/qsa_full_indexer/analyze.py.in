 iq=np.fromfile(c/(b+'.iq.raw.bf16'),dtype='<u2');trans=np.fromfile(c/(b+'.iq.transformed.bf16'),dtype='<u2');assert iq.size==trans.size==4096*512 and finite(iq) and finite(trans);assert trans[-512:].tobytes()==old_bytes(l,'iq.bf16') and iq[-512:].tobytes()==old_bytes(l,'iq-before.bf16')
 for tag in ['query-transform','raw-write','compression']:
  pos=np.fromfile(c/(b+f'.{tag}.positions.i32'),dtype='<i4');ids=np.fromfile(c/(b+f'.{tag}.seqids.i32'),dtype='<i4');null=np.fromfile(c/(b+f'.{tag}.seqids-null.i32'),dtype='<i4');assert np.array_equal(pos,np.arange(4096)) and ids.size==4096 and np.all(ids==0) and null.size==1 and null[0] in [0,1]
  if tag!='raw-write':
   for row in range(3):
    rp=np.fromfile(c/(b+f'.{tag}.rope-{row}.i32'),dtype='<i4');assert np.array_equal(rp,pos);assert rp.tobytes()==old_bytes(l,f'rope-{row}.i32')
 for tag,oldtag in [('query','iq-params'),('compression','compressed-params')]:
  params=(c/(b+f'.{tag}.params.f32')).read_bytes();expected=np.array([config['rope_parameters']['rope_theta'],config['rms_norm_eps']],dtype='<f4').tobytes();assert params==expected==old_bytes(l,oldtag+'.f32')
 keys=np.fromfile(c/(b+'.score.keys.bf16'),dtype='<u2').reshape(2048,128);assert finite(keys[:1024]) and keys[:1024].tobytes()==old_bytes(l,'compressed.bf16');dot=np.fromfile(c/(b+'.score.output.bf16'),dtype='<u2').reshape(4096,4,2048);assert (c/(b+'.score.algo.bin')).stat().st_size==64
 visible=0;masked_nonfinite=0
 for t in range(4096):
  groups=(t+1)//4;assert finite(dot[t,:,:groups]);visible+=4*groups;masked_nonfinite+=int(np.count_nonzero((dot[t,:,groups:]&0x7f80)==0x7f80))
 prior_dot=np.frombuffer(old_bytes(l,'gemm.output.bf16'),dtype='<u2').reshape(4,2048);assert np.array_equal(dot[-1,:,:1024],prior_dot[:,:1024]);bad=np.flatnonzero(dot[-1,:,1024:].ravel()!=prior_dot[:,1024:].ravel()).astype('<i4');np.savez_compressed(o/f'layer-{l}.old-masked-tail-differences.npz',indices=bad,current=dot[-1,:,1024:].ravel()[bad],prior=prior_dot[:,1024:].ravel()[bad])
 maps.append({'layer':l,'kind':'score','m':16384,'n':2048,'k':128,'input':str((c/(b+'.iq.transformed.bf16')).relative_to(root)),'weight':str((c/(b+'.score.keys.bf16')).relative_to(root)),'output':str((c/(b+'.score.output.bf16')).relative_to(root)),'algorithm':str((c/(b+'.score.algo.bin')).relative_to(root))})
 records.append({'layer':l,'visible_dot_elements':visible,'total_dot_elements':dot.size,'masked_dot_nonfinite':masked_nonfinite,'padded_key_nonfinite':int(np.count_nonzero((keys[1024:]&0x7f80)==0x7f80)),'old_masked_last_differences':len(bad)});print(records[-1],flush=True)
for r in maps:
