from pathlib import Path
import json,numpy as np,math
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/moe-token-chain-reference-20260923';c=o/'observed-captures';mapping=json.loads((o/'inter-map.json').read_text());fp8=np.array([math.ldexp(i%8,-9) if i<8 else math.ldexp(1+i%8/8,i//8-7) for i in range(127)]);positive=np.array([0,.5,1,1.5,2,3,4,6]);order=np.array([0,2,4,6,1,3,5,7],dtype=np.uint8)
records=[];badscales=[]
for no,m in enumerate(mapping):
 b=str(c/f"layer-{m['layer']}.expert-{m['expert']}");gu=(np.fromfile(b+'.inter-input.bf16',dtype='<u2').astype(np.uint32)<<16).view(np.float32).astype(np.float64);g,u=gu[:640],gu[640:];z=np.exp(-abs(g));sig=np.where(g>=0,1/(1+z),z/(1+z));v=(g*sig*u).astype(np.float32);meta=json.loads(Path(b+'.dn.json').read_text());sf=np.load(b+'.dn-reference.npz')['actual_sf'].reshape(-1);eff=np.float32(fp8[sf].astype(np.float32)*np.float32(float.fromhex(meta['scale_hex'])));inv=np.zeros_like(eff);np.divide(np.float32(1),eff,out=inv,where=eff>0);normalized=np.float32(v*inv.repeat(16));d=abs(abs(normalized.astype(np.float64))[:,None]-positive[order]);code=order[np.argmin(d,axis=-1)]|np.where(normalized<0,8,0).astype(np.uint8);packed=np.fromfile(b+'.dn-packed.bin',dtype='u1');actual=np.empty(640,dtype='u1');actual[::2]=packed&15;actual[1::2]=packed>>4;idx=np.flatnonzero(code!=actual);records.append(dict(m,mismatches=len(idx),indices=idx.tolist()))
for line in (o/'inter-replay.tsv').read_text().splitlines():
 i,v,a,legacy,native=line.split();i,a,legacy,native=map(int,[i,a,legacy,native]);v=float.fromhex(v)
 if a!=native:badscales.append(dict(mapping[i//40],group=i%40,ratio=v,actual=a,expected=native))
r={'elements':307200,'fp64_swiglu_rounded_fp32_then_actual_scale_fp4_mismatches':sum(x['mismatches'] for x in records),'records':records,'scale_errors':len(badscales),'all_scale_errors_high_range':all(248<=x['ratio']<432 for x in badscales),'scale_details':badscales,'limitation':'Independent transcendental reference is rounded to FP32 then normalized using actual captured SF, not corrected SF. Does not claim __expf bitwise accuracy or propagate corrected scales.'};(o/'inter-math-reference.json').write_text(json.dumps(r,indent=2)+'\n');print({k:v for k,v in r.items() if k not in ['records','scale_details']})
