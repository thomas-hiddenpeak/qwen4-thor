#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>
float Decode(uint16_t v) {
  uint32_t b = uint32_t(v) << 16;
  float f;
  std::memcpy(&f, &b, 4);
  return f;
}
uint16_t Round(float f) {
  uint32_t b;
  std::memcpy(&b, &f, 4);
  return (b + 0x7fff + ((b >> 16) & 1)) >> 16;
}
template <class T>
std::vector<T> Read(const std::string& s, size_t n) {
  std::ifstream f(s, std::ios::binary | std::ios::ate);
  if (!f || size_t(f.tellg()) != n * sizeof(T)) throw std::runtime_error(s);
  std::vector<T> v(n);
  f.seekg(0);
  if (!f.read(reinterpret_cast<char*>(v.data()), n * sizeof(T)))
    throw std::runtime_error(s);
  return v;
}
template <class T>
void Write(const std::string& s, const std::vector<T>& v) {
  std::ofstream f(s, std::ios::binary);
  f.write(reinterpret_cast<const char*>(v.data()), v.size() * sizeof(T));
  if (!f) throw std::runtime_error(s);
}
int main(int argc, char** argv) {
  try {
    if (argc != 8)
      throw std::runtime_error(
          "captures outputs layer attn|mlp sigmoid-table new_up new_norm");
    int layer = std::stoi(argv[3]);
    std::string name =
                    "hc-" + std::to_string(layer) + ".prefill.mix." + argv[4],
                b = std::string(argv[1]) + "/" + name,
                o = std::string(argv[2]) + "/" + name;
    constexpr size_t n = 4096 * 2560;
    auto up = Read<uint16_t>(argv[6], n * 4),
         norm = Read<uint16_t>(argv[7], n * 4),
         expected = Read<uint16_t>(b + ".output.bf16", n);
    auto device = Read<float>(argv[5], 65536);
    std::vector<float> cpu(65536);
    std::vector<double> high(65536);
    for (int i = 0; i < 65536; ++i) {
      double x = Decode(uint16_t(i));
      cpu[i] = 1.0f / (1.0f + float(std::exp(-x)));
      high[i] = 1.0 / (1.0 + std::exp(-x));
    }
    for (size_t i = 0; i < n * 4; ++i)
      if (!std::isfinite(Decode(up[i])) || !std::isfinite(Decode(norm[i])))
        throw std::runtime_error("nonfinite input");
    std::printf("{\"name\":\"%s\",\"elements\":%zu,\"mismatches\":[",
                name.c_str(), n);
    for (int variant = 1; variant < 2; ++variant) {
      std::vector<uint16_t> y(n);
      size_t bad = 0;
#pragma omp parallel for reduction(+ : bad)
      for (size_t i = 0; i < n; ++i) {
        size_t t = i / 2560, c = i % 2560;
        float sum = 0;
        double total = 0;
        for (int branch = 0; branch < 4; ++branch) {
          size_t k = t * 10240 + branch * 2560 + c;
          float v = Decode(norm[k]);
          if (variant == 2)
            total += high[up[k]] * double(v);
          else
            sum = std::fma(variant == 1 ? device[up[k]] : cpu[up[k]], v, sum);
        }
        y[i] = Round(variant == 2 ? float(total / 4.0) : sum / 4.0f);
        bad += y[i] != expected[i];
      }
      const char* kind = variant == 0   ? "cpu"
                         : variant == 1 ? "device"
                                        : "fp64";
      Write(o + "." + kind + ".bf16", y);
      std::printf("%s%zu", "", bad);
    }
    std::printf("]}\n");
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
