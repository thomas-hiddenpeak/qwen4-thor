#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> prefill{nullptr},decode{nullptr}, conv_prefill{nullptr}, update_prefill{nullptr}, conv_decode{nullptr}, update_decode{nullptr};
std::atomic<int> conv_prefill_count{0},conv_decode_count{0};
thread_local bool take_conv=false;
std::atomic<int> prefill_count{0},decode_count{0};
thread_local int layer=-1;
template <typename T> T Resolve(const char* name) {
  auto fn = reinterpret_cast<T>(dlsym(RTLD_NEXT, name));
  if (!fn) std::_Exit(127);
  return fn;
}
std::string Base() {
  const char* dir = std::getenv("Q4T_GDN_CAPTURE_DIR");
  return std::string(dir ? dir : "") + "/layer-" + std::to_string(layer);
}
bool Save(const std::string& path, const void* data, size_t bytes) {
  FILE* f = std::fopen(path.c_str(), "wb");
  if (!f) return false;
  const bool ok = std::fwrite(data, 1, bytes, f) == bytes;
  return std::fclose(f) == 0 && ok;
}
bool Read(void* dst, const void* src, size_t bytes, cudaStream_t stream) {
  static const auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static const auto sync = Resolve<decltype(&cudaStreamSynchronize)>(
      "cudaStreamSynchronize");
  return copy(dst, src, bytes, cudaMemcpyDeviceToHost, stream) == cudaSuccess &&
         sync(stream) == cudaSuccess;
}
bool Capture(const char* suffix, const void* src, size_t bytes,
             cudaStream_t stream) {
  std::vector<unsigned char> data(bytes);
  return Read(data.data(), src, bytes, stream) &&
         Save(Base() + suffix, data.data(), bytes);
}
template <typename T> T* Pointer(void** args, int index) {
  return *static_cast<T**>(args[index]);
}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* k,const void* fn){
 using Get=cudaError_t(*)(cudaKernel_t*,const void*);static auto real=Resolve<Get>("__cudaGetKernel");auto result=real(k,fn);
 if(result==cudaSuccess){const char* n=nullptr;static auto name=Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");
  if(name(&n,fn)==cudaSuccess&&n){
   if(std::strstr(n,"GatedDeltaNetRegKernelILi8"))prefill=*k;
   if(std::strstr(n,"GatedDeltaNetDecodeKernel"))decode=*k;
   if(std::strstr(n,"CausalConv1dWithCkptKernel"))conv_prefill=*k;
   if(std::strstr(n,"Conv1dUpdateStateKernel"))update_prefill=*k;
   if(std::strstr(n,"CausalConv1dMultiSeqKernel"))conv_decode=*k;
   if(std::strstr(n,"Conv1dUpdateStateMultiSeqKernel"))update_decode=*k;
  }
 }return result;
}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t kernel,dim3 grid,dim3 block,void** args,size_t shared,cudaStream_t stream){
 using Launch=cudaError_t(*)(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t);static auto real=Resolve<Launch>("__cudaLaunchKernel");
 const bool enabled=std::getenv("Q4T_GDN_CAPTURE_DIR")!=nullptr;
 bool take=false,ok=true;int seq=-1;float* state=nullptr;
 if(enabled&&kernel==conv_decode&&prefill_count==36&&grid.y==1){
  int index=conv_decode_count.fetch_add(1);take_conv=index<36;layer=index+index/3;
  if(take_conv){int conv_seq=-1;
   bool good=*static_cast<int*>(args[5])==10240&&*static_cast<int*>(args[6])==4&&Read(&conv_seq,Pointer<int>(args,4),4,stream)&&conv_seq==0&&
    Capture(".conv-decode-input.bf16",Pointer<uint16_t>(args,0),10240*2,stream)&&
    Capture(".conv-decode-before.bf16",Pointer<uint16_t>(args,2),10240*3*2,stream)&&
    Capture(".conv-weights.bf16",Pointer<uint16_t>(args,3),10240*4*2,stream);
   std::fprintf(stderr,"[conv-decode-before] layer=%d ok=%d\n",layer,good);
  }
 }

 if(enabled&&kernel==decode&&prefill_count==36&&grid.y==1){
  int index=decode_count.fetch_add(1);take=index<36;layer=index+index/3;
  if(take){
   ok=*static_cast<int*>(args[7])==16&&*static_cast<int*>(args[8])==128&&
      *static_cast<int*>(args[9])==3&&*static_cast<int*>(args[10])==128&&
      *static_cast<int*>(args[11])==10240&&*static_cast<int*>(args[12])==48&&
      Read(&seq,Pointer<int>(args,13),sizeof(seq),stream)&&seq==0;
   state=Pointer<float>(args,5);
   ok=ok&&Capture(".decode-state-before.f32",state,48*128*128*4,stream)&&
    Capture(".decode-qkv.bf16",Pointer<uint16_t>(args,0),10240*2,stream)&&
    Capture(".decode-a.bf16",Pointer<uint16_t>(args,1),48*2,stream)&&
    Capture(".dt-bias.bf16",Pointer<uint16_t>(args,2),48*2,stream)&&
    Capture(".a-log.bf16",Pointer<uint16_t>(args,3),48*2,stream)&&
    Capture(".decode-beta.bf16",Pointer<uint16_t>(args,4),48*2,stream);
  }
 }
 auto status=real(kernel,grid,block,args,shared,stream);
 if(!enabled||status!=cudaSuccess)return status;
 if(kernel==conv_prefill&&*static_cast<int*>(args[5])==4096){
  int index=conv_prefill_count.load();layer=index+index/3;
  if(index<36){bool good=*static_cast<int*>(args[6])==10240&&*static_cast<int*>(args[7])==4&&
    Capture(".conv-prefill-tail.bf16",Pointer<uint16_t>(args,0)+size_t(4092)*10240,4*10240*2,stream)&&
    Capture(".conv-prefill-output.bf16",Pointer<uint16_t>(args,1)+size_t(4095)*10240,10240*2,stream);
   std::fprintf(stderr,"[conv-prefill-tail] layer=%d ok=%d\n",layer,good);
  }
 }
 if(kernel==update_prefill&&*static_cast<int*>(args[2])==4096){
  int index=conv_prefill_count.fetch_add(1);layer=index+index/3;
  if(index<36){bool good=Capture(".conv-prefill-state.bf16",Pointer<uint16_t>(args,0),10240*3*2,stream);
   std::fprintf(stderr,"[conv-prefill-state] layer=%d ok=%d\n",layer,good);
  }
 }
 if(kernel==conv_decode&&take_conv){bool good=Capture(".conv-decode-output.bf16",Pointer<uint16_t>(args,1),10240*2,stream);std::fprintf(stderr,"[conv-decode-output] layer=%d ok=%d\n",layer,good);}
 if(kernel==update_decode&&take_conv){bool good=Capture(".conv-decode-after.bf16",Pointer<uint16_t>(args,0),10240*3*2,stream);std::fprintf(stderr,"[conv-decode-after] layer=%d ok=%d\n",layer,good);}
 if(kernel==prefill&&*static_cast<int*>(args[7])==4096){
  int index=prefill_count.fetch_add(1);layer=index+index/3;
  if(index<36){
   bool saved=Capture(".prefill-state-final.f32",Pointer<float>(args,5),48*128*128*4,stream);
   std::fprintf(stderr,"[gdn-prefill-state] layer=%d ok=%d\n",layer,saved);
  }
 }
 if(take){
  ok=ok&&Capture(".decode-state-after.f32",state,48*128*128*4,stream)&&
   Capture(".decode-y.bf16",Pointer<uint16_t>(args,6),48*128*2,stream);
  char meta[256];int size=std::snprintf(meta,sizeof(meta),"{\"layer\":%d,\"seq\":%d,\"heads\":48,\"kd\":128,\"vd\":128,\"block\":%u,\"ok\":%s}\n",layer,seq,block.x,ok?"true":"false");
  if(size>0&&size_t(size)<sizeof(meta))Save(Base()+".meta.json",meta,size);
  std::fprintf(stderr,"[gdn-decode-state] layer=%d ok=%d\n",layer,ok);
 }
 return status;
}
