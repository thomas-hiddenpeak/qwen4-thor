#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <atomic>
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> lookup{nullptr},convert{nullptr},scale_kernel{nullptr},expand{nullptr},hc_norm{nullptr};
const uint16_t *main_embedding=nullptr,*main_trunk=nullptr;bool await_entry=false,entered=true;
int step=-1,tokens=0;bool converted=false,scaled=true;const uint16_t* embedding=nullptr;
template<class T>T Resolve(const char* n){auto p=reinterpret_cast<T>(dlsym(RTLD_NEXT,n));if(!p)std::_Exit(127);return p;}
template<class T>T* Ptr(void** a,int i){return *static_cast<T**>(a[i]);}
bool Save(const std::string& s,const void* p,size_t n){FILE* f=std::fopen(s.c_str(),"wb");if(!f)return false;bool ok=std::fwrite(p,1,n,f)==n;return std::fclose(f)==0&&ok;}
bool Capture(const std::string& s,const void* d,size_t n,cudaStream_t stream){static auto copy=Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");static auto sync=Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");std::vector<unsigned char> v(n);return copy(v.data(),d,n,cudaMemcpyDeviceToHost,stream)==cudaSuccess&&sync(stream)==cudaSuccess&&Save(s,v.data(),n);}
std::string Base(){return std::string(std::getenv("Q4T_PLE_CAPTURE_DIR"))+"/step-"+std::to_string(step);}
bool CaptureEmbedding(void** a,cudaStream_t stream){
 static auto copy=Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");static auto sync=Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");std::vector<int32_t> ids(tokens);
 bool ok=copy(ids.data(),Ptr<int32_t>(a,1),size_t(tokens)*4,cudaMemcpyDeviceToHost,stream)==cudaSuccess&&sync(stream)==cudaSuccess;
 if(!ok)return false;
 std::sort(ids.begin(),ids.end());ids.erase(std::unique(ids.begin(),ids.end()),ids.end());for(int id:ids)if(id<0||id>=248320)return false;
 std::vector<uint16_t> rows(ids.size()*2560);for(size_t i=0;i<ids.size();++i)ok=ok&&copy(rows.data()+i*2560,Ptr<uint16_t>(a,0)+size_t(ids[i])*2560,5120,cudaMemcpyDeviceToHost,stream)==cudaSuccess;
 ok=ok&&sync(stream)==cudaSuccess&&Save(Base()+".weight-ids.i32",ids.data(),ids.size()*4)&&Save(Base()+".weight-rows.bf16",rows.data(),rows.size()*2)&&Capture(Base()+".embedding.bf16",Ptr<uint16_t>(a,2),size_t(tokens)*2560*2,stream);return ok;
}
void Meta(const std::string& kind,bool ok){char m[160];int n=std::snprintf(m,sizeof(m),"{\"step\":%d,\"tokens\":%d,\"kind\":\"%s\",\"ok\":%s}\n",step,tokens,kind.c_str(),ok?"true":"false");if(n>0&&size_t(n)<sizeof(m))Save(Base()+"."+kind+".json",m,n);std::fprintf(stderr,"[ple-lookup] step=%d kind=%s ok=%d\n",step,kind.c_str(),ok);}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* k,const void* fn){static auto real=Resolve<cudaError_t(*)(cudaKernel_t*,const void*)>("__cudaGetKernel");auto s=real(k,fn);if(s==cudaSuccess){const char* n=nullptr;static auto name=Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");if(name(&n,fn)==cudaSuccess&&n){if(std::strstr(n,"EmbedLookupKernel")&&std::strstr(n,"model_head_cu"))lookup=*k;if(std::strstr(n,"ExpandTrunkKernel")&&std::strstr(n,"model_head_cu"))expand=*k;if(std::strstr(n,"GroupedRmsNormKernel")&&std::strstr(n,"hyperconnection_cu"))hc_norm=*k;if(std::strstr(n,"Fp8ToBf16Kernel")&&std::strstr(n,"fp8_convert_cu"))convert=*k;if(std::strstr(n,"ScaleBf16Kernel")&&std::strstr(n,"model_cu"))scale_kernel=*k;}}return s;}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t k,dim3 grid,dim3 block,void** a,size_t smem,cudaStream_t stream){
 static auto real=Resolve<cudaError_t(*)(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t)>("__cudaLaunchKernel");auto s=real(k,grid,block,a,smem,stream);if(!std::getenv("Q4T_PLE_CAPTURE_DIR")||s!=cudaSuccess)return s;
 if(k==lookup){bool ok=scaled&&entered&&((step==-1&&grid.x==4096)||(step>=0&&grid.x==1))&&*static_cast<int*>(a[3])==2560;++step;tokens=int(grid.x);converted=false;scaled=false;ok=ok&&step<16&&Capture(Base()+".tokens.i32",Ptr<int32_t>(a,1),size_t(tokens)*4,stream);Meta("tokens",ok);main_embedding=Ptr<uint16_t>(a,2);main_trunk=nullptr;await_entry=false;entered=false;Meta("embedding",ok&&CaptureEmbedding(a,stream));}
 if(k==expand&&step>=0){bool ok=!await_entry&&!entered&&Ptr<uint16_t>(a,0)==main_embedding&&*static_cast<int*>(a[2])==tokens&&*static_cast<int*>(a[3])==4&&*static_cast<int*>(a[4])==2560;main_trunk=Ptr<uint16_t>(a,1);ok=ok&&Capture(Base()+".expanded.bf16",main_trunk,size_t(tokens)*10240*2,stream);await_entry=true;Meta("expand",ok);}
 if(k==hc_norm&&step>=0&&await_entry){bool ok=Ptr<uint16_t>(a,0)==main_trunk&&*static_cast<int*>(a[3])==tokens&&*static_cast<int*>(a[4])==4&&*static_cast<int*>(a[5])==2560&&Capture(Base()+".entry-last.bf16",Ptr<uint16_t>(a,0)+size_t(tokens-1)*10240,20480,stream);await_entry=false;entered=true;Meta("entry",ok);}
 if(k==convert&&step>=0){size_t count=*static_cast<size_t*>(a[2]);bool ok=!converted&&!scaled&&count==size_t(tokens)*2560;embedding=Ptr<uint16_t>(a,1);ok=ok&&Capture(Base()+".fp8",Ptr<uint8_t>(a,0),count,stream)&&Capture(Base()+".converted.bf16",embedding,count*2,stream);converted=true;Meta("convert",ok);}
 if(k==scale_kernel&&step>=0&&Ptr<uint16_t>(a,0)==embedding){int count=*static_cast<int*>(a[1]);float scale=*static_cast<float*>(a[2]);bool ok=converted&&!scaled&&count==tokens*2560&&Save(Base()+".scale.f32",&scale,4)&&Capture(Base()+".scaled.bf16",embedding,size_t(count)*2,stream);scaled=true;Meta("scale",ok);}
 return s;
}
