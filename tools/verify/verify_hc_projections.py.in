from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/hc-projection-reference-20260923';c=o/'observed-captures';old=root/'.q4t-work/e2e/hc-norm-reference-20260923/observed-captures'
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output']
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');idx=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];headers={}
def dec(b):return (np.frombuffer(b,dtype='<u2').astype(np.uint32)<<16).view(np.float32).astype(np.float64)
def rounded(v):
 b=np.asarray(v,dtype=np.float32).view(np.uint32);return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype(np.uint16)
bind=[]
for f in sorted(old.glob('*.bf16')):
 assert f.read_bytes()==(c/f.name).read_bytes(),f.name
 bind.append({'file':f.name,'sha256':hashlib.sha256(f.read_bytes()).hexdigest()})
(o/'previous-binding.json').write_text(json.dumps({'files':len(bind),'records':bind,'all_equal':True},indent=2)+'\n')
records=[];nonlinear=[]
for l in range(48):
 for phase in ['prefill','decode']:
  for side,kind in [('attn','read'),('mlp','fused')]:
   base=c/f'hc-{l}.{phase}.{side}';norm=(c/f'hc-{l}.{phase}.{kind}{".output.bf16" if side=="attn" else ".normed.bf16"}').read_bytes()
   for stage,n,k,parameter in [('down',320,10240,'input_mix_weight_down'),('up',10240,320,'input_mix_weight_up'),('inject',4,10240,'block_inject_weight')]:
    s=str(base)+'.'+stage;meta=json.loads(Path(s+'.hp.json').read_text());assert meta['ok'] and meta['n']==n and meta['k']==k
    data=Path(s+'.weights.bf16').read_bytes();name=f'model.language_model.layers.{l}.{side}_hyper_connection.{parameter}.weight';file=model/idx[name]
    with file.open('rb') as f:
     if file not in headers:
      size=struct.unpack('<Q',f.read(8))[0];headers[file]=(size,json.loads(f.read(size)))
     size,h=headers[file];info=h[name];assert info['dtype']=='BF16' and info['shape']==[n,k];a,b=info['data_offsets'];f.seek(8+size+a);expected=f.read(b-a)
    assert data==expected
    inp=Path(s+'.input.bf16').read_bytes();actual=np.fromfile(s+'.output.bf16',dtype='<u2')
    if stage in ['down','inject']:assert inp==norm
    if stage=='up':assert Path(s+'.output.bf16').read_bytes()==(c/f'hc-{l}.{phase}.mix.{side}.up.bf16').read_bytes()
    ref=dec(data).reshape(n,k)@dec(inp);raw=rounded(ref);bits=raw
    if meta['gated']:
     value=dec(raw.tobytes())/4;bits=rounded(2/(1+np.exp(-value)))
    bad=np.flatnonzero(bits!=actual);np.savez(s+'.reference.npz',fp64=ref,raw_bf16_bits=raw,bf16_bits=bits)
    records.append({'layer':l,'phase':phase,'side':side,'stage':stage,'elements':n,'gated':meta['gated'],'mismatches':len(bad),'indices':bad.tolist(),'weight_sha256':hashlib.sha256(data).hexdigest()})
   gatefile=str(base)+'.inject'+('.gate.bf16' if phase=='prefill' else '.output.bf16');gate=Path(gatefile).read_bytes();writekind='fused' if side=='attn' else 'write';assert gate==(c/f'hc-{l}.{phase}.{writekind}.gate.bf16').read_bytes()
   rawdown=dec(Path(str(base)+'.down.output.bf16').read_bytes())/4;ref=rounded(rawdown/(1+np.exp(-rawdown)));actual=np.fromfile(str(base)+'.up.input.bf16',dtype='<u2');bad=np.flatnonzero(ref!=actual);nonlinear.append({'name':str(base.name),'stage':'silu','elements':320,'mismatches':len(bad),'indices':bad.tolist()})
   if phase=='prefill':
    rawinject=dec(Path(str(base)+'.inject.output.bf16').read_bytes())/4;ref=rounded(2/(1+np.exp(-rawinject)));actual=np.frombuffer(gate,dtype='<u2');bad=np.flatnonzero(ref!=actual);nonlinear.append({'name':str(base.name),'stage':'gate','elements':4,'mismatches':len(bad),'indices':bad.tolist()})
   (o/'progress.json').write_text(json.dumps({'calls':len(records),'last':records[-1]})+'\n')
r={'calls':len(records),'elements':sum(x['elements'] for x in records),'mismatches':{phase:{stage:sum(x['mismatches'] for x in records if x['phase']==phase and x['stage']==stage) for stage in ['down','up','inject']} for phase in ['prefill','decode']},'records':records,'nonlinear':nonlinear,'nonlinear_mismatches':{stage:sum(x['mismatches'] for x in nonlinear if x['stage']==stage) for stage in ['silu','gate']},'limitation':'Decode inject output is fused gate; raw dot not observable. Actual normed inputs; only last prefill and first decode.'}
(o/'projection-reference.json').write_text(json.dumps(r,indent=2)+'\n');print({k:v for k,v in r.items() if k not in ['records','nonlinear']})
