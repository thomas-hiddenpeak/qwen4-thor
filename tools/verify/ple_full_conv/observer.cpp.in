#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> kernel[4]{};
int counts[2][2]{};
const uint16_t* input[2]{};
const uint16_t* state[2]{};
template <class T>
T Resolve(const char* name) {
  auto p = reinterpret_cast<T>(dlsym(RTLD_NEXT, name));
  if (!p) std::_Exit(127);
  return p;
}
template <class T>
T* Ptr(void** a, int i) {
  return *static_cast<T**>(a[i]);
}
bool Save(const std::string& s, const void* p, size_t n) {
  FILE* f = std::fopen(s.c_str(), "wb");
  if (!f) return false;
  bool ok = std::fwrite(p, 1, n, f) == n;
  return std::fclose(f) == 0 && ok;
}
bool Read(void* h, const void* d, size_t n, cudaStream_t stream) {
  static auto copy = Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
  static auto sync =
      Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");
  return copy(h, d, n, cudaMemcpyDeviceToHost, stream) == cudaSuccess &&
         sync(stream) == cudaSuccess;
}
bool Capture(const std::string& s, const void* d, size_t n,
             cudaStream_t stream) {
  std::vector<unsigned char> v(n);
  return Read(v.data(), d, n, stream) && Save(s, v.data(), n);
}
}  // namespace
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t* k, const void* fn) {
  static auto real =
      Resolve<cudaError_t (*)(cudaKernel_t*, const void*)>("__cudaGetKernel");
  auto status = real(k, fn);
  if (status == cudaSuccess) {
    const char* n = nullptr;
    static auto name = Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");
    if (name(&n, fn) == cudaSuccess && n && std::strstr(n, "ple_layer_cu")) {
      const char* names[4] = {
          "DepthwiseConvAddKernel", "DepthwiseConvAddMultiSeqKernel",
          "PleConvUpdateStateKernel", "PleConvUpdateStateMultiSeqKernel"};
      for (int i = 0; i < 4; ++i)
        if (std::strstr(n, names[i])) kernel[i] = *k;
    }
  }
  return status;
}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t k, dim3 grid, dim3 block,
                                          void** a, size_t smem,
                                          cudaStream_t stream) {
  static auto real =
      Resolve<cudaError_t (*)(cudaKernel_t, dim3, dim3, void**, size_t,
                              cudaStream_t)>("__cudaLaunchKernel");
  int kind = -1;
  for (int i = 0; i < 4; ++i)
    if (k == kernel[i]) kind = i;
  bool take = false, ok = true;
  int phase = 0, t = 0, c = 0, kk = 4, dil = 3, len = 9;
  std::string base;
  if (std::getenv("Q4T_PLE_CAPTURE_DIR") && kind >= 0) {
    bool multi = kind % 2;
    phase = multi ? 1 : 0;
    if (kind < 2) {
      t = *static_cast<int*>(a[multi ? 7 : 6]);
      c = *static_cast<int*>(a[multi ? 8 : 7]);
      kk = *static_cast<int*>(a[multi ? 9 : 8]);
      dil = *static_cast<int*>(a[multi ? 10 : 9]);
      len = *static_cast<int*>(a[multi ? 11 : 10]);
    } else {
      t = multi ? int(grid.y) : *static_cast<int*>(a[2]);
      c = *static_cast<int*>(a[3]);
      len = *static_cast<int*>(a[4]);
    }
    if (t == (multi ? 1 : 4096) && (!multi || counts[1][0] == 1)) {
      take = counts[kind / 2][phase]++ == 0;
    }
    if (take) {
      base = std::string(std::getenv("Q4T_PLE_CAPTURE_DIR")) +
             (phase ? "/decode" : "/prefill");
      ok = c == 10240 && kk == 4 && dil == 3 && len == 9 && block.x == 256 &&
           block.y == 1 && block.z == 1 && smem == 0;
      if (multi) {
        int seq = -1;
        ok = ok && Read(&seq, Ptr<int>(a, kind < 2 ? 6 : 2), 4, stream) &&
             seq == 0;
      }
      if (kind < 2) {
        input[phase] = Ptr<uint16_t>(a, 0);
        state[phase] = Ptr<uint16_t>(a, 2);
        int rows = phase ? 1 : t;
        ok = ok && Ptr<uint16_t>(a, 4) &&
             Capture(base + ".x.bf16", input[phase] + size_t(t - rows) * c,
                     size_t(rows) * c * 2, stream) &&
             Capture(base + ".weights.bf16", Ptr<uint16_t>(a, 1),
                     size_t(c) * kk * 2, stream) &&
             Capture(base + ".state-before.bf16", state[phase],
                     size_t(c) * len * 2, stream) &&
             Capture(base + ".gated.bf16", Ptr<uint16_t>(a, 3),
                     size_t(t) * c * 2, stream) &&
             Capture(base + ".trunk.bf16", Ptr<uint16_t>(a, 4),
                     size_t(t) * c * 2, stream);
      } else {
        ok = ok && Ptr<uint16_t>(a, 0) == state[phase] &&
             Ptr<uint16_t>(a, 1) == input[phase] &&
             Capture(base + ".update-before.bf16", Ptr<uint16_t>(a, 0),
                     size_t(c) * len * 2, stream);
      }
    }
  }
  auto status = real(k, grid, block, a, smem, stream);
  if (take && status == cudaSuccess) {
    if (kind < 2)
      ok = ok && Capture(base + ".output.bf16", Ptr<uint16_t>(a, 5),
                         size_t(t) * c * 2, stream);
    else
      ok = ok && Capture(base + ".state-after.bf16", Ptr<uint16_t>(a, 0),
                         size_t(c) * len * 2, stream);
    char meta[200];
    int n = std::snprintf(
        meta, sizeof(meta),
        "{\"kind\":%d,\"phase\":%d,\"tokens\":%d,\"channels\":%d,\"kernel\":%d,"
        "\"dilation\":%d,\"state_len\":%d,\"ok\":%s}\n",
        kind, phase, t, c, kk, dil, len, ok ? "true" : "false");
    if (n > 0 && size_t(n) < sizeof(meta))
      Save(base + ".kind-" + std::to_string(kind) + ".json", meta, n);
    std::fprintf(stderr, "[ple-conv] kind=%d phase=%d ok=%d\n", kind, phase,
                 ok);
  }
  return status;
}
