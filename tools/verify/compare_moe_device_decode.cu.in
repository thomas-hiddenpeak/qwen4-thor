#include <algorithm>
#include <bit>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <numeric>
#include <random>
#include <tuple>
#include <type_traits>
#include <vector>

#include "q4t/quant/fp4_gemm.h"
#include "q4t/quant/format.h"
#include "q4t/quant/swizzle.h"

@CANDIDATE@

namespace original {
using namespace q4t::quant;
@ORIGINAL_KERNELS@
}  // namespace original

void Check(cudaError_t s) {
  if (s != cudaSuccess) {
    std::fprintf(stderr, "%s\n", cudaGetErrorString(s));
    std::exit(2);
  }
}
void Check(const q4t::Status& s) {
  if (!s) {
    std::fprintf(stderr, "%s\n", s.message().c_str());
    std::exit(2);
  }
}
void Check(q4t::quant::Fp4GemmResult s) {
  if (s.status != CUBLAS_STATUS_SUCCESS || !s.has_algo) std::exit(2);
}

template <typename T>
struct Buffer {
  T* data = nullptr;
  size_t count;
  explicit Buffer(size_t n) : count(n) {
    Check(cudaMalloc(&data, n * sizeof(T)));
  }
  ~Buffer() { cudaFree(data); }
  void Upload(const std::vector<T>& v) {
    Check(cudaMemcpy(data, v.data(), v.size() * sizeof(T),
                     cudaMemcpyHostToDevice));
  }
  std::vector<T> Read() const {
    std::vector<T> v(count);
    Check(
        cudaMemcpy(v.data(), data, count * sizeof(T), cudaMemcpyDeviceToHost));
    return v;
  }
};

size_t mismatches = 0, nonfinite = 0, values = 0;
template <typename T>
void Compare(const std::vector<T>& a, const std::vector<T>& b,
             const char* stage) {
  const size_t before = mismatches;
  for (size_t i = 0; i < a.size(); ++i) {
    ++values;
    if constexpr (std::is_same_v<T, float>) {
      mismatches +=
          std::bit_cast<uint32_t>(a[i]) != std::bit_cast<uint32_t>(b[i]);
      nonfinite += !std::isfinite(a[i]) || !std::isfinite(b[i]);
    } else {
      mismatches += a[i] != b[i];
      if constexpr (std::is_same_v<T, uint16_t>) {
        nonfinite += (a[i] & 0x7f80) == 0x7f80 || (b[i] & 0x7f80) == 0x7f80;
      }
    }
  }
  if (before != mismatches) {
    std::fprintf(stderr, "%s: %zu bit mismatches\n", stage,
                 mismatches - before);
  }
}

int main() {
  using namespace q4t::quant;
  constexpr int hs = 2560, mi = 640, slots = 10, experts = 512;
  constexpr size_t gws_bytes = 32 * 1024 * 1024;
  const size_t gu_bytes = mi * hs, dn_bytes = hs * mi / 2;
  const size_t gu_sf = SfBufferSize(2 * mi, hs), dn_sf = SfBufferSize(hs, mi);
  Buffer<uint8_t> gu_w(experts * gu_bytes), dn_w(experts * dn_bytes);
  Buffer<uint8_t> gu_s(experts * gu_sf), dn_s(experts * dn_sf);
  Buffer<float> gu_global(experts), dn_global(experts), gu_input(experts),
      dn_input(experts);
  std::vector<float> hgg(experts), hdg(experts), hgi(experts), hdi(experts);
  for (int e = 0; e < experts; ++e) {
    hgg[e] = 1.0f / (8 + e % 13);
    hdg[e] = 1.0f / (7 + e % 17);
    hgi[e] = 0.5f + (e % 5) * 0.125f;
    hdi[e] = 0.25f + (e % 7) * 0.125f;
  }
  gu_global.Upload(hgg);
  dn_global.Upload(hdg);
  gu_input.Upload(hgi);
  dn_input.Upload(hdi);
  MoEWeightLayout w;
  w.E = experts;
  w.hs = hs;
  w.moe_is = mi;
  w.gu_packed = gu_w.data;
  w.dn_packed = dn_w.data;
  w.gu_sf = gu_s.data;
  w.dn_sf = dn_s.data;
  w.gu_w_scale2 = gu_global.data;
  w.dn_w_scale2 = dn_global.data;
  w.gu_input_scale = gu_input.data;
  w.dn_input_scale = dn_input.data;
  std::mt19937 rng(20260921);
  const std::vector<int32_t> selected{0,  511, 43,  256, 1,
                                      98, 333, 127, 444, 200};
  for (int e : selected) {
    for (auto [base, bytes, sf] : {std::tuple{gu_w.data, gu_bytes, false},
                                   {dn_w.data, dn_bytes, false},
                                   {gu_s.data, gu_sf, true},
                                   {dn_s.data, dn_sf, true}}) {
      std::vector<uint8_t> data(bytes);
      for (auto& v : data) v = sf ? 24 + rng() % 24 : rng() & 255;
      Check(cudaMemcpy(base + e * bytes, data.data(), bytes,
                       cudaMemcpyHostToDevice));
    }
  }
  Buffer<uint8_t> workspace(MoEWorkspace::RequiredBytes(1, slots, hs, mi));
  MoEWorkspace ws;
  ws.a_packed_bytes = slots * hs / 2;
  ws.a_sf_bytes = SfBufferSize(slots, hs);
  ws.gu_out_bytes = slots * 2 * mi * sizeof(uint16_t);
  ws.dn_out_bytes = slots * hs * sizeof(uint16_t);
  ws.Init(workspace.data);
  Buffer<uint8_t> gws(gws_bytes), old_packed(hs / 2),
      old_sf(SfBufferSize(1, hs));
  Buffer<uint8_t> descriptors(kBatchBytes + slots * kScaleStride);
  auto* batch = reinterpret_cast<DeviceBatch*>(descriptors.data);
  uint8_t* sf = descriptors.data + kBatchBytes;
  Buffer<uint16_t> x(hs), old_gu(slots * 2 * mi), old_dn(slots * hs);
  Buffer<float> old_y(hs), new_y(hs), router(slots);
  Buffer<int32_t> ids(slots), token_list(experts), row_map(slots);
  std::vector<int32_t> identity(slots);
  std::iota(identity.begin(), identity.end(), 0);
  row_map.Upload(identity);
  cudaStream_t stream;
  Check(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
  int cases = 0;
  for (int family = 0; family < 4; ++family) {
    for (int order = 0; order < 3; ++order) {
      auto eids = selected;
      if (order == 1) std::reverse(eids.begin(), eids.end());
      if (order == 2) std::rotate(eids.begin(), eids.begin() + 3, eids.end());
      ids.Upload(eids);
      std::vector<int32_t> tokens(experts, 0);
      for (int slot = 0; slot < slots; ++slot) tokens[eids[slot]] = slot;
      token_list.Upload(tokens);
      std::vector<uint16_t> h_x(hs);
      for (int i = 0; i < hs; ++i) {
        float v = (static_cast<int>(rng() % 2049) - 1024) / 2048.0f;
        if (family == 1) v = (i & 1) ? -0.0f : 0.0f;
        if (family == 2) v = (i & 1) ? -3.0f : 3.0f;
        if (family == 3) v *= 0.001f;
        h_x[i] = std::bit_cast<uint16_t>(__float2bfloat16_rn(v));
      }
      x.Upload(h_x);
      std::vector<float> h_router(slots), initial(hs);
      for (int i = 0; i < slots; ++i) h_router[i] = (i + 1) / 55.0f;
      for (int i = 0; i < hs; ++i) initial[i] = (i % 7 - 3) * 0.03125f;
      router.Upload(h_router);
      old_y.Upload(initial);
      new_y.Upload(initial);
      Check(MoEDeviceDecode(x.data, ids.data, router.data, new_y.data, w, ws,
                            gws.data, gws_bytes, stream));
      Check(cudaStreamSynchronize(stream));
      // Reference uses original quant kernels and the original per-expert GEMM.
      for (int slot = 0; slot < slots; ++slot) {
        const int e = eids[slot];
        original::GatherQuantKernel<<<1, 256, 0, stream>>>(
            x.data, token_list.data, 1, e, slots, 1, hs, SfNumGtiles(hs),
            gu_input.data, old_packed.data, old_sf.data);
        Check(Fp4Gemm(w.gu_packed_expert(e), w.gu_sf_expert(e), old_packed.data,
                      old_sf.data, old_gu.data + slot * 2 * mi, 1, 2 * mi, hs,
                      hgg[e] * hgi[e], 1.0f, gws.data, gws_bytes, stream));
        original::SwiGLUQuantKernel<<<1, 256, 0, stream>>>(
            old_gu.data + slot * 2 * mi, old_packed.data, old_sf.data, 1, mi,
            SfNumGtiles(mi), hdi[e]);
        Check(Fp4Gemm(w.dn_packed_expert(e), w.dn_sf_expert(e), old_packed.data,
                      old_sf.data, old_dn.data + slot * hs, 1, hs, mi,
                      hdg[e] * hdi[e], 1.0f, gws.data, gws_bytes, stream));
      }
      original::CombineGroupedKernel<<<10, 256, 0, stream>>>(
          old_dn.data, row_map.data, router.data, slots, hs, 1, old_y.data);
      Check(cudaGetLastError());
      Check(cudaStreamSynchronize(stream));
      std::vector<uint16_t> got_gu(slots * 2 * mi), got_dn(slots * hs);
      Check(cudaMemcpy(got_gu.data(), ws.gu_out, got_gu.size() * 2,
                       cudaMemcpyDeviceToHost));
      Check(cudaMemcpy(got_dn.data(), ws.dn_out, got_dn.size() * 2,
                       cudaMemcpyDeviceToHost));
      Compare(old_gu.Read(), got_gu, "GU BF16");
      Compare(old_dn.Read(), got_dn, "DN BF16");
      Compare(old_y.Read(), new_y.Read(), "FP32 combine");
      // Inspect active payload bytes and row-zero SF codes, never padding.
      for (bool down : {false, true}) {
        const int k = down ? mi : hs;
        StageWeights sw{down ? w.dn_packed : w.gu_packed,
                        down ? w.dn_sf : w.gu_sf,
                        down ? w.dn_w_scale2 : w.gu_w_scale2,
                        down ? w.dn_input_scale : w.gu_input_scale,
                        down ? dn_bytes : gu_bytes,
                        down ? dn_sf : gu_sf};
        if (down) {
          PrepareMoEDecodeKernel<true><<<2, 256, 0, stream>>>(
              ws.gu_out, ids.data, sw, batch, ws.a_packed, sf, ws.dn_out);
        } else {
          PrepareMoEDecodeKernel<false><<<7, 256, 0, stream>>>(
              x.data, ids.data, sw, batch, ws.a_packed, sf, ws.gu_out);
        }
        Check(cudaGetLastError());
        for (int slot = 0; slot < slots; ++slot) {
          const int e = eids[slot];
          if (down) {
            original::SwiGLUQuantKernel<<<1, 256, 0, stream>>>(
                old_gu.data + slot * 2 * mi, old_packed.data, old_sf.data, 1,
                mi, SfNumGtiles(mi), hdi[e]);
          } else {
            original::GatherQuantKernel<<<1, 256, 0, stream>>>(
                x.data, token_list.data, 1, e, slots, 1, hs, SfNumGtiles(hs),
                gu_input.data, old_packed.data, old_sf.data);
          }
          Check(cudaGetLastError());
          Check(cudaStreamSynchronize(stream));
          auto expected = old_packed.Read();
          expected.resize(k / 2);
          std::vector<uint8_t> actual(k / 2);
          Check(cudaMemcpy(actual.data(), ws.a_packed + slot * kPackedStride,
                           actual.size(), cudaMemcpyDeviceToHost));
          Compare(expected, actual, down ? "DN packed" : "GU packed");
          auto expected_sf = old_sf.Read();
          std::vector<uint8_t> actual_sf(kScaleStride);
          Check(cudaMemcpy(actual_sf.data(), sf + slot * kScaleStride,
                           actual_sf.size(), cudaMemcpyDeviceToHost));
          std::vector<uint8_t> a, b;
          for (int g = 0; g < k / 16; ++g) {
            const size_t off = SfOffset(0, g, SfNumGtiles(k));
            a.push_back(expected_sf[off]);
            b.push_back(actual_sf[off]);
          }
          Compare(a, b, down ? "DN scales" : "GU scales");
        }
      }
      ++cases;
    }
  }
  Check(cudaStreamDestroy(stream));
  std::printf(
      "{\"cases\":%d,\"values\":%zu,\"mismatches\":%zu,"
      "\"nonfinite\":%zu}\n",
      cases, values, mismatches, nonfinite);
  return (mismatches || nonfinite) ? 1 : 0;
}
