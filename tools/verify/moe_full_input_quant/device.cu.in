#include <cuda_bf16.h>
#include <cuda_fp8.h>
#include <cuda_runtime.h>
#include "q4t/quant/format.h"
#include "common.h"
#define CU(x) do{if((x)!=cudaSuccess)throw std::runtime_error(#x);}while(0)
struct Result{float ratio;uint8_t legacy,native;};
__global__ void Ratios(const uint16_t*x,const int32_t*flat,const int32_t*experts,const float*scales,Result*out){size_t i=blockIdx.x*blockDim.x+threadIdx.x;if(i>=kGroups)return;int row=i/160,g=i%160,t=flat[row]/10,e=experts[row];float maximum=0;for(int j=0;j<16;++j){float v=__uint_as_float(uint32_t(x[size_t(t)*2560+g*16+j])<<16);maximum=fmaxf(maximum,fabsf(v));}float block=maximum>0?maximum/6.f:1.f;float ratio=block/scales[e];out[i]={ratio,q4t::quant::FloatToE4m3(ratio),__nv_cvt_float_to_fp8(ratio,__NV_SATFINITE,__NV_E4M3)};}
int main(int argc,char**argv){try{if(argc!=5)throw std::runtime_error("captures prior outputs layer");int l=std::stoi(argv[4]);std::string b=std::string(argv[1])+"/layer-"+std::to_string(l),o=std::string(argv[3])+"/layer-"+std::to_string(l);auto x=Read<uint16_t>(std::string(argv[2])+"/hc-"+std::to_string(l)+".prefill.mix.mlp.output.bf16",4096*2560);auto flat=Read<int32_t>(b+".lists.i32",kRows),offset=Read<int32_t>(b+".offsets.i32",513);auto scales=Read<float>(b+".input-scales.f32",512);std::vector<int32_t>experts(kRows);for(int e=0;e<512;++e)for(int r=offset[e];r<offset[e+1];++r)experts[r]=e;
 uint16_t*dx;int32_t *df,*de;float*ds;Result*dr;CU(cudaMalloc(&dx,x.size()*2));CU(cudaMalloc(&df,kRows*4));CU(cudaMalloc(&de,kRows*4));CU(cudaMalloc(&ds,512*4));CU(cudaMalloc(&dr,kGroups*sizeof(Result)));CU(cudaMemcpy(dx,x.data(),x.size()*2,cudaMemcpyHostToDevice));CU(cudaMemcpy(df,flat.data(),kRows*4,cudaMemcpyHostToDevice));CU(cudaMemcpy(de,experts.data(),kRows*4,cudaMemcpyHostToDevice));CU(cudaMemcpy(ds,scales.data(),512*4,cudaMemcpyHostToDevice));Ratios<<<(kGroups+255)/256,256>>>(dx,df,de,ds,dr);CU(cudaGetLastError());std::vector<Result>r(kGroups);CU(cudaMemcpy(r.data(),dr,r.size()*sizeof(Result),cudaMemcpyDeviceToHost));CU(cudaFree(dx));CU(cudaFree(df));CU(cudaFree(de));CU(cudaFree(ds));CU(cudaFree(dr));std::vector<float>ratios(kGroups);std::vector<uint8_t>legacy(kGroups),native(kGroups);for(size_t i=0;i<kGroups;++i){ratios[i]=r[i].ratio;legacy[i]=r[i].legacy;native[i]=r[i].native;}Save(o+".device-ratios.f32",ratios);Save(o+".legacy.sf",legacy);Save(o+".native.sf",native);return 0;
}catch(const std::exception&e){std::fprintf(stderr,"%s\n",e.what());return 2;}}
