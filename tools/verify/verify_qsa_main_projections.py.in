from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,subprocess,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-main-projections-20260923';c=o/'observed-captures';old=root/'.q4t-work/e2e/qsa-qk-transform-20260923/observed-captures';hc=root/'.q4t-work/e2e/hc-projection-reference-20260923';replayed=o/'replayed'
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
def dec(v):return (v.astype(np.uint32)<<16).view(np.float32).astype(np.float64)
def rnd(v):
 b=np.asarray(v,dtype=np.float32).view(np.uint32);return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype(np.uint16)
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output']
assert all((p/f).stat().st_size==0 for f in ['build.log','decode-build.log','prefill-build.log'])
replayed.mkdir(exist_ok=False);bind={}
for f in old.iterdir():
 if f.suffix not in ['.bf16','.i32','.f32','.json','.bin']:continue
 assert f.read_bytes()==(c/f.name).read_bytes(),f.name;bind[f.name]=sha(f)
save(o/'previous-binding.json',{'files':len(bind),'all_equal':True,'hashes':bind})
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];hc_manifest=json.loads((hc/'artifact-binding.json').read_text());assert sha(hc/'previous-binding.json')==hc_manifest['previous-binding.json'];hc_hashes={x['file']:x['sha256'] for x in json.loads((hc/'previous-binding.json').read_text())['records']};records=[];bound={}
for l in range(3,48,4):
 for phase in ['prefill','decode']:
  b=str(c/f'layer-{l}.{phase}');hci=hc/'observed-captures'/f'hc-{l}.{phase}.mix.attn.output.bf16';hco=hc/'observed-captures'/f'hc-{l}.{phase}.fused.block.bf16'
  for h in [hci,hco]:assert sha(h)==hc_hashes[h.name];bound[str(h.relative_to(root))]=sha(h)
  for stage,n,k,key in [('qg',12288,2560,'q_proj'),('k',512,2560,'k_proj'),('v',512,2560,'v_proj'),('out',2560,6144,'o_proj')]:
   base=b+'.main-'+stage;wfile=Path(base+'.weights.bf16');xfile=Path(base+'.input.bf16');yfile=Path(base+'.output.bf16');name=f'model.language_model.layers.{l}.self_attn.{key}.weight'
   with (model/index[name]).open('rb') as f:
    size=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(size))[name];assert info['dtype']=='BF16' and info['shape']==[n,k];a,z=info['data_offsets'];f.seek(8+size+a);assert f.read(z-a)==wfile.read_bytes()
   if stage=='out':
    assert xfile.read_bytes()==Path(b+'.attention-output.bf16').read_bytes();assert yfile.read_bytes()==hco.read_bytes()
   else:
    assert xfile.read_bytes()==hci.read_bytes()==Path(b+'.projection-iq.input.bf16').read_bytes()
    if stage=='qg':assert yfile.read_bytes()==Path(b+'.transform-norm.qg.bf16').read_bytes()
    elif stage=='k':assert yfile.read_bytes()==Path(b+'.transform-norm.k-before.bf16').read_bytes()
    else:assert yfile.read_bytes()==Path(b+'.write-v.bf16').read_bytes()[-1024:]
   w=dec(np.fromfile(wfile,dtype='<u2')).reshape(n,k);x=dec(np.fromfile(xfile,dtype='<u2'));y=np.fromfile(yfile,dtype='<u2');ref=w@x;bits=rnd(ref);bad=np.flatnonzero(bits!=y);del w
   np.savez(replayed/f'layer-{l}.{phase}.main-{stage}.fp64.npz',values=ref,bits=bits)
   records.append({'layer':l,'phase':phase,'stage':stage,'elements':n,'fp64_mismatches':len(bad),'indices':bad.tolist(),'weights_sha256':sha(wfile),'input_sha256':sha(xfile),'output_sha256':sha(yfile)})
save(o/'hc-binding.json',bound)
save(o/'projection-reference.json',{'records':records,'prefill_fp64_mismatches':sum(r['fp64_mismatches'] for r in records if r['phase']=='prefill'),'decode_fp64_mismatches':sum(r['fp64_mismatches'] for r in records if r['phase']=='decode'),'scope':'Actual96 projection calls,last prefill/first decode,12 full attention layers. Checkpoint weights exact; main inputs match gated HC outputs across runs and current indexer input; output projection matches prior HC fused block input.','limitation':'Not full sequence or whole model correctness. Prefill recorded algorithm replay is not independent cuBLAS arithmetic proof.'})
exits={}
for name in ['decode','prefill']:
 with (o/(name+'.stdout')).open('w') as out,(o/(name+'.stderr')).open('w') as err:exits[name]=subprocess.run([str(p/name),str(c),str(replayed)],stdout=out,stderr=err).returncode
 save(o/'reference-exit.json',exits);assert exits[name]==0
 r=json.loads((o/(name+'.stdout')).read_text());assert len(r['records'])==48
 for x in r['records']:
  suffix='.cpu.bf16' if name=='decode' else '.replay.bf16';b=f"layer-{x['layer']}.{name}.main-{x['stage']}";assert (replayed/(b+suffix)).read_bytes()==(c/(b+'.output.bf16')).read_bytes();assert x['mismatches']==0
 assert r['total_mismatches']==0
 save(o/(name+'-reference.json'),r)
print('old_files',len(bind),'FP64 prefill/decode',sum(r['fp64_mismatches'] for r in records if r['phase']=='prefill'),sum(r['fp64_mismatches'] for r in records if r['phase']=='decode'),'specified-order/replay exact',12*15872*2)
