def tensor(key,expected_shape):
 f=model/index[key]
 with f.open('rb') as s:
  if f not in headers:
   size=struct.unpack('<Q',s.read(8))[0];headers[f]=(size,json.loads(s.read(size)))
  size,h=headers[f];info=h[key];assert info['dtype']=='BF16' and info['shape']==expected_shape;a,b=info['data_offsets'];offset=8+size+a;s.seek(offset);raw=s.read(b-a)
 assert len(raw)==int(np.prod(expected_shape))*2;st=f.stat();weights.append({'key':key,'file':str(f),'offset':offset,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns});return raw
