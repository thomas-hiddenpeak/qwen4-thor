from pathlib import Path
import hashlib,json,struct,shutil,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/gdn-prefill-reference-20260923';c=o/'observed-captures';d=o/'reference'
def sha(f):
 h=hashlib.sha256()
 with f.open('rb') as stream:
  for block in iter(lambda:stream.read(4*1024*1024),b''):h.update(block)
 return h.hexdigest()
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
assert sha(root/'build/q4t')=='2392f6b1fb33f28744d0e63812e47be98b4c6f224e22f087bd627d050f8bbe9e'
r=json.loads((o/'recurrence-reference.json').read_text());assert r['complete'] and r['state_mismatches']==r['output_mismatches']==0 and len(r['records'])==36
assert sum(x['state_elements'] for x in r['records'])==28311552 and sum(x['output_elements'] for x in r['records'])==905969664
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');index=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];bindings=[]
for x in r['records']:
 l=x['layer'];b='layer-'+str(l)
 assert sha(c/(b+'.prefill-state-final.f32'))==sha(d/(b+'.v1.state.f32'))
 assert sha(c/(b+'.prefill-y.bf16'))==sha(d/(b+'.v1.y.bf16'))
 state=np.fromfile(c/(b+'.prefill-state-before.f32'),dtype='<u4');assert len(state)==786432 and not np.count_nonzero(state)
 assert np.isfinite(np.fromfile(d/(b+'.parameters.f32'),dtype='<f4')).all()
 for suffix,tag in [('dt_bias','dt-bias'),('A_log','a-log')]:
  name=f'model.language_model.layers.{l}.linear_attn.{suffix}';file=model/index[name];st=file.stat()
  with file.open('rb') as f:
   n=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(n))[name];assert info['dtype']=='BF16' and info['shape']==[48];a,z=info['data_offsets'];f.seek(8+n+a);raw=f.read(z-a)
  assert raw==(c/(b+'.prefill-'+tag+'.bf16')).read_bytes() and file.stat()==st
  bindings.append({'tensor':name,'path':str(file),'offset':8+n+a,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'size':st.st_size,'mtime_ns':st.st_mtime_ns})
for name,h in json.loads((o/'previous-binding.json').read_text()).items():assert sha(c/name)==h
for suffix,actual,dt in [('state.f32','prefill-state-final.f32','<u4'),('y.bf16','prefill-y.bf16','<u2')]:
 a=np.fromfile(d/('layer-0.v0.'+suffix),dtype=dt);b=np.fromfile(c/('layer-0.'+actual),dtype=dt);np.flatnonzero(a!=b).astype('<i4').tofile(d/('layer-0.v0.'+suffix+'.difference-indices.i32'))
save(o/'checkpoint-binding.json',bindings)
for f in p.iterdir():
 if f.is_file():shutil.copy2(f,o/f.name)
save(o/'artifact-binding.json',{str(f.relative_to(o)):sha(f) for f in sorted(o.rglob('*')) if f.is_file() and f.name!='artifact-binding.json'})
print('audit passed:36 layers x4096 tokens,28311552 final state FP32 and905969664 output BF16 exact;normalization source still pending;324 previous snapshots unchanged')
