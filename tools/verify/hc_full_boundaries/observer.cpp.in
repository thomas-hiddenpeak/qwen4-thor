#include <cuda_runtime_api.h>
#include <dlfcn.h>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
namespace {
std::atomic<cudaKernel_t> kernels[4]{};int counts[4]{};
template<class T>T Resolve(const char*n){auto f=reinterpret_cast<T>(dlsym(RTLD_NEXT,n));if(!f)std::_Exit(127);return f;}
template<class T>T* Ptr(void**a,int i){return *static_cast<T**>(a[i]);}
bool Save(const std::string&n,const void*p,size_t bytes){FILE*f=std::fopen(n.c_str(),"wb");if(!f)return false;bool ok=std::fwrite(p,1,bytes,f)==bytes;return std::fclose(f)==0&&ok;}
bool Capture(const std::string&n,const void*p,size_t bytes,cudaStream_t stream){static auto copy=Resolve<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");static auto sync=Resolve<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");std::vector<unsigned char>b(bytes);return copy(b.data(),p,bytes,cudaMemcpyDeviceToHost,stream)==cudaSuccess&&sync(stream)==cudaSuccess&&Save(n,b.data(),bytes);}
}
extern "C" cudaError_t __cudaGetKernel(cudaKernel_t*k,const void*fn){static auto real=Resolve<cudaError_t(*)(cudaKernel_t*,const void*)>("__cudaGetKernel");auto s=real(k,fn);if(s==cudaSuccess){const char*n=nullptr;static auto name=Resolve<decltype(&cudaFuncGetName)>("cudaFuncGetName");if(name(&n,fn)==cudaSuccess&&n&&std::strstr(n,"hyperconnection_cu")){const char*names[4]={"GroupedRmsNormKernel","CombineAndGroupedNormKernel","CombineWithGateKernel","MixGatePairKernel"};for(int i=0;i<4;++i)if(std::strstr(n,names[i]))kernels[i]=*k;}}return s;}
extern "C" cudaError_t __cudaLaunchKernel(cudaKernel_t k,dim3 grid,dim3 block,void**a,size_t smem,cudaStream_t stream){
 static auto real=Resolve<cudaError_t(*)(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t)>("__cudaLaunchKernel");const char*dir=std::getenv("Q4T_GDN_CAPTURE_DIR");int kind=-1;for(int i=0;i<4;++i)if(k==kernels[i])kind=i;int ti=kind==0?3:kind==1?6:kind==2?4:3;bool take=dir&&kind>=0&&*static_cast<int*>(a[ti])==4096;bool ok=true;std::string base;int ix=-1;
 constexpr size_t trunk=size_t(4096)*10240*2,mixed=size_t(4096)*2560*2,gate=size_t(4096)*4*2;
 if(take){ix=counts[kind]++;int layer=kind==3?ix/2:ix;const char*names[4]={"read","fused","write","mix"};base=std::string(dir)+"/hc-"+std::to_string(layer)+".prefill."+names[kind];if(kind==3)base+=ix%2?".mlp":".attn";ok=ix<(kind==3?96:48)&&*static_cast<int*>(a[ti+1])==4&&*static_cast<int*>(a[ti+2])==2560;
  if(kind==0||kind==1){float eps=*static_cast<float*>(a[kind==0?6:9]);ok=ok&&Capture(base+".norm-weights.bf16",Ptr<uint16_t>(a,kind==0?1:3),20480,stream)&&Save(base+".eps.f32",&eps,4);}
  if(kind==0)ok=ok&&Capture(base+".trunk.bf16",Ptr<uint16_t>(a,0),trunk,stream);
  if(kind==1||kind==2)ok=ok&&Capture(base+".block.bf16",Ptr<uint16_t>(a,0),mixed,stream)&&Capture(base+".residual.bf16",Ptr<uint16_t>(a,1),trunk,stream)&&Capture(base+".gate.bf16",Ptr<uint16_t>(a,2),gate,stream);
  if(kind==3)ok=ok&&Capture(base+".up.bf16",Ptr<uint16_t>(a,0),trunk,stream)&&Capture(base+".normed.bf16",Ptr<uint16_t>(a,1),trunk,stream);
 }
 auto s=real(k,grid,block,a,smem,stream);if(!take||s!=cudaSuccess)return s;
 int oi=kind==0?2:kind==1?4:kind==2?3:2;ok=ok&&Capture(base+".output.bf16",Ptr<uint16_t>(a,oi),kind==3?mixed:trunk,stream);if(kind==1)ok=ok&&Capture(base+".normed.bf16",Ptr<uint16_t>(a,5),trunk,stream);char meta[180];int n=std::snprintf(meta,sizeof(meta),"{\"kind\":%d,\"index\":%d,\"tokens\":4096,\"ok\":%s}\n",kind,ix,ok?"true":"false");if(n>0&&size_t(n)<sizeof(meta))Save(base+".hc.json",meta,n);std::fprintf(stderr,"[hc-full] kind=%d index=%d ok=%d\n",kind,ix,ok);return s;
}
