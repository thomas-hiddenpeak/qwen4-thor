from pathlib import Path
import os
os.environ['OPENBLAS_NUM_THREADS']='1'
import json,struct,hashlib,shutil,subprocess,numpy as np
p=Path(__file__).resolve().parent;root=p.parents[2];o=root/'.q4t-work/e2e/qsa-query-transform-20260923';c=o/'observed-captures';old=root/'.q4t-work/e2e/qsa-indexer-gemm-20260923/observed-captures';data=o/'data'
def save(f,v):f.write_text(json.dumps(v,indent=2)+'\n')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
def dec(b):return (np.asarray(b,dtype=np.uint16).astype(np.uint32)<<16).view(np.float32)
def rnd(v):
 b=np.asarray(v,dtype=np.float32).view(np.uint32);return ((b+np.uint32(0x7fff)+((b>>16)&1))>>16).astype(np.uint16)
assert json.loads((o/'exit.json').read_text())['observer_preserved_tested_output']
assert all((p/f).stat().st_size==0 for f in ['build.log','cpu-build.log','nonlinear-build.log'])
data.mkdir(exist_ok=False)
bind={}
for f in old.iterdir():
 if f.suffix not in ['.bf16','.i32','.f32','.json','.bin']:continue
 assert f.read_bytes()==(c/f.name).read_bytes(),f.name
 bind[f.name]=sha(f)
save(o/'previous-binding.json',{'files':len(bind),'all_equal':True,'hashes':bind})
model=Path('/home/rm01/models/dev/llm/garnermccloud/Qwen3.8-Flash-Next-NVFP4-SSD-Stream');idx=json.loads((model/'model.safetensors.index.json').read_text())['weight_map'];records=[]
for l in range(3,48,4):
 for phase in ['prefill','decode']:
  base=str(c/f'layer-{l}.{phase}');b=str(data/f'layer-{l}.{phase}')
  weight=np.fromfile(base+'.iq-norm.bf16',dtype='<u2');x=dec(np.fromfile(base+'.iq-before.bf16',dtype='<u2')).reshape(4,128);expected=np.fromfile(base+'.iq.bf16',dtype='<u2').reshape(4,128)
  params=np.fromfile(base+'.iq-params.f32',dtype='<f4');positions=np.fromfile(base+'.iq-positions.i32',dtype='<i4');geom=np.fromfile(base+'.iq-geometry.i32',dtype='<i4')
  assert params[0]==1e7 and params[1]==np.float32(1e-6)
  assert geom[:4].tolist()==[4,128,64,208896] and geom[5]==128 and geom[6]==(4096 if phase=='prefill' else 1)
  assert positions[0]==(4095 if phase=='prefill' else 4096)
  for row in range(3):assert positions[row+1]==np.fromfile(base+f'.rope-{row}.i32',dtype='<i4')[positions[0]]
  name=f'model.language_model.layers.{l}.self_attn.indexer.q_layernorm.weight'
  with (model/idx[name]).open('rb') as f:
   size=struct.unpack('<Q',f.read(8))[0];info=json.loads(f.read(size))[name];assert info['dtype']=='BF16' and info['shape']==[128];a,z=info['data_offsets'];f.seek(8+size+a);assert f.read(z-a)==weight.tobytes()
  values=(x*x).reshape(4,4,32)
  for off in [16,8,4,2,1]:values=values+values[:,:,np.arange(32)^off]
  sums=np.zeros(4,dtype=np.float32)
  for warp in range(4):sums+=values[:,warp,0]
  variance=sums/np.float32(128)+params[1];x.tofile(b+'.mean.f32');variance.tofile(b+'.variance.f32')
  np.broadcast_to(positions[1:][(np.arange(64)%32)%3],(4,64)).astype('<i4').tofile(b+'.positions.i32')
  for src,dst in [('.iq-norm.bf16','.weight.bf16'),('.iq.bf16','.expected.bf16'),('.iq-params.f32','.params.f32')]:shutil.copy2(base+src,b+dst)
  xd=x.astype(np.float64);norm=xd/np.sqrt(np.mean(xd*xd,axis=1,keepdims=True)+float(params[1]))*(1+dec(weight).astype(np.float64))
  for rounded in [False,True]:
   n=dec(rnd(norm)).astype(np.float64) if rounded else norm
   out=n.copy();ang=positions[1:][np.arange(32)%3]*float(params[0])**(-2*np.arange(32)/64);co=np.cos(ang);si=np.sin(ang)
   out[:,:32]=n[:,:32]*co-n[:,32:64]*si;out[:,32:64]=n[:,:32]*si+n[:,32:64]*co
   bits=rnd(out);bad=np.flatnonzero(bits.ravel()!=expected.ravel());np.savez(b+f'.fp64-rounded-{rounded}.npz',norm=norm,output=out,bits=bits)
   records.append({'layer':l,'phase':phase,'fp64_with_norm_bf16':rounded,'elements':512,'mismatches':len(bad),'indices':bad.tolist()})
save(o/'fp64-reference.json',records)
save(o/'declared-variants.json',{'0':'CPU math, both halves fuse first product','1':'CPU math, both halves fuse second product','2':'Device math, both halves fuse first product','3':'Device math, both halves fuse second product','4':'CPU math, fuse current*cos in both halves','5':'Device math, fuse current*cos in both halves','note':'All include BF16 rounding between norm and rotation; final order requires separate compiled-code evidence, not selecting lowest mismatch.'})
exits={}
for name in ['nonlinear','cpu']:
 with (o/(name+'.stdout')).open('w') as out,(o/(name+'.stderr')).open('w') as err:exits[name]=subprocess.run([str(p/name),str(data)],stdout=out,stderr=err).returncode
 save(o/'reference-exit.json',exits);assert exits[name]==0
r=json.loads((o/'cpu.stdout').read_text());assert len(r['records'])==144
for x in r['records']:
 b=str(data/f"layer-{x['layer']}.{x['phase']}");bits=np.fromfile(b+f".variant-{x['variant']}.bf16",dtype='<u2');expect=np.fromfile(b+'.expected.bf16',dtype='<u2');bad=np.flatnonzero(bits!=expect);assert len(bad)==x['mismatches'];x['indices']=bad.tolist()
save(o/'query-reference.json',r)
print('old_files',len(bind),'FP64',sum(x['mismatches'] for x in records if not x['fp64_with_norm_bf16']),sum(x['mismatches'] for x in records if x['fp64_with_norm_bf16']),'variants',r['totals'])
