#include <cuda_runtime.h>
#include "common.h"
#define CU(x)                                             \
  do {                                                    \
    if ((x) != cudaSuccess) throw std::runtime_error(#x); \
  } while (0)
template <class T>
std::vector<T> Slice(const std::string& p, size_t first, size_t n,
                     size_t total) {
  std::ifstream f(p, std::ios::binary | std::ios::ate);
  if (!f || size_t(f.tellg()) != total * sizeof(T)) throw std::runtime_error(p);
  f.seekg(first * sizeof(T));
  std::vector<T> v(n);
  if (!f.read(reinterpret_cast<char*>(v.data()), n * sizeof(T)))
    throw std::runtime_error(p);
  return v;
}
__global__ void Elementary(const float* x, float* y, int n, bool gate) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) {
    if (gate) {
      float g = sqrtf(fabsf(x[i]) + 1e-6f) * (x[i] < 0 ? -1.f : 1.f);
      y[i] = 1.f / (1.f + __expf(-g));
    } else
      y[i] = rsqrtf(x[i]);
  }
}
int main(int argc, char** argv) {
  try {
    if (argc != 9)
      throw std::runtime_error(
          "input weights_or_query parameter actual output_prefix kind first "
          "rows");
    int kind = std::stoi(argv[6]), start = std::stoi(argv[7]),
        rows = std::stoi(argv[8]);
    if (kind < 0 || kind > 3 || start < 0 || rows < 1 || rows > 128 ||
        start + rows > 4096)
      throw std::runtime_error("range");
    std::string o = argv[5];
    bool gate = kind == 3;
    size_t n = size_t(rows) * 10240, groups = size_t(rows) * 4;
    auto x = Slice<uint16_t>(argv[1], size_t(start) * 10240, n,
                             size_t(4096) * 10240);
    auto w = gate ? Slice<uint16_t>(argv[2], size_t(start) * 10240, n,
                                    size_t(4096) * 10240)
                  : Read<uint16_t>(argv[2], 10240);
    float param = Read<float>(argv[3], 1)[0];
    auto actual =
        Slice<uint16_t>(argv[4], size_t(start) * (gate ? 4 : 10240),
                        gate ? groups : n, size_t(4096) * (gate ? 4 : 10240));
    std::vector<float> arg(groups), dev(groups);
    std::vector<double> high(groups);
    for (size_t b = 0; b < groups; ++b) {
      double total = 0;
      if (gate) {
        float sum = 0;
        for (int j = 0; j < 2560; ++j) {
          size_t i = b * 2560 + j;
          float a = B(x[i]), v = B(w[i]);
          sum = std::fma(a, v, sum);
          total = std::fma(double(a), double(v), total);
        }
        arg[b] = sum * param;
        high[b] = total * double(param);
      } else {
        float lane[32] = {};
        for (int t = 0; t < 32; ++t)
          for (int i = t; i < 320; i += 32) {
            size_t off = b * 2560 + i * 8;
            float v = B(x[off]), sum = v * v;
            for (int j = 1; j < 8; ++j) {
              v = B(x[off + j]);
              sum = std::fma(v, v, sum);
            }
            lane[t] += sum;
          }
        for (int off = 16; off > 0; off >>= 1) {
          float copy[32];
          std::memcpy(copy, lane, sizeof(lane));
          for (int t = 0; t < 32; ++t) lane[t] = copy[t] + copy[t ^ off];
        }
        arg[b] = lane[0] / 2560.f + param;
        for (int j = 0; j < 2560; ++j) {
          double v = B(x[b * 2560 + j]);
          total = std::fma(v, v, total);
        }
        high[b] = total / 2560. + double(param);
      }
    }
    Save(o + ".argument.f32", arg);
    Save(o + ".argument.f64", high);
    float *dx, *dy;
    CU(cudaMalloc(&dx, groups * 4));
    CU(cudaMalloc(&dy, groups * 4));
    CU(cudaMemcpy(dx, arg.data(), groups * 4, cudaMemcpyHostToDevice));
    Elementary<<<(groups + 255) / 256, 256>>>(dx, dy, int(groups), gate);
    CU(cudaGetLastError());
    CU(cudaMemcpy(dev.data(), dy, groups * 4, cudaMemcpyDeviceToHost));
    CU(cudaFree(dx));
    CU(cudaFree(dy));
    Save(o + ".primitive.f32", dev);
    std::printf(
        "{\"kind\":%d,\"first_row\":%d,\"rows\":%d,\"elements\":%zu,"
        "\"variants\":[",
        kind, start, rows, actual.size());
    for (int variant = 0; variant < 3; ++variant) {
      const char* name = variant == 0   ? "device"
                         : variant == 1 ? "cpu"
                                        : "fp64";
      std::vector<uint16_t> out(actual.size());
      std::vector<int32_t> idx;
      std::vector<double> diff;
      for (size_t i = 0; i < actual.size(); ++i) {
        double reference = 0;
        float value = 0;
        if (gate) {
          if (variant == 2) {
            double raw = high[i];
            reference = Sig64(std::sqrt(std::abs(raw) + double(1e-6f)) *
                              (raw < 0 ? -1. : 1.));
            value = float(reference);
          } else if (variant == 0)
            value = dev[i];
          else {
            float g = float(std::sqrt(double(std::fabs(arg[i]) + 1e-6f))) *
                      (arg[i] < 0 ? -1.f : 1.f);
            value = 1.f / (1.f + float(std::exp(-double(g))));
          }
        } else {
          size_t b = i / 2560;
          float a = B(x[i]), weight = B(w[i % 10240]);
          if (variant == 2) {
            reference =
                double(a) * (1. / std::sqrt(high[b])) * (1. + double(weight));
            value = float(reference);
          } else {
            float inv =
                variant == 0 ? dev[b] : float(1. / std::sqrt(double(arg[b])));
            value = a * (inv * (1.f + weight));
          }
        }
        out[i] = Round(value);
        if (out[i] != actual[i]) {
          idx.push_back(int32_t(i));
          if (variant == 2) diff.push_back(reference);
        }
      }
      Save(o + "." + name + ".bf16", out);
      Save(o + "." + name + ".indices.i32", idx);
      if (variant == 2) Save(o + ".fp64.differences.f64", diff);
      std::printf("%s{\"name\":\"%s\",\"mismatches\":%zu}", variant ? "," : "",
                  name, idx.size());
    }
    std::printf("]}\n");
    return 0;
  } catch (const std::exception& e) {
    std::fprintf(stderr, "%s\n", e.what());
    return 2;
  }
}
