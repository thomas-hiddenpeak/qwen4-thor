// Verbatim production kernel bodies precede this independent input harness.
#define CUDA_OK(expression)                              \
  do {                                                   \
    const cudaError_t status = (expression);             \
    if (status != cudaSuccess) {                         \
      std::fprintf(stderr, "FAIL %s: %s\n", #expression, \
                   cudaGetErrorString(status));          \
      return 1;                                          \
    }                                                    \
  } while (0)

uint16_t Bf(float value) {
  const __nv_bfloat16 converted = __float2bfloat16_rn(value);
  uint16_t bits;
  std::memcpy(&bits, &converted, sizeof(bits));
  return bits;
}

int main() {
  constexpr int kRows = 257, kNq = 24, kNkv = 2, kHd = 256;
  constexpr int kPositions = 4096, kSeq = 3, kSelected = 2052, kGuard = 32;
  const size_t stride = size_t{kPositions} * kNkv * 2 * kHd;
  const size_t outputs = size_t{kRows} * kNq * kHd;
  std::vector<uint16_t> q(outputs), gate(outputs), kv(kSeq * stride);
  std::vector<uint16_t> parent(outputs + kGuard * 2), candidate(parent.size());
  std::vector<int> pages(kSeq * kPositions), selected(kRows * kSelected);
  std::vector<int> sequence(kRows), lengths(kRows);
  const std::array<int, 12> counts{0,  1,  3,  15,   16,   17,
                                   31, 32, 33, 2048, 2049, 2051};
  for (int seq = 0; seq < kSeq; ++seq)
    for (int p = 0; p < kPositions; ++p)
      pages[seq * kPositions + p] = ((p / 16) * 73 + seq * 19) % 256;
  for (int row = 0; row < kRows; ++row) {
    sequence[row] = (row * 2 + 1) % kSeq;
    lengths[row] = counts[row % counts.size()];
    for (int i = 0; i < kSelected; ++i)
      selected[row * kSelected + i] = (i * 37 + row * 113 + 5) % kPositions;
  }
  uint16_t *dq, *dg, *dkv, *dp, *dc;
  int *dpages, *dselected, *dsequence, *dlens;
  CUDA_OK(cudaMalloc(&dq, q.size() * 2));
  CUDA_OK(cudaMalloc(&dg, gate.size() * 2));
  CUDA_OK(cudaMalloc(&dkv, kv.size() * 2));
  CUDA_OK(cudaMalloc(&dp, parent.size() * 2));
  CUDA_OK(cudaMalloc(&dc, candidate.size() * 2));
  CUDA_OK(cudaMalloc(&dpages, pages.size() * sizeof(int)));
  CUDA_OK(cudaMalloc(&dselected, selected.size() * sizeof(int)));
  CUDA_OK(cudaMalloc(&dsequence, sequence.size() * sizeof(int)));
  CUDA_OK(cudaMalloc(&dlens, lengths.size() * sizeof(int)));
  CUDA_OK(cudaMemcpy(dpages, pages.data(), pages.size() * sizeof(int),
                     cudaMemcpyHostToDevice));
  CUDA_OK(cudaMemcpy(dselected, selected.data(), selected.size() * sizeof(int),
                     cudaMemcpyHostToDevice));
  CUDA_OK(cudaMemcpy(dsequence, sequence.data(), sequence.size() * sizeof(int),
                     cudaMemcpyHostToDevice));
  CUDA_OK(cudaMemcpy(dlens, lengths.data(), lengths.size() * sizeof(int),
                     cudaMemcpyHostToDevice));
  size_t compared = 0;
  int cases = 0;
  // These finite shapes cover signed zero, BF16 subnormals, exp underflow,
  // reciprocal extreme Q/K scales, QK/PV cancellation and saturated gates.
  // Extreme Q and K are paired so the FP32 dot products remain finite.
  for (int pattern = 0; pattern < 6; ++pattern) {
    for (size_t i = 0; i < outputs; ++i) {
      const int d = i % kHd;
      q[i] = pattern == 0 ? uint16_t((i & 1) ? 0x8000 : 0) : Bf(1.f);
      if (pattern == 1) q[i] = uint16_t((i % 128) + 1);
      if (pattern == 3) q[i] = 0x7f7f;  // Largest finite BF16.
      if (pattern == 4) q[i] = Bf(d & 1 ? -16.f : 16.f);
      gate[i] = pattern == 5 ? Bf((i % 3 - 1.0f) * 128.f) : Bf(0.f);
    }
    for (int seq = 0; seq < kSeq; ++seq) {
      for (int pos = 0; pos < kPositions; ++pos) {
        const int physical = pages[seq * kPositions + pos] * 16 + pos % 16;
        for (int head = 0; head < kNkv; ++head) {
          const size_t at =
              seq * stride + size_t(physical * kNkv + head) * 2 * kHd;
          for (int d = 0; d < kHd; ++d) {
            float key = (pos % 7 - 3) / 8.f;
            float value = (pos % 5 - 2) / 4.f;
            if (pattern == 0) key = value = 0.f;
            if (pattern == 1) key = 1.f;
            if (pattern == 2) {
              const std::array<float, 6> score{0.f,   -80.f,  -87.f,
                                               -90.f, -104.f, 16.f};
              key = d == 0 ? score[pos % score.size()] * 16.f : 0.f;
            }
            if (pattern == 3) {
              key = (pos % 3 - 1) * 0x1p-126f;
              value = (pos & 1 ? 1.f : -1.f) * 0x1p100f;
            }
            if (pattern == 4) {
              key = 16.f;
              value = (pos & 1 ? 1.f : -1.f) * (d & 1 ? 256.f : 0x1p-20f);
            }
            kv[at + d] = Bf(key);
            kv[at + kHd + d] =
                pattern == 1 ? uint16_t((pos % 128) + 1) : Bf(value);
          }
        }
      }
    }
    CUDA_OK(cudaMemcpy(dq, q.data(), q.size() * 2, cudaMemcpyHostToDevice));
    CUDA_OK(
        cudaMemcpy(dg, gate.data(), gate.size() * 2, cudaMemcpyHostToDevice));
    CUDA_OK(cudaMemcpy(dkv, kv.data(), kv.size() * 2, cudaMemcpyHostToDevice));
    for (bool pooled : {false, true}) {
      for (int rows : {8, 9, 12, 64, kRows}) {
        CUDA_OK(cudaMemset(dp, 0xa5, parent.size() * 2));
        CUDA_OK(cudaMemset(dc, 0xc3, candidate.size() * 2));
        const int* seq_ids = pooled ? dsequence : nullptr;
        before::SparseAttentionKernel<<<dim3(rows, kNkv), 256>>>(
            dq, dkv, dpages, dselected, dlens, dp + kGuard, dg, kNq, kNkv, kHd,
            kSelected, seq_ids, stride, kPositions);
        CUDA_OK(cudaGetLastError());
        if (rows > 8) {
          after::SparseAttentionKernel<true><<<dim3(rows, kNkv), 256>>>(
              dq, dkv, dpages, dselected, dlens, dc + kGuard, dg, kNq, kNkv,
              kHd, kSelected, seq_ids, stride, kPositions);
        } else {
          after::SparseAttentionKernel<false><<<dim3(rows, kNkv), 256>>>(
              dq, dkv, dpages, dselected, dlens, dc + kGuard, dg, kNq, kNkv,
              kHd, kSelected, seq_ids, stride, kPositions);
        }
        CUDA_OK(cudaGetLastError());
        CUDA_OK(cudaMemcpy(parent.data(), dp, parent.size() * 2,
                           cudaMemcpyDeviceToHost));
        CUDA_OK(cudaMemcpy(candidate.data(), dc, candidate.size() * 2,
                           cudaMemcpyDeviceToHost));
        const size_t valid = size_t(rows) * kNq * kHd;
        for (size_t i = 0; i < parent.size(); ++i) {
          if (i < kGuard || i >= kGuard + valid) {
            if (parent[i] != 0xa5a5 || candidate[i] != 0xc3c3) {
              std::fprintf(stderr, "FAIL canary pattern=%d rows=%d index=%zu\n",
                           pattern, rows, i);
              return 1;
            }
          } else if (parent[i] != candidate[i] ||
                     (parent[i] & 0x7f80) == 0x7f80) {
            std::fprintf(stderr,
                         "FAIL pattern=%d pooled=%d rows=%d index=%zu old=%04x "
                         "new=%04x\n",
                         pattern, pooled, rows, i, parent[i], candidate[i]);
            return 1;
          }
        }
        compared += valid;
        ++cases;
      }
    }
    std::printf("PASS pattern=%d\n", pattern);
    std::fflush(stdout);
  }
  std::printf("PASS finite_boundaries=1 cases=%d bf16_values=%zu canaries=1\n",
              cases, compared);
  return 0;
}
