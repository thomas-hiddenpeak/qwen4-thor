{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serve-mcp-tunnel-v1.schema.json",
  "title": "Q4T native MCP tunnel transport",
  "$defs": {
    "route_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "header_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])",
      "not": {
        "const": "*"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "object": {
          "const": "tunnel"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "active",
            "stopped"
          ]
        },
        "proc_affinity": {
          "const": true
        }
      },
      "required": [
        "id",
        "object",
        "name",
        "status",
        "proc_affinity"
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
        },
        "shard_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
        },
        "command_type": {
          "enum": [
            "jsonrpc",
            "session_termination"
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])",
          "not": {
            "const": "*"
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[\\t\\x20-\\x7e\\x80-\\xff]*(?![\\s\\S])"
            }
          },
          "x-q4t-total-bytes": 16384,
          "description": "HTTP Latin-1 header arrays. Hop-by-hop and Connection-nominated headers are removed; response headers use a fixed MCP allowlist."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "response_timeout": {
          "type": "string",
          "pattern": "^[0-9]+ms(?![\\s\\S])"
        },
        "jsonrpc": {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
            },
            "params": {}
          },
          "required": [
            "jsonrpc",
            "method"
          ]
        }
      },
      "required": [
        "request_id",
        "shard_token",
        "command_type",
        "channel",
        "headers",
        "created_at",
        "response_timeout"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "jsonrpc"
              }
            }
          },
          "then": {
            "required": [
              "jsonrpc"
            ]
          },
          "else": {
            "properties": {
              "jsonrpc": false
            }
          }
        }
      ]
    },
    "poll": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "required": [
        "commands"
      ]
    },
    "upload": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
        },
        "resp_code": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "resp_type": {
          "enum": [
            "jsonrpc_response",
            "jsonrpc_notify",
            "notify_ack",
            "session_termination_response"
          ],
          "default": "jsonrpc_response"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])",
          "not": {
            "const": "*"
          },
          "default": "main"
        },
        "resp_headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[\\t\\x20-\\x7e\\x80-\\xff]*(?![\\s\\S])"
            }
          },
          "x-q4t-total-bytes": 16384,
          "description": "HTTP Latin-1 header arrays. Hop-by-hop and Connection-nominated headers are removed; response headers use a fixed MCP allowlist."
        },
        "resp_json": {},
        "rpc_resp": {},
        "shard_token": false,
        "q4t_outcome_unknown": {
          "type": "boolean",
          "description": "Q4T extension: transport failed after possible dispatch; never replay."
        }
      },
      "required": [
        "request_id",
        "resp_code"
      ],
      "not": {
        "required": [
          "resp_json",
          "rpc_resp"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resp_type": {
                "const": "jsonrpc_response"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "resp_json"
                ]
              },
              {
                "required": [
                  "rpc_resp"
                ]
              }
            ],
            "properties": {
              "resp_json": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "result": {},
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "data": {}
                    },
                    "required": [
                      "code",
                      "message"
                    ]
                  },
                  "method": false
                },
                "required": [
                  "jsonrpc",
                  "id"
                ],
                "oneOf": [
                  {
                    "required": [
                      "result"
                    ],
                    "not": {
                      "required": [
                        "error"
                      ]
                    }
                  },
                  {
                    "required": [
                      "error"
                    ],
                    "not": {
                      "required": [
                        "result"
                      ]
                    }
                  }
                ]
              },
              "rpc_resp": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "result": {},
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "data": {}
                    },
                    "required": [
                      "code",
                      "message"
                    ]
                  },
                  "method": false
                },
                "required": [
                  "jsonrpc",
                  "id"
                ],
                "oneOf": [
                  {
                    "required": [
                      "result"
                    ],
                    "not": {
                      "required": [
                        "error"
                      ]
                    }
                  },
                  {
                    "required": [
                      "error"
                    ],
                    "not": {
                      "required": [
                        "result"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resp_type": {
                "const": "jsonrpc_notify"
              }
            },
            "required": [
              "resp_type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "resp_json"
                ]
              },
              {
                "required": [
                  "rpc_resp"
                ]
              }
            ],
            "properties": {
              "resp_json": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "jsonrpc": {
                        "const": "2.0"
                      },
                      "id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
                      },
                      "params": {}
                    },
                    "required": [
                      "jsonrpc",
                      "method"
                    ]
                  },
                  {
                    "properties": {
                      "id": false,
                      "result": false,
                      "error": false
                    }
                  }
                ]
              },
              "rpc_resp": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "jsonrpc": {
                        "const": "2.0"
                      },
                      "id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
                      },
                      "params": {}
                    },
                    "required": [
                      "jsonrpc",
                      "method"
                    ]
                  },
                  {
                    "properties": {
                      "id": false,
                      "result": false,
                      "error": false
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "resp_type"
            ],
            "properties": {
              "resp_type": {
                "enum": [
                  "notify_ack",
                  "session_termination_response"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resp_json": false,
              "rpc_resp": false
            }
          }
        },
        {
          "if": {
            "required": [
              "q4t_outcome_unknown"
            ],
            "properties": {
              "q4t_outcome_unknown": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "resp_code": {
                "minimum": 400
              },
              "resp_type": {
                "const": "jsonrpc_response"
              },
              "resp_json": {
                "required": [
                  "error"
                ]
              },
              "rpc_resp": {
                "required": [
                  "error"
                ]
              }
            }
          }
        }
      ]
    },
    "ack": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "x-q4t": {
    "protocol_date": "2026-08-25",
    "source_commit": "fb6c47fbdf156451137e2c00a55d485be42f03a3",
    "source": "https://github.com/openai/tunnel-client/blob/fb6c47fbdf156451137e2c00a55d485be42f03a3/docs/protocol.md",
    "max_upload_bytes": 4194304,
    "max_poll_bytes": 8388608,
    "stateful_checks": "Exact agent/caller/generation/instance/channel/token/RPC ID; one-way handoff; duplicate final only acknowledges identical terminal.",
    "unknown_metadata": "Ignored within byte/depth/value limits; never establishes authority.",
    "invalid_authenticated_terminal": "400 plus fixed 502 result for caller, with q4t_outcome_unknown on RPC requests; invalid progress cannot finish a request."
  }
}
