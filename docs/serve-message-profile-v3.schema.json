{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q4t:serve:message-profile:v3",
  "title": "qwen3.8-openai-v3 text message profile",
  "description": "Text message shapes only. Tool association, full request options and runtime admission still require native validation; media uses the vision request schema.",
  "type": "object",
  "required": [
    "messages"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool",
            "function"
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": [
                "string",
                "null"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/textPart"
                  },
                  {
                    "$ref": "#/$defs/refusalPart"
                  }
                ]
              }
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "x-q4t-max-utf8-bytes": 4096
        },
        "refusal": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio": {
          "type": "null"
        },
        "annotations": {
          "type": "null"
        },
        "function_call": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "arguments": {
                  "type": "string",
                  "x-q4t-json-object-text": true
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/historyCall"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-q4t-max-utf8-bytes": 256
        }
      },
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "not": {
                  "const": "assistant"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reasoning"
                  ],
                  "properties": {
                    "reasoning": {}
                  }
                },
                {
                  "required": [
                    "reasoning_content"
                  ],
                  "properties": {
                    "reasoning_content": {}
                  }
                },
                {
                  "required": [
                    "tool_calls"
                  ],
                  "properties": {
                    "tool_calls": {}
                  }
                },
                {
                  "required": [
                    "refusal"
                  ],
                  "properties": {
                    "refusal": {}
                  }
                },
                {
                  "required": [
                    "function_call"
                  ],
                  "properties": {
                    "function_call": {}
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "not": {
                  "const": "tool"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tool_call_id"
                  ],
                  "properties": {
                    "tool_call_id": {}
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "const": "function"
                    }
                  }
                }
              },
              {
                "not": {
                  "allOf": [
                    {
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        }
                      }
                    },
                    {
                      "anyOf": [
                        {
                          "required": [
                            "tool_calls"
                          ],
                          "properties": {
                            "tool_calls": {
                              "type": "array",
                              "minItems": 1
                            }
                          }
                        },
                        {
                          "required": [
                            "refusal"
                          ],
                          "properties": {
                            "refusal": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "required": [
                            "function_call"
                          ],
                          "properties": {
                            "function_call": {
                              "type": "object"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": [
                  "string",
                  "array"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "function_call"
            ],
            "properties": {
              "function_call": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "tool_calls": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "function"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "content"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "audio"
                  ],
                  "properties": {
                    "audio": {}
                  }
                },
                {
                  "required": [
                    "annotations"
                  ],
                  "properties": {
                    "annotations": {}
                  }
                },
                {
                  "required": [
                    "tool_call_id"
                  ],
                  "properties": {
                    "tool_call_id": {}
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "not": {
                  "const": "assistant"
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "not": {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "refusal"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "array",
                "contains": {
                  "$ref": "#/$defs/refusalPart"
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/refusalPart"
                }
              }
            }
          }
        }
      ]
    },
    "textPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "refusalPart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "refusal"
        },
        "refusal": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "refusal"
      ],
      "additionalProperties": false
    },
    "historyCall": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-q4t-max-utf8-bytes": 256
            },
            "type": {
              "const": "function"
            },
            "function": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$",
                  "x-q4t-max-utf8-bytes": 256
                },
                "arguments": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$",
                        "x-q4t-max-utf8-bytes": 256
                      }
                    },
                    {
                      "type": "string",
                      "x-q4t-json-object-text": true
                    }
                  ]
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "function"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "function"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$",
              "x-q4t-max-utf8-bytes": 256
            },
            "arguments": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$",
                    "x-q4t-max-utf8-bytes": 256
                  }
                },
                {
                  "type": "string",
                  "x-q4t-json-object-text": true
                }
              ]
            }
          },
          "required": [
            "name",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-q4t-max-utf8-bytes": 256
            },
            "type": {
              "const": "custom"
            },
            "custom": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "input": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "input"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "custom"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-q4t": {
    "profile": "qwen3.8-openai-v3",
    "developer_mapping": "ordered system ChatML messages",
    "name": "JSON quoted participant; angle brackets escaped",
    "name_max_utf8_bytes": 4096,
    "user_message_required": false,
    "full_request_validation": false
  }
}
