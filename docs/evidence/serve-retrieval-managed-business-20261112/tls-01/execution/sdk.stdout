91cf\u5378\u8f7d**\u3002Thor\u7684CPU\u548c\u96c6\u6210GPU\u5171\u7528\n\u7269\u7406DRAM\uff1bhost\u3001device\u3001managed allocation\u90fd\u6765\u81ea\u8be5\u5185\u5b58\u3002\u628a\u4e13\u5bb6\u4ece\ndevice allocation\u79fb\u5230CPU\u5185\u5b58\uff0c\u4ecd\u7136\u662fRAM\u9a7b\u7559\uff0c\u4e0d\u6784\u6210\u5bb9\u91cf\u5378\u8f7d\u3002\n\u8fd9\u662f[CUDA 13.3 Tegra\u5185\u5b58\u8bf4\u660e](https://docs.nvidia.com/cuda/archive/13.3.0/cuda-for-tegra-appnote/index.html#memory-management)\n\u4e0e\u672c\u9879\u76ee\u76ee\u6807\u5171\u540c\u786e\u5b9a\u7684\u8fb9\u754c\u3002\n\n\u201c\u4e0e\u76f4\u63a5\u8f7d\u5165\u5185\u5b58\u6ca1\u6709\u533a\u522b\u201d\u5728\u8fd9\u91cc\u6307**\u6ca1\u6709\u79fb\u51fa\u7269\u7406RAM**\uff1b\u4e0d\u4ee3\u8868\u4e0d\u540c\n\u5206\u914d\u65b9\u5f0f\u7684\u8bbf\u95ee\u3001\u7f13\u5b58\u3001\u62f7\u8d1d\u3001\u540c\u6b65\u6216\u6027\u80fd\u5b8c\u5168\u76f8\u540c\u3002\u7edf\u4e00\u7269\u7406\u5185\u5b58\u4e5f\u4e0d\n\u81ea\u52a8\u6d88\u9664\u73b0\u6709H2D/D2H\u6216\u91cd\u590d\u526f\u672c\u3002\n\n\u4e13\u5bb6\u6743\u91cd\u4fdd\u5b58\u5728\u53ea\u8bfbSSD checkpoint\uff0c\u9700\u8981\u65f6\u8bfb\u5165\u6709\u754c\u5de5\u4f5c\u96c6\u4f9bGPU\u8ba1\u7b97\u3002\n\u5f53\u524d\u5b9e\u73b0\u4e0d\u628aGPU\u9a71\u9010\u89e3\u91ca\u4e3a\u5199\u56deSSD\uff1a\u539f\u59cb\u6743\u91cd\u5df2\u5728SSD\uff0c\u8bbe\u5907\u69fd\u53ef\u76f4\u63a5\n\u4e22\u5f03\u6216\u653e\u5165\u65e2\u6709\u6709\u754cDRAM\u955c\u50cf\u3002\u4fee\u6539\u539f\u6a21\u578b\u76ee\u5f55\u4e0d\u5c5e\u4e8e\u4efb\u4f55\u4f18\u5316\u51fa\u53e3\u3002\n\n## \u5141\u8bb8\u7684\u4e2d\u8f6c\u4e0e\u7981\u6b62\u7684\u5bb9\u91cf\u8868\u8ff0\n\n| \u5bf9\u8c61\u6216\u8bf4\u6cd5 | \u5f53\u524d\u542b\u4e49\u4e0e\u7ea6\u675f |\n|---|---|\n| SSD offload | SSD\u627f\u62c5\u4e0d\u5e38\u9a7bDRAM\u7684\u4e13\u5bb6\u5bb9\u91cf\uff1b\u9a7b\u7559\u5de5\u4f5c\u96c6\u3001\u7f13\u5b58\u4e0e\u4e2d\u8f6c\u53d7\u603bRAM\u76ee\u6807\u7ea6\u675f |\n| device\u4e13\u5bb6\u69fd\u4f4d | GPU\u8ba1\u7b97\u4f7f\u7528\u7684DRAM\u5de5\u4f5c\u96c6\uff1b\u51cf\u5c11\u69fd\u4f4d\u672c\u8eab\u4e0d\u8bc1\u660e\u6574\u673aRAM\u4e0b\u964d |\n| pinned staging / host L2 / mirror | DRAM\u4e2d\u7684\u4e2d\u8f6c\u6216\u7f13\u5b58\uff1b\u5fc5\u987b\u8ba1\u5165\u5bb9\u91cf\uff0c\u4e0d\u80fd\u79f0\u4e3a\u53e6\u4e00\u4e2aoffload\u5c42 |\n"}]}, "output_index": 0, "sequence_number": 6, "type": "response.output_item.done"}, {"item": {"id": "msg_444773d31a2b8ea1999958772a45d990", "content": [], "role": "assistant", "status": "in_progress", "type": "message"}, "output_index": 1, "sequence_number": 7, "type": "response.output_item.added"}, {"content_index": 0, "item_id": "msg_444773d31a2b8ea1999958772a45d990", "output_index": 1, "part": {"annotations": [], "text": "", "type": "output_text", "logprobs": []}, "sequence_number": 8, "type": "response.content_part.added"}, {"content_index": 0, "delta": "According", "item_id": "msg_444773d31a2b8ea1999958772a45d990", "logprobs": [], "output_index": 1, "sequence_number": 9, "type": "response.output_text.delta", "snapshot": "According"}, {"content_index": 0, "delta": " to", "item_id": "msg_444773d31a2b8ea1999958772a45d990", "logprobs": [], "output_index": 1, "sequence_number": 10, "type": "response.output_text.delta", "snapshot": "According to"}, {"content_index": 0, "delta": " the", "item_id": "msg_444773d31a2b8ea1999958772a45d990", "logprobs": [], "output_index": 1, "sequence_number": 11, "type": "response.output_text.delta", "snapshot": "According to the"}, {"content_index": 0, "delta": " project", "item_id": "msg_444773d31a2b8ea1999958772a45d990", "logprobs": [], "output_index": 1, "sequence_number": 12, "type": "response.output_text.delta", "snapshot": "According to the project"}, {"content_index": 0, "delta": ",", "item_id": "msg_444773d31a2b8ea1999958772a45d990", "logprobs": [], "output_index": 1, "sequence_number": 13, "type": "response.output_text.delta", "snapshot": "According to the project,"}, {"content_index": 0, "delta": " Mo", "item_id": "msg_444773