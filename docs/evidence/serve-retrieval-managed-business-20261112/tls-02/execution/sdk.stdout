 "text"}, "verbosity": "medium"}, "reasoning": {"effort": "none", "context": "all_turns", "mode": "standard", "summary": null}, "store": true, "background": false, "max_output_tokens": 256, "max_tool_calls": 1, "previous_response_id": null, "prompt_cache_options": {"mode": "implicit", "ttl": "30m"}, "prompt_cache_retention": "in_memory", "service_tier": "default", "truncation": "disabled", "top_logprobs": 0, "access_programs": null}, "type": "response.in_progress", "sequence_number": 1}, {"output_index": 0, "item": {"id": "fs_3d4a967aa787a3640184af6fd88a3da4", "type": "file_search_call", "status": "in_progress", "queries": [], "results": null}, "type": "response.output_item.added", "sequence_number": 2}, {"item_id": "fs_3d4a967aa787a3640184af6fd88a3da4", "output_index": 0, "type": "response.file_search_call.in_progress", "sequence_number": 3}, {"item_id": "fs_3d4a967aa787a3640184af6fd88a3da4", "output_index": 0, "type": "response.file_search_call.searching", "sequence_number": 4}, {"item_id": "fs_3d4a967aa787a3640184af6fd88a3da4", "output_index": 0, "type": "response.file_search_call.completed", "sequence_number": 5}, {"output_index": 0, "item": {"id": "fs_3d4a967aa787a3640184af6fd88a3da4", "type": "file_search_call", "status": "completed", "queries": ["MoE expert capacity offloaded SSD DRAM CPU memory insufficient"], "results": [{"file_id": "file_0304203713e29c167fae9bf9b09bda06", "filename": "SSD_OFFLOAD_CONTRACT.md", "score": 1, "attributes": {}, "text": "# Thor\u7edf\u4e00\u5185\u5b58\u4e0b\u7684SSD offload\u5408\u540c\n\n2026-10-21\u6309\u7528\u6237\u660e\u786e\u8981\u6c42\u5efa\u7acb\u3002\u672c\u6587\u7ea6\u675f\u5f53\u524d\u4e0e\u540e\u7eedMoE expert offload\n\u7684\u8bbe\u8ba1\u3001\u6587\u6863\u548c\u9a8c\u6536\uff1b\u5386\u53f2\u62a5\u544a\u4fdd\u7559\u539f\u59cb\u4e8b\u5b9e\uff0c\u4e0d\u4f5c\u4e3a\u4e0e\u672c\u6587\u51b2\u7a81\u7684\u6267\u884c\u8ba1\u5212\u3002\n\n## \u552f\u4e00\u5bb9\u91cf\u540e\u5907\u662fSSD\n\n\u672c\u9879\u76ee\u7684MoE\u4e13\u5bb6**\u53ea\u5411SSD\u505a\u5bb9\u91cf\u5378\u8f7d**\u3002Thor\u7684CPU\u548c\u96c6\u6210GPU\u5171\u7528\n\u7269\u7406DRAM\uff1bhost\u3001device\u3001managed allocation\u90fd\u6765\u81ea\u8be5\u5185\u5b58\u3002\u628a\u4e13\u5bb6\u4ece\ndevice allocation\u79fb\u5230CPU\u5185\u5b58\uff0c\u4ecd\u7136\u662fRAM\u9a7b\u7559\uff0c\u4e0d\u6784\u6210\u5bb9\u91cf\u5378\u8f7d\u3002\n\u8fd9\u662f[CUDA 13.3 Tegra\u5185\u5b58\u8bf4\u660e](https://docs.nvidia.com/cuda/archive/13.3.0/cuda-for-tegra-appnote/index.html#memory-management)\n\u4e0e\u672c\u9879\u76ee\u76ee\u6807\u5171\u540c\u786e\u5b9a\u7684\u8fb9\u754c\u3002\n\n\u201c\u4e0e\u76f4\u63a5\u8f7d\u5165\u5185\u5b58\u6ca1\u6709\u533a\u522b\u201d\u5728\u8fd9\u91cc\u6307**\u6ca1\u6709\u79fb\u51fa\u7269\u7406RAM**\uff1b\u4e0d\u4ee3\u8868\u4e0d\u540c\n\u5206\u914d\u65b9\u5f0f\u7684\u8bbf\u95ee\u3001\u7f13\u5b58\u3001\u62f7\u8d1d\u3001\u540c\u6b65\u6216\u6027\u80fd\u5b8c\u5168\u76f8\u540c\u3002\u7edf\u4e00\u7269\u7406\u5185\u5b58\u4e5f\u4e0d\n\u81ea\u52a8\u6d88\u9664\u73b0\u6709H2D/D2H\u6216\u91cd\u590d\u526f\u672c\u3002\n\n\u4e13\u5bb6\u6743\u91cd\u4fdd\u5b58\u5728\u53ea\u8bfbSSD checkpoint\uff0c\u9700\u8981\u65f6\u8bfb\u5165\u6709\u754c\u5de5\u4f5c\u96c6\u4f9bGPU\u8ba1\u7b97\u3002\n\u5f53\u524d\u5b9e\u73b0\u4e0d\u628aGPU\u9a71\u9010\u89e3\u91ca\u4e3a\u5199\u56deSSD\uff1a\u539f\u59cb\u6743\u91cd\u5df2\u5728SSD\uff0c\u8bbe\u5907\u69fd\u53ef\u76f4\u63a5\n\u4e22\u5f03\u6216\u653e\u5165\u65e2\u6709\u6709\u754cDRAM\u955c\u50cf\u3002\u4fee\u6539\u539f\u6a21\u578b\u76ee\u5f55\u4e0d\u5c5e\u4e8e\u4efb\u4f55\u4f18\u5316\u51fa\u53e3\u3002\n\n## \u5141\u8bb8\u7684\u4e2d\u8f6c\u4e0e\u7981\u6b62\u7684\u5bb9\u91cf\u8868\u8ff0\n\n| \u5bf9\u8c61\u6216\u8bf4\u6cd5 | \u5f53\u524d\u542b\u4e49\u4e0e\u7ea6\u675f |\n|---|---|\n| SSD offload | SSD\u627f\u62c5\u4e0d\u5e38\u9a7bDRAM\u7684\u4e13\u5bb6\u5bb9\u91cf\uff1b\u9a7b\u7559\u5de5\u4f5c\u96c6\u3001\u7f13\u5b58\u4e0e\u4e2d\u8f6c\u53d7\u603bRAM\u76ee\u6807\u7ea6\u675f |\n| device\u4e13\u5bb6\u69fd\u4f4d | GPU\u8ba1\u7b97\u4f7f\u7528\u7684DRAM\u5de5\u4f5c\u96c6\uff1b\u51cf\u5c11\u69fd\u4f4d\u672c\u8eab\u4e0d\u8bc1\u660e\u6574\u673aRAM\u4e0b\u964d |\n| pinned staging / host L2 / mirror | DRAM\u4e2d\u7684\u4e2d\u8f6c\u6216\u7f13\u5b58\uff1b\u5fc5\u987b\u8ba1\u5165\u5bb9\u91cf\uff0c\u4e0d\u80fd\u79f0\u4e3a\u53e6\u4e00\u4e2aoffload\u5c42 |\n"}]}, "type": "response.output_item.done", "sequence_number": 6}, {"output_index": 1, "item": {"id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "type": "message", "content": [], "role": "assistant", "status": "in_progress"}, "type": "response.output_item.added", "sequence_number": 7}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "part": {"type": "output_text", "text": "", "annotations": [], "logprobs": []}, "type": "response.content_part.added", "sequence_number": 8}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": "According", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 9}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": " to", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 10}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": " the", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 11}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": " project", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 12}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": ",", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 13}, {"item_id": "msg_d9e181e8bbda6bbfe813f41ed7a505ba", "output_index": 1, "content_index": 0, "delta": " Mo", "logprobs": [], "type": "response.output_text.delta", "sequence_number": 14}, {"item_id": "msg_d9e181e8bb