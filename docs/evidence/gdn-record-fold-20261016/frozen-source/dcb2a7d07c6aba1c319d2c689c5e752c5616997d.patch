+struct RecordFoldRound {
+  std::vector<Observation> initial;
+  std::vector<Observation> verified;
+  std::vector<Observation> accepted;
+  std::vector<Observation> continued;
+  Observation verify_logits;
+  Observation probe_logits;
+};
