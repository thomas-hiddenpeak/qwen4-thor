{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q4t:serve-stop-v1",
  "title": "Q4T text stop request projection; UTF-8 byte length and constraints require native validation",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "stop": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "stop"
            ],
            "properties": {
              "stop": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "session_id"
                  ]
                },
                {
                  "required": [
                    "prefix_cache_scope"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
