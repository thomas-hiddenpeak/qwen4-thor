{
  "model": "qwen3.8-flash-next",
  "temperature": 0,
  "max_completion_tokens": 512,
  "stream": true,
  "messages": [
    {
      "role": "developer",
      "content": "遵循用户请求。"
    },
    {
      "role": "user",
      "content": "输出JSON对象，answer必须为字符串710003。"
    }
  ],
  "extra_body": {
    "chat_template_kwargs": {
      "enable_thinking": true,
      "reasoning_effort": "low"
    },
    "include_reasoning": false,
    "reasoning_field": "reasoning",
    "request_timeout_ms": 180000
  },
  "stream_options": {
    "include_usage": true
  },
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "answer",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "enum": [
              "710003"
            ]
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "extra_headers": {
    "X-Request-Id": "trace-hidden-schema"
  }
}
