+// Native speech delivery on the original Realtime response worker.
+#pragma once
+
+#include "q4t/server/chat_audio_output.h"
+#include "q4t/server/realtime_speech_encoder.h"
+#include "q4t/server/speech_output.h"
+#include "q4t/trace/sha256.h"
+
+namespace q4t::server {
+struct RealtimeSpeechOptions {
+  bool enabled = false;
+  RealtimeAudioFormat format;
+  ChatAudioOptions chat;
+};
+// Merge per-response output options with effective session settings. Input
+// audio is owned separately. No lookup, voice substitution or model execution.
+Status PlanRealtimeSpeech(const io::Json& settings, const io::Json& response,
+                          RealtimeSpeechOptions* out, ChatPlanError* error);
+bool SameRealtimeVoice(const RealtimeSpeechOptions& left,
+                       const RealtimeSpeechOptions& right);
+struct RealtimeSpeechEvent {
+  enum class Kind { kChunk, kDone } kind = Kind::kChunk;
+  std::string bytes, transcript;
+  RealtimeSpeechReceipt receipt;
+};
+using RealtimeSpeechSink =
+    std::function<ObjectReply(const RealtimeSpeechEvent&)>;
+
+// Verifies actual post-tempo PCM against the native EOF receipt before
+// publishing completion. No waveform accumulation or extra RPM/model owner.
+class RealtimeSpeechExecution {
+ public:
+  RealtimeSpeechExecution(const RealtimeSpeechOptions& options,
+                          RealtimeSpeechSink sink,
+                          std::function<bool()> cancelled);
+  bool Valid() const { return valid_; }
+  bool Completed() const { return completed_; }
+  const std::optional<ActualUsage>& Usage() const { return usage_; }
+  ObjectReply Append(std::string_view pcm);
+  ObjectReply Finish(std::string_view transcript,
+                     const SpeechEncodingReceipt& native,
+                     const ActualUsage& usage);
+
+ private:
+  ObjectReply Fail(std::string_view message);
+  ObjectReply Emit(const RealtimeSpeechEvent& event);
+  RealtimeSpeechEncoder encoder_;
+  trace::Sha256Stream hash_;
+  const RealtimeSpeechSink sink_;
+  const std::function<bool()> cancelled_;
+  bool valid_ = false, completed_ = false;
+  std::optional<ActualUsage> usage_;
+  ObjectReply error_;
+};
+}  // namespace q4t::server
diff --git a/include/q4t/server/realtime_speech_history.h b/include/q4t/server/realtime_speech_history.h
new file mode 100644
index 000000000..d6135e5f8
--- /dev/null
+++ b/include/q4t/server/realtime_speech_history.h
@@ -0,0 +1,59 @@
+// Actual generated wire audio, owned by one Realtime session thread.
+#pragma once
+
+#include "q4t/server/realtime_audio_queue.h"
+#include "q4t/server/realtime_conversation.h"
+
+namespace q4t::server {
+struct RealtimeSpeechView {
+  RealtimeAudioFormat format;
+  std::string_view bytes;
+  uint64_t generated_samples = 0;
+  bool complete = false, truncated = false, interrupted = false;
+};
+
+// Views are synchronous borrows: no worker may retain one across a mutation.
+// Reserve binary capacity before publishing the first chunk. JSON/transcript,
+// metadata, retrieval encoding and transient construction have separate bounds
+// in the session owner. Truncation itself retains its allocation; EOF or owner
+// settlement may compact it. Generated extent is distinct from retained audio.
+class RealtimeSpeechHistory {
+ public:
+  static constexpr size_t kMaximumBytes = 128ULL << 20;
+  explicit RealtimeSpeechHistory(std::string owner,
+                                 size_t maximum_bytes = kMaximumBytes,
+                                 size_t maximum_items = 128);
+  RealtimeSpeechHistory(const RealtimeSpeechHistory&) = delete;
+  RealtimeSpeechHistory& operator=(const RealtimeSpeechHistory&) = delete;
+  bool Valid() const { return valid_; }
+  size_t ChargedBytes() const { return charged_; }
+  size_t Items() const { return entries_.size(); }
+  Status Begin(const RealtimeItemTicket& ticket, RealtimeAudioFormat format,
+               size_t maximum_record_bytes);
+  Status Append(const RealtimeItemTicket& ticket, std::string_view bytes);
+  Status Complete(const RealtimeItemTicket& ticket);
+  Status Interrupt(const RealtimeItemTicket& ticket);
+  // WebSocket clients supply their actual played duration. It must not exceed
+  // generated audio. Calling this seals the record against all late output.
+  Status Truncate(const RealtimeItemTicket& ticket, uint64_t audio_end_ms);
+  Status Get(const RealtimeItemTicket& ticket, RealtimeSpeechView* view) const;
+  Status Erase(const RealtimeItemTicket& ticket);
+
+ private:
+  struct Entry {
+    RealtimeItemTicket ticket;
+    RealtimeAudioFormat format;
+    std::string bytes;
+    size_t maximum = 0;
+    uint64_t generated_samples = 0;
+    bool complete = false, truncated = false, interrupted = false;
+  };
+  size_t Position(const RealtimeItemTicket& ticket) const;
+  void Compact(Entry& entry) noexcept;
+  const std::string owner_;
+  const size_t maximum_bytes_, maximum_items_;
+  bool valid_ = false;
+  size_t charged_ = 0;
+  std::vector<Entry> entries_;
+};
+}  // namespace q4t::server
