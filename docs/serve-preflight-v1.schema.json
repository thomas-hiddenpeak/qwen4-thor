{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Q4T private extension, not an OpenAI or vLLM endpoint compatibility claim.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "description": "The existing Chat input contract; a complete Chat schema is tracked by SRV-08."
        },
        "include_prompt": {
          "type": "boolean"
        },
        "include_token_ids": {
          "type": "boolean"
        }
      },
      "required": [
        "request"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "const": "q4t.chat.preflight"
        },
        "profile": {
          "const": "q4t-preflight-v1"
        },
        "model": {
          "type": "string"
        },
        "protocol_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "prefill_chunk_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "prefill_chunks": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "max_tokens",
                "max_completion_tokens",
                "server_default"
              ]
            },
            "requested_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "capped_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "available_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "counts_reasoning_and_forced_tokens": {
              "const": true
            }
          },
          "required": [
            "source",
            "requested_tokens",
            "capped_tokens",
            "available_tokens",
            "counts_reasoning_and_forced_tokens"
          ]
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [
                "explicit_full_budget",
                "uniform_context_clip"
              ]
            },
            "required_capacity": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_slots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "slot_reserved": {
              "const": false
            },
            "availability_checked": {
              "const": false
            }
          },
          "required": [
            "policy",
            "required_capacity",
            "eligible_slots",
            "slot_reserved",
            "availability_checked"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "const": true
            },
            "template": {
              "const": true
            },
            "tokenizer": {
              "const": true
            },
            "budget": {
              "const": true
            },
            "structured_requested": {
              "type": "boolean"
            },
            "grammar_compiled": {
              "const": false
            },
            "cache_accessed": {
              "const": false
            },
            "request_registered": {
              "const": false
            },
            "gpu_executed": {
              "const": false
            }
          },
          "required": [
            "input",
            "template",
            "tokenizer",
            "budget",
            "structured_requested",
            "grammar_compiled",
            "cache_accessed",
            "request_registered",
            "gpu_executed"
          ]
        },
        "execution_guaranteed": {
          "const": false
        },
        "unvalidated": {
          "const": [
            "runtime_health",
            "admission_and_deadline",
            "request_id_and_session_leases",
            "grammar_compilation",
            "thinking_boundary_tokens",
            "cache_hits",
            "generation_and_output_validation"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "token_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "object",
        "profile",
        "model",
        "protocol_source_sha256",
        "prompt_tokens",
        "prompt_bytes",
        "max_context_tokens",
        "prefill_chunk_tokens",
        "prefill_chunks",
        "output",
        "admission",
        "checks",
        "execution_guaranteed",
        "unvalidated"
      ]
    }
  },
  "$ref": "#/$defs/response"
}
