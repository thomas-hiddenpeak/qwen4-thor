{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:q4t:serve-transport:v1",
  "title": "Q4T serve transport response subset v1",
  "description": "Stage A response envelopes, not a complete OpenAPI or tool/schema input contract. Transport and stream ordering require the accompanying validator.",
  "x-q4t": {
    "request_id_header": "X-Request-Id",
    "request_id_pattern": "^[A-Za-z0-9_.:-]{1,128}$",
    "trace_id_is_cancel_credential": false,
    "random_id_bits": 128,
    "known_route_wrong_method": 405,
    "unsupported_post_content_type": 415,
    "query_parameters": "reject_400",
    "stream_heartbeat_ms": 5000,
    "heartbeat_write_timeout_ms": 1000,
    "control_connection_reserve": 4,
    "draining_control_window_max_ms": 2000,
    "header_flood_guarantee": false,
    "stream_usage": "if requested: null on choices chunks, object on final empty-choices chunk",
    "stream_error": "one error then DONE when writable; partial write failure closes without another terminal"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/completion"
    },
    {
      "$ref": "#/$defs/chunk"
    },
    {
      "$ref": "#/$defs/readiness"
    }
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens_details": {
          "type": "object",
          "properties": {
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "accepted_prediction_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "rejected_prediction_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "audio_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "q4t_audio_synthesis": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "message",
            "type",
            "code",
            "param"
          ],
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "enum": [
                "invalid_request_error",
                "server_error",
                "timeout_error",
                "conflict_error",
                "service_unavailable_error",
                "authentication_error",
                "permission_error",
                "rate_limit_error"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "param": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "id",
        "object",
        "created",
        "model",
        "choices",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "const": "chat.completion"
        },
        "created": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "index",
              "message",
              "finish_reason",
              "logprobs"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "logprobs": {
                "$ref": "#/$defs/logprobs"
              },
              "message": {
                "type": "object",
                "required": [
                  "role",
                  "content"
                ],
                "properties": {
                  "role": {
                    "const": "assistant"
                  },
                  "content": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "refusal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "function_call": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "arguments": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "arguments"
                    ]
                  },
                  "audio": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 7,
                            "maxLength": 256,
                            "pattern": "^audio_",
                            "not": {
                              "pattern": "[^A-Za-z0-9_-]"
                            }
                          },
                          "expires_at": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "data": {
                            "type": "string",
                            "minLength": 1,
                            "contentEncoding": "base64"
                          },
                          "transcript": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "expires_at",
                          "data",
                          "transcript"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "finish_reason": {
                "enum": [
                  "stop",
                  "length",
                  "tool_calls",
                  "function_call"
                ]
              }
            }
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "metadata": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 512
              }
            }
          ]
        },
        "service_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "auto",
            "default",
            "flex",
            "scale",
            "priority",
            "fast",
            null
          ]
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "id",
        "object",
        "created",
        "model",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "const": "chat.completion.chunk"
        },
        "created": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "index",
              "delta",
              "logprobs"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "delta": {
                "type": "object",
                "properties": {
                  "refusal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "function_call": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "arguments": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "audio": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 7,
                            "maxLength": 256,
                            "pattern": "^audio_",
                            "not": {
                              "pattern": "[^A-Za-z0-9_-]"
                            }
                          },
                          "expires_at": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "data": {
                            "type": "string",
                            "minLength": 1,
                            "contentEncoding": "base64"
                          },
                          "transcript": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "minProperties": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "finish_reason": {
                "enum": [
                  null,
                  "stop",
                  "length",
                  "tool_calls",
                  "function_call"
                ]
              },
              "logprobs": {
                "$ref": "#/$defs/logprobs"
              }
            },
            "if": {
              "required": [
                "delta"
              ],
              "properties": {
                "delta": {
                  "required": [
                    "audio"
                  ],
                  "properties": {
                    "audio": {
                      "type": "object",
                      "required": [
                        "expires_at"
                      ],
                      "maxProperties": 1
                    }
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "finish_reason"
                ]
              }
            },
            "else": {
              "required": [
                "finish_reason"
              ]
            }
          }
        },
        "usage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/usage"
            }
          ]
        },
        "obfuscation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "service_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "auto",
            "default",
            "flex",
            "scale",
            "priority",
            "fast",
            null
          ]
        }
      },
      "if": {
        "properties": {
          "choices": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "required": [
          "usage"
        ],
        "properties": {
          "usage": {
            "$ref": "#/$defs/usage"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "live",
        "ready"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "starting",
            "ready",
            "draining",
            "unhealthy",
            "memory_pressure",
            "memory_observation_unavailable"
          ]
        },
        "live": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        }
      }
    },
    "tokenLogprob": {
      "type": "object",
      "required": [
        "token",
        "logprob",
        "bytes"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "logprob": {
          "type": "number",
          "maximum": 0
        },
        "bytes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "logprobs": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "content",
        "refusal"
      ],
      "properties": {
        "content": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/tokenLogprob"
              },
              {
                "type": "object",
                "required": [
                  "top_logprobs"
                ],
                "properties": {
                  "top_logprobs": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "$ref": "#/$defs/tokenLogprob"
                    }
                  }
                }
              }
            ]
          }
        },
        "refusal": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/tokenLogprob"
              },
              {
                "type": "object",
                "required": [
                  "top_logprobs"
                ],
                "properties": {
                  "top_logprobs": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "$ref": "#/$defs/tokenLogprob"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
