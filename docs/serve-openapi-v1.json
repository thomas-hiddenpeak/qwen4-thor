                    "requests_running": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "seq_slots_free": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "seq_slots_total": {
                      "type": "integer",
                      "minimum": 1
                    }
