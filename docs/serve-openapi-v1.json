        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "not": {
                      "pattern": "^chatcmpl-auto-"
                    }
                  },
                  "cancel_token": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "request_id",
                  "cancel_token"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
