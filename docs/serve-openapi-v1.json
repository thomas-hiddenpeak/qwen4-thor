{
  "openapi": "3.1.0",
  "info": {
    "title": "Q4T text serving contract",
    "version": "q4t-serve-v1",
    "description": "Static supported surface, not full OpenAI API compatibility. See required native semantics and version-bound acceptance matrix."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Example only; use effective configured address"
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "v1_chat_completions",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "description": "Trace only; not cancellation credentials or an idempotency key"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "serve-transport-v1.schema.json#/$defs/completion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-q4t-event-schema": {
                  "$ref": "serve-transport-v1.schema.json#/$defs/chunk"
                },
                "x-q4t-stream-contract": "role/content/tool deltas; exactly one finish; optional usage; DONE then EOF. After HTTP200, error envelope plus DONE when writable, otherwise truncated. No tool dispatch before complete validated terminal."
              }
            }
          },
          "default": {
            "description": "Error before stream starts; exact code/param come from production validation",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "description": "Trace only; not cancellation credentials or an idempotency key"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "serve-transport-v1.schema.json#/$defs/error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "serve-chat-request-v1.schema.json"
              }
            }
          }
        }
      }
    },
