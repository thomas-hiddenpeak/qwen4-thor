{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Q4T private extension, not an OpenAI or vLLM endpoint compatibility claim.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "object": {
      "const": "q4t.serve.config"
    },
    "profile": {
      "const": "q4t-config-v1"
    },
    "protocol_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string"
    },
    "max_context_tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "cli",
            "server_options",
            "builtin_default"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective",
        "source",
        "resolution"
      ]
    },
    "max_sequences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "cli",
            "server_options",
            "builtin_default"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective",
        "source",
        "resolution"
      ]
    },
    "prefill_chunk_tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "cli",
            "server_options",
            "builtin_default"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective",
        "source",
        "resolution"
      ]
    },
    "default_output_tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "cli",
            "server_options",
            "builtin_default"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective",
        "source",
        "resolution"
      ]
    },
    "request_deadline_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "cli",
            "server_options",
            "builtin_default"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective",
        "source",
        "resolution"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capacities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "policy": {
          "enum": [
            "uniform_context_clip",
            "explicit_full_budget"
          ]
        },
        "availability_endpoint": {
          "const": "/metrics"
        },
        "reservation": {
          "const": false
        }
      },
      "required": [
        "capacities",
        "policy",
        "availability_endpoint",
        "reservation"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mtp_requested": {
          "type": "boolean"
        },
        "mtp_enabled": {
          "type": "boolean"
        },
        "mtp_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "media_enabled": {
          "type": "boolean"
        },
        "structured_backend": {
          "type": "boolean"
        },
        "session_cache": {
          "type": "boolean"
        },
        "prefix_cache": {
          "type": "boolean"
        },
        "prefix_checkpoints": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "memory_budget_enabled": {
          "type": "boolean"
        },
        "whole_server_ram_limit": {
          "const": false
        }
      },
      "required": [
        "mtp_requested",
        "mtp_enabled",
        "mtp_k",
        "media_enabled",
        "structured_backend",
        "session_cache",
        "prefix_cache",
        "prefix_checkpoints",
        "memory_budget_enabled",
        "whole_server_ram_limit"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_requests": {
          "type": "integer",
          "minimum": 1
        },
        "preflight_shares_text_admission": {
          "const": true
        },
        "business_connections": {
          "type": "integer",
          "minimum": 1
        },
        "control_connections": {
          "const": 4
        },
        "body_bytes": {
          "const": 16777216
        },
        "aggregate_body_bytes": {
          "const": 50331648
        },
        "tokenizer_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "preflight_response_bytes": {
          "const": 8388608
        }
      },
      "required": [
        "text_requests",
        "preflight_shares_text_admission",
        "business_connections",
        "control_connections",
        "body_bytes",
        "aggregate_body_bytes",
        "tokenizer_input_bytes",
        "tokenizer_tokens",
        "preflight_response_bytes"
      ]
    },
    "configuration_mutable": {
      "const": false
    },
    "paths_redacted": {
      "const": true
    }
  },
  "required": [
    "object",
    "profile",
    "protocol_source_sha256",
    "model",
    "max_context_tokens",
    "max_sequences",
    "prefill_chunk_tokens",
    "default_output_tokens",
    "request_deadline_ms",
    "slots",
    "runtime",
    "limits",
    "configuration_mutable",
    "paths_redacted"
  ]
}
